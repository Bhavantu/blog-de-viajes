---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ui } from '../i18n/ui.js';

const currentLang = Astro.currentLocale || 'es';
const currentPath = Astro.url.pathname.replace(/^\/en/, '');
const t = ui[currentLang as keyof typeof ui];
const { isTransparent = false } = Astro.props;
---

<div class={isTransparent ? "header-wrapper transparente" : "header-wrapper solido"}>
    <div id="mobile-menu-overlay" class="menu-overlay"></div>
    
    <header class="site-header">
        <!-- El logo también debe apuntar al idioma correcto -->
        <h1><a href={getRelativeLocaleUrl(currentLang, '/')}>BLOGCITO</a></h1>
        
        <button id="mobile-menu-btn" class="menu-toggle">☰</button>        
        <nav id="main-nav">
            <ul class="nav-links">
                <li><a href={getRelativeLocaleUrl(currentLang, '/')}>{t['nav.inicio']}</a></li>
                <li><a href={getRelativeLocaleUrl(currentLang, 'diario')}>{t['nav.diario']}</a></li>
                <li><a href={getRelativeLocaleUrl(currentLang, 'nosotros')}>{t['nav.nosotros']}</a></li>
                
                <li class="btn-buscar">
                    <a href="#" title="Buscar" style="display: flex; align-items: center; padding-top: 2px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </a>
                </li>

                <!-- Selector de Idiomas agregado como un elemento más de la lista -->
                <li class="lang-switcher" style="display: flex; align-items: center; gap: 8px; margin-left: 12px; font-family: monospace; font-size: 0.85rem;">
                    <a 
                        href={getRelativeLocaleUrl('es', currentPath)} 
                        style={currentLang === 'es' ? 'font-weight: bold; color: #f97316;' : 'color: #a8a29e;'}
                    >ES</a>
                    <span style="color: #57534e;">|</span>
                    <a 
                        href={getRelativeLocaleUrl('en', currentPath)} 
                        style={currentLang === 'en' ? 'font-weight: bold; color: #f97316;' : 'color: #a8a29e;'}
                    >EN</a>
                </li>
            </ul>
        </nav>
    </header>
</div>

<style>
    /* =========================================
       ESTILOS BASE (Tus estilos originales)
       ========================================= */
    .header-wrapper {
        width: 100%;
        z-index: 50;
        transition: all 0.3s ease;
    }
    
    .header-wrapper.transparente {
        position: absolute;
        top: 0;
        left: 0;
        background: transparent;
    }

    .header-wrapper.solido {
        position: relative;
        background: var(--bg-color, #fcfcfc);
        border-bottom: 1px solid #eee;
    }

    .header-wrapper.transparente .site-header h1 a,
    .header-wrapper.transparente .menu-toggle,
    .header-wrapper.transparente nav a,
    .header-wrapper.transparente .btn-buscar svg {
        color: #ffffff !important;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    .header-wrapper.transparente nav a:hover {
        color: #fde68a !important; 
    }

    /* Ocultamos la sombra por defecto en compu */
    .menu-overlay { display: none; }

    /* =========================================
       ESTILOS DEL DRAWER (CELULARES)
       ========================================= */
    @media (max-width: 768px) {
        .menu-toggle {
            position: relative;
            z-index: 1001; /* Botón por encima de todo */
        }

        .menu-overlay {
            display: block;
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0,0,0,0.6);
            z-index: 990;
            opacity: 0; pointer-events: none;
            transition: opacity 0.3s ease;
        }
        .menu-overlay.menu-open {
            opacity: 1; pointer-events: auto;
        }

        #main-nav { 
            display: flex; 
            flex-direction: column;
            position: fixed; 
            top: 0; 
            right: 0; 
            width: 260px; 
            height: 100vh; 
            background-color: var(--bg-color, #f4f1ea); 
            box-shadow: -5px 0 15px rgba(0,0,0,0.2); 
            z-index: 1000; 
            padding: 6rem 1.5rem 2rem; 
            transform: translateX(100%); /* Escondido a la derecha */
            transition: transform 0.3s ease-in-out;
        }
        
        #main-nav.menu-open { 
            transform: translateX(0); /* Entra a la pantalla */
        }
        
        /* Centramos los links */
        #main-nav ul.nav-links { 
            display: flex;
            flex-direction: column; 
            gap: 2.5rem; 
            align-items: center;
            padding: 0;
            margin: 0;
        }

        /* Forzamos colores oscuros para leer bien sobre el fondo claro del menú */
        .header-wrapper.transparente #main-nav a,
        .header-wrapper.transparente #main-nav .btn-buscar svg,
        #main-nav a,
        #main-nav .btn-buscar svg {
            color: #333 !important;
            text-shadow: none !important;
            font-size: 1.1rem;
        }
        
        /* Cuando el menú se abre, la "X" tiene que ser negra */
        .menu-toggle.menu-abierto {
            color: #333 !important;
            text-shadow: none !important;
        }
    }
</style>