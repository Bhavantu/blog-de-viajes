---
import { ui } from '../i18n/ui.js';

const currentLang = (Astro.currentLocale || 'es') as 'es' | 'en';
const t = ui[currentLang];
const { isTransparent = false, frontmatter } = Astro.props;

const englishPosts = Object.values(import.meta.glob('../pages/en/journal/*.md', { eager: true })) as any[];

let rawPath = Astro.url.pathname;
let cleanPath = rawPath.replace(/^\/en/, '').replace(/\/index\.html$/, '').replace(/\/$/, '');
if (cleanPath === '') cleanPath = '/';

let urlEs = cleanPath; 
let urlEn = '/en' + (cleanPath === '/' ? '' : cleanPath);

if (cleanPath === '/nosotros' || cleanPath === '/about') {
    urlEs = ui['es']['route.nosotros'];
    urlEn = ui['en']['route.nosotros'];
} else if (cleanPath === '/diario' || cleanPath === '/journal') {
    urlEs = ui['es']['route.diario'];
    urlEn = ui['en']['route.diario'];
} else if (cleanPath === '/contacto' || cleanPath === '/contact') {
    urlEs = ui['es']['route.contacto'];
    urlEn = ui['en']['route.contacto'];
} else if (cleanPath === '/colab') {
    urlEs = ui['es']['route.colab'];
    urlEn = ui['en']['route.colab'];
} else if (cleanPath === '/politica-de-privacidad' || cleanPath === '/privacy-policy') {
    urlEs = ui['es']['route.privacidad'];
    urlEn = ui['en']['route.privacidad'];
} else if (cleanPath.startsWith('/diario/')) {
    const suffix = cleanPath.replace('/diario/', '');
    urlEs = `/diario/${suffix}`;
    const enPost = englishPosts.find((p) => p.frontmatter?.archivo_original === `${suffix}.md`);
    urlEn = enPost?.url || '/en/journal';
} else if (cleanPath.startsWith('/journal/')) {
    if (frontmatter && frontmatter.archivo_original) {
        const esSlug = frontmatter.archivo_original.replace('.md', '');
        urlEs = `/diario/${esSlug}`;
    } else {
        urlEs = '/diario';
    }
    urlEn = rawPath;
}

// Detectamos si estamos dentro de un post
const isPost = !!frontmatter;
---

<div class={isTransparent ? "header-wrapper transparente" : "header-wrapper solido"}>
    <div id="mobile-menu-overlay" class="menu-overlay"></div>
    
    <header class="site-header">
        <div class="logo-container">
            <a href={t['route.inicio']} class="logo-text">BLOGCITO</a>
        </div>
        
        <button id="mobile-menu-btn" class="menu-toggle" aria-label="Menu">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>        
        
        <nav id="main-nav">
            <ul class="nav-links">
                <li><a href={t['route.inicio']}>{t['nav.inicio']}</a></li>
                <li><a href={t['route.diario']}>{t['nav.diario']}</a></li>
                <li><a href={t['route.nosotros']}>{t['nav.nosotros']}</a></li>
                
                {/* Ocultamos el buscador y el selector de idiomas si estamos en un post */}
                {!isPost && (
                    <>
                        <li class="btn-buscar">
                            <a href="#" title="Buscar" class="search-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                            </a>
                        </li>

                        <li class="lang-switcher">
                            <a href={urlEs} class={currentLang === 'es' ? 'active-lang' : ''}>ES</a>
                            <span class="lang-separator">/</span>
                            <a href={urlEn} class={currentLang === 'en' ? 'active-lang' : ''}>EN</a>
                        </li>
                    </>
                )}
            </ul>
        </nav>
    </header>
</div>

<style>
    .header-wrapper {
        width: 100%;
        z-index: 10000;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    .header-wrapper.transparente {
        position: absolute;
        top: 0;
        left: 0;
        background: transparent;
        border-bottom: none;
    }

    .header-wrapper.solido {
        position: sticky;
        top: 0;
        background: rgba(244, 241, 234, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .site-header { 
        padding: 1.5rem 2.5rem; 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        max-width: 1400px; 
        margin: 0 auto; 
        width: 100%; 
    }

    .logo-text { 
        font-family: var(--font-display, 'Georgia', serif); 
        font-size: 1.8rem; 
        letter-spacing: 0.15em; 
        text-transform: uppercase; 
        font-weight: normal; 
        color: var(--text-color, #333);
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .header-wrapper.transparente .logo-text {
        color: #ffffff !important;
        text-shadow: 0 2px 6px rgba(0,0,0,0.9), 0 4px 16px rgba(0,0,0,0.6);
    }
    
    nav ul.nav-links { 
        list-style: none; 
        display: flex; 
        align-items: center;
        gap: 2.5rem; 
        margin: 0; 
        padding: 0; 
    }

    nav a { 
        font-family: var(--font-main, sans-serif);
        font-size: 0.85rem; 
        color: var(--text-color, #333); 
        text-transform: uppercase; 
        letter-spacing: 0.15em; 
        font-weight: 600; 
        text-decoration: none;
        transition: opacity 0.3s ease, color 0.3s ease;
    }

    nav a:hover { opacity: 0.7; }

    .header-wrapper.transparente nav a,
    .header-wrapper.transparente .search-icon svg {
        color: #ffffff !important;
        text-shadow: 0 2px 6px rgba(0,0,0,0.9), 0 4px 16px rgba(0,0,0,0.6);
    }

    .search-icon {
        display: flex; 
        align-items: center;
    }

    .lang-switcher {
        display: flex; 
        align-items: center; 
        gap: 8px; 
        font-family: var(--font-main, sans-serif); 
        font-size: 0.8rem; 
        letter-spacing: 0.1em;
    }

    .lang-switcher a { color: #888; transition: color 0.3s ease; font-weight: 500; }
    .lang-switcher a.active-lang { color: var(--text-color, #333); font-weight: bold; }
    .lang-separator { color: #ccc; font-weight: 300; }

    .header-wrapper.transparente .lang-switcher a { 
        color: rgba(255,255,255,0.85) !important; 
        text-shadow: 0 2px 6px rgba(0,0,0,0.9), 0 4px 16px rgba(0,0,0,0.6);
    }
    .header-wrapper.transparente .lang-switcher a.active-lang { 
        color: #ffffff !important; 
    }
    .header-wrapper.transparente .lang-separator { 
        color: rgba(255,255,255,0.6) !important; 
    }

    .menu-toggle { 
        display: none; 
        background: none; 
        border: none; 
        cursor: pointer; 
        width: 30px;
        height: 20px;
        position: relative;
        z-index: 10001;
    }

    .hamburger-line {
        display: block;
        width: 100%;
        height: 2px;
        background-color: var(--text-color, #333);
        position: absolute;
        transition: all 0.3s ease;
    }

    .header-wrapper.transparente .hamburger-line {
        background-color: #ffffff !important;
        box-shadow: 0 1px 4px rgba(0,0,0,0.8);
    }

    .hamburger-line:first-child { top: 4px; }
    .hamburger-line:last-child { bottom: 4px; }

    .menu-toggle.menu-abierto .hamburger-line:first-child {
        transform: translateY(5px) rotate(45deg);
        background-color: var(--text-color, #333) !important;
        box-shadow: none;
    }
    .menu-toggle.menu-abierto .hamburger-line:last-child {
        transform: translateY(-5px) rotate(-45deg);
        background-color: var(--text-color, #333) !important;
        box-shadow: none;
    }

    .menu-overlay { display: none; }

    @media (max-width: 768px) {
        .site-header { padding: 1.2rem 1.5rem; }
        .menu-toggle { display: block; }
        
        .menu-overlay {
            display: block;
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(3px);
            z-index: 9990;
            opacity: 0; pointer-events: none;
            transition: opacity 0.4s ease;
        }
        .menu-overlay.menu-open { opacity: 1; pointer-events: auto; }

        #main-nav { 
            display: flex; 
            flex-direction: column;
            position: fixed; 
            top: 0; 
            right: 0; 
            width: 75vw; 
            max-width: 320px;
            height: 100vh; 
            background-color: #f4f1ea; 
            box-shadow: -10px 0 30px rgba(0,0,0,0.1); 
            z-index: 9999; 
            padding: 6rem 2rem 2rem; 
            transform: translateX(100%);
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        
        #main-nav.menu-open { transform: translateX(0); }
        
        nav ul.nav-links { 
            flex-direction: column; 
            gap: 2rem; 
            align-items: flex-start; 
        }

/* Usamos #main-nav para tener mayor prioridad que el header transparente */
        #main-nav a { font-size: 1.2rem; color: #333 !important; text-shadow: none !important; }
        #main-nav .search-icon svg { color: #333 !important; width: 24px; height: 24px; }
        
        #main-nav .lang-switcher { margin-top: 1.5rem; font-size: 1rem; }
        #main-nav .lang-switcher a { color: #888 !important; text-shadow: none !important; }
        #main-nav .lang-switcher a.active-lang { color: #333 !important; font-weight: bold; }
        #main-nav .lang-separator { color: #ccc !important; text-shadow: none !important; }    }
</style>

<!-- ESTE SCRIPT ES EL QUE HACE QUE EL MENÚ FUNCIONE SIN ROMPER LA PANTALLA -->
<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const nav = document.getElementById('main-nav');
        const overlay = document.getElementById('mobile-menu-overlay');

        function toggleMenu() {
            btn?.classList.toggle('menu-abierto');
            nav?.classList.toggle('menu-open');
            overlay?.classList.toggle('menu-open');
            
            // Evita que la persona haga scroll en el artículo mientras el menú está abierto
            if(nav?.classList.contains('menu-open')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }
        }

        btn?.addEventListener('click', toggleMenu);
        overlay?.addEventListener('click', toggleMenu);
    });
</script>