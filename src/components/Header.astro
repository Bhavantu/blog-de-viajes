---
import { ui } from '../i18n/ui.js';

const currentLang = (Astro.currentLocale || 'es') as 'es' | 'en';
const t = ui[currentLang];
const { isTransparent = false } = Astro.props;

// Limpieza de ruta para evitar errores con index.html o barras sobrantes
let rawPath = Astro.url.pathname;
let cleanPath = rawPath.replace(/^\/en/, '').replace(/\/index\.html$/, '').replace(/\/$/, '');
if (cleanPath === '') cleanPath = '/';

// Armado inteligente de URLs para el selector ES | EN
let urlEs = cleanPath; 
let urlEn = '/en' + (cleanPath === '/' ? '' : cleanPath);

// Mapeo para el selector de idiomas
if (cleanPath === '/nosotros' || cleanPath === '/about') {
    urlEs = t['route.nosotros'];
    urlEn = ui['en']['route.nosotros'];
} else if (cleanPath === '/diario' || cleanPath === '/journal') {
    urlEs = t['route.diario'];
    urlEn = ui['en']['route.diario'];
} else if (cleanPath === '/contacto' || cleanPath === '/contact') {
    urlEs = t['route.contacto'];
    urlEn = ui['en']['route.contacto'];
} else if (cleanPath.startsWith('/diario/')) {
    const suffix = cleanPath.replace('/diario/', '');
    urlEs = `/diario/${suffix}`;
    urlEn = `/en/journal/${suffix}`; 
} else if (cleanPath.startsWith('/journal/')) {
    const suffix = cleanPath.replace('/journal/', '');
    urlEs = `/diario/${suffix}`;
    urlEn = `/en/journal/${suffix}`; 
}
---

<div class={isTransparent ? "header-wrapper transparente" : "header-wrapper solido"}>
    <!-- Fondo oscuro al abrir el menú en móviles -->
    <div id="mobile-menu-overlay" class="menu-overlay"></div>
    
    <header class="site-header">
        <h1><a href={t['route.inicio']}>BLOGCITO</a></h1>
        
        <button id="mobile-menu-btn" class="menu-toggle" aria-label="Abrir menú">☰</button>        
        
        <nav id="main-nav">
            <ul class="nav-links">
                <li><a href={t['route.inicio']}>{t['nav.inicio']}</a></li>
                <li><a href={t['route.diario']}>{t['nav.diario']}</a></li>
                <li><a href={t['route.nosotros']}>{t['nav.nosotros']}</a></li>
                
                <li class="btn-buscar">
                    <a href="#" title="Buscar" style="display: flex; align-items: center; padding-top: 2px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </a>
                </li>

                <!-- Selector de Idiomas -->
                <li class="lang-switcher">
                    <a 
                        href={urlEs} 
                        style={currentLang === 'es' ? 'font-weight: bold; color: #f97316;' : 'color: #a8a29e;'}
                    >ES</a>
                    <span style="color: #57534e;">|</span>
                    <a 
                        href={urlEn} 
                        style={currentLang === 'en' ? 'font-weight: bold; color: #f97316;' : 'color: #a8a29e;'}
                    >EN</a>
                </li>
            </ul>
        </nav>
    </header>
</div>

<script is:inline>
    function setupMobileMenu() {
        const btn = document.getElementById('mobile-menu-btn');
        const nav = document.getElementById('main-nav');
        const overlay = document.getElementById('mobile-menu-overlay');

        if (!btn || !nav || !overlay) return;

        // Limpieza de eventos viejos
        const newBtn = btn.cloneNode(true);
        btn.replaceWith(newBtn);

        const closeMenu = () => {
            nav.classList.remove('menu-open');
            overlay.classList.remove('menu-open');
            newBtn.classList.remove('menu-abierto');
            newBtn.innerHTML = '☰';
            document.body.style.overflow = '';
        };

        const openMenu = () => {
            nav.classList.add('menu-open');
            overlay.classList.add('menu-open');
            newBtn.classList.add('menu-abierto');
            newBtn.innerHTML = '✕';
            document.body.style.overflow = 'hidden';
        };

        newBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (nav.classList.contains('menu-open')) closeMenu();
            else openMenu();
        });

        overlay.addEventListener('click', closeMenu);

        nav.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', closeMenu);
        });
    }

    document.addEventListener('DOMContentLoaded', setupMobileMenu);
    document.addEventListener('astro:after-swap', setupMobileMenu);
</script>

<style>
    .header-wrapper {
        width: 100%;
        z-index: 50;
        transition: all 0.3s ease;
    }
    
    .header-wrapper.transparente {
        position: absolute;
        top: 0;
        left: 0;
        background: transparent;
    }

    .header-wrapper.solido {
        position: relative;
        background: var(--bg-color, #fcfcfc);
        border-bottom: 1px solid #eee;
    }

    .site-header { 
        padding: 2.5rem 2rem; 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        position: relative; 
        max-width: 1000px; 
        margin: 0 auto; 
        width: 100%; 
    }

    .site-header h1 { 
        margin: 0; 
        font-family: var(--font-display, 'Georgia', serif); 
        font-size: 2.2rem; 
        letter-spacing: 0.1em; 
        text-transform: uppercase; 
        font-weight: normal; 
    }

    .site-header h1 a { text-decoration: none; color: inherit; }

    .menu-toggle { 
        display: none; 
        background: none; 
        border: none; 
        font-size: 2rem; 
        cursor: pointer; 
        color: var(--text-color, #333); 
        line-height: 1;
    }

    nav ul.nav-links { 
        list-style: none; 
        display: flex; 
        gap: 2rem; 
        font-size: 0.9rem; 
        margin: 0; 
        padding: 0; 
        align-items: center;
    }

    nav a { 
        color: var(--accent-color, #888); 
        position: relative; 
        text-transform: uppercase; 
        letter-spacing: 0.05em; 
        font-weight: 500; 
    }
    nav a:hover { color: var(--text-color, #333); }

    .lang-switcher {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-left: 12px;
        font-family: monospace;
        font-size: 0.85rem;
    }

    .menu-overlay { display: none; }

    /* MODO TRANSPARENTE */
    .header-wrapper.transparente .site-header h1 a,
    .header-wrapper.transparente .menu-toggle,
    .header-wrapper.transparente nav a,
    .header-wrapper.transparente .btn-buscar svg {
        color: #ffffff !important;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    /* =========================================
       COMPORTAMIENTO MÓVIL (<= 768px)
       ========================================= */
    @media (max-width: 768px) {
        .site-header { padding: 1.5rem 1rem; }
        
        .menu-toggle { 
            display: block; 
            position: relative; 
            z-index: 1002; 
        }

        .menu-overlay {
            display: block;
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0,0,0,0.6);
            z-index: 990;
            opacity: 0; 
            pointer-events: none;
            transition: opacity 0.3s ease;
        }
        .menu-overlay.menu-open {
            opacity: 1; 
            pointer-events: auto;
        }

        #main-nav { 
            display: flex; 
            flex-direction: column;
            position: fixed; 
            top: 0; 
            right: 0; 
            width: 270px; 
            max-width: 80vw;
            height: 100vh; 
            background-color: var(--bg-color, #f4f1ea); 
            box-shadow: -5px 0 15px rgba(0,0,0,0.15); 
            z-index: 1001; 
            padding: 5.5rem 1.5rem 2rem; 
            
            /* CLAVES ANTI-DESBORDE: */
            transform: translateX(100%); 
            visibility: hidden;
            pointer-events: none;
            transition: transform 0.3s ease-in-out, visibility 0.3s ease-in-out;
            text-align: center;
        }
        
        #main-nav.menu-open { 
            transform: translateX(0); 
            visibility: visible;
            pointer-events: auto;
        }
        
        #main-nav ul.nav-links { 
            flex-direction: column; 
            gap: 2rem; 
            align-items: center;
            width: 100%;
        }

        .header-wrapper.transparente #main-nav a,
        .header-wrapper.transparente #main-nav .btn-buscar svg,
        #main-nav a,
        #main-nav .btn-buscar svg {
            color: var(--text-color, #333) !important;
            text-shadow: none !important;
            font-size: 1.05rem;
        }
        
        .menu-toggle.menu-abierto {
            color: var(--text-color, #333) !important;
            text-shadow: none !important;
        }
    }
</style>