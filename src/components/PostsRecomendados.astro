---
// src/components/PostsRecomendados.astro
import { ui } from '../i18n/ui.js';
import { destinationsData } from '../data/taxonomies.js'; // Importamos los datos de destinos para armar el link

const { currentUrl, currentPais, lang = "es" } = Astro.props;

// Rutas originales
const postsEs = Object.values(import.meta.glob('../pages/diario/*.md', { eager: true }));
const postsEn = Object.values(import.meta.glob('../pages/en/journal/*.md', { eager: true }));

const allPosts = lang === "es" ? postsEs : postsEn;

// Filtro anti-duplicados
const cleanUrl = (url: string) => url?.replace(/\/$/, '') || '';
const currentUrlCleaned = cleanUrl(currentUrl);

// 1. Filtramos todos los posts válidos de este país
const todosLosRecomendados = allPosts.filter((post: any) => {
    const postUrlCleaned = cleanUrl(post.url);
    return post.frontmatter.pais === currentPais && postUrlCleaned !== currentUrlCleaned;
});

// 2. Limitamos a un MÁXIMO de 4 tarjetas (2 filas)
const recomendadosLimitados = todosLosRecomendados.slice(0, 4);

// 3. Verificamos si quedaron posts afuera para mostrar el botón
const hayMasPosts = todosLosRecomendados.length > 4;

const t = ui[lang as keyof typeof ui] || ui['es'];

// 4. Lógica para armar la URL del botón "Ver todos"
let linkDestino = "#";
if (hayMasPosts && currentPais) {
    // Buscamos el ID del destino en taxonomies basándonos en el nombre del país (español o inglés)
    const destinoMatch = destinationsData.find(d => 
        d.title === currentPais || d.title_en === currentPais
    );
    
    if (destinoMatch) {
        if (lang === 'es') {
            linkDestino = `/destinos/${destinoMatch.id}`;
        } else {
            // Usa el id_en si existe, sino el id normal
            const slugEn = destinoMatch.id_en || destinoMatch.id;
            linkDestino = `/en/destinations/${slugEn}`;
        }
    }
}
---

{recomendadosLimitados.length > 0 && (
  <section class="recomendados-section">
    <h3>{lang === "es" ? "También te puede interesar" : "You might also like"}</h3>
    
    <div class="recomendados-grid">
      {recomendadosLimitados.map((post: any) => {
        const tagKey = `tag.${post.frontmatter.tag?.toLowerCase()}`;
        const translatedTag = t[tagKey as keyof typeof t] || post.frontmatter.tag;

        return (
          <a href={post.url} class="recomendado-card">
            <div class="img-wrapper">
              <img src={post.frontmatter.main_image} alt={post.frontmatter.title} loading="lazy" />
            </div>
            <div class="card-content">
              <span class="tag">{translatedTag}</span>
              <h4>{post.frontmatter.title}</h4>
            </div>
          </a>
        );
      })}
    </div>

    <!-- BOTÓN DE "VER MÁS" CONDICIONAL -->
    {hayMasPosts && (
      <div class="ver-mas-container">
        <a href={linkDestino} class="ver-mas-btn">
            {lang === "es" ? `Más posts de ${currentPais}` : `More ${currentPais} Posts`}
        </a>
      </div>
    )}

  </section>
)}

<style>
  .recomendados-section {
    width: 100%;
    margin: 0;
    padding: 0;
  }
  
  .recomendados-section h3 {
    margin-bottom: 2rem;
    font-size: 1.8rem;
    font-family: var(--font-display, 'Georgia', serif);
    color: #111111;
    font-weight: normal;
  }
  
  /* Grilla estricta de 2 columnas al estilo Indie Traveller */
  .recomendados-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem; /* Espaciado generoso entre tarjetas */
    width: 100%;
  }

  /* El diseño de la tarjeta es IDÉNTICO a tus "Últimos Artículos" del lateral */
  a.recomendado-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background-color: #ffffff !important; 
    border-radius: 12px !important;
    overflow: hidden;
    border: none !important; /* Quitamos el borde gris */
    box-shadow: 0 8px 24px rgba(0,0,0,0.04) !important; /* Sombra suave como flotando */
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  a.recomendado-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.08) !important;
  }
  
  .img-wrapper {
    width: 100% !important;
    aspect-ratio: 16 / 10 !important; 
    overflow: hidden !important;
    background-color: #f5f5f5 !important;
    margin: 0 !important; 
    padding: 0 !important;
    display: block !important;
  }

  .img-wrapper img {
    width: 100% !important;
    height: 100% !important;
    min-height: 100% !important; /* Forza a la imagen a estirarse verticalmente */
    object-fit: cover !important;
    object-position: center !important; /* Centra la parte más importante de la foto */
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;
    border-radius: 0 !important; /* Evita heredar bordes curvos no deseados en la parte inferior */
    transition: transform 0.5s ease !important;
  }

  a.recomendado-card:hover .img-wrapper img {
    transform: scale(1.04) !important;
  }
  
  /* El interior del texto, igual a tus widgets laterales */
  .card-content {
    padding: 1.5rem !important; 
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    background-color: #ffffff !important; 
  }
  
  .tag {
    font-family: var(--font-main, sans-serif);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #666666 !important; /* Gris oscuro para parecerse a la fecha de los últimos posts */
    font-weight: 600;
    margin-bottom: 0.8rem;
    display: block;
  }
  
  .card-content h4 {
    margin: 0;
    font-family: var(--font-display, 'Georgia', serif);
    font-size: 1.25rem;
    line-height: 1.4;
    color: #111111 !important;
    font-weight: normal;
  }

  /* Estilos para el botón de "Ver más" */
  .ver-mas-container {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .ver-mas-btn {
    display: inline-block;
    padding: 0.8rem 2rem !important;
    background-color: #f5f5f5 !important;
    color: #111111 !important;
    font-family: var(--font-main, sans-serif);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 50px !important;
    text-decoration: none !important;
    border: 1px solid #eaeaea !important;
    transition: all 0.3s ease !important;
    box-shadow: none !important;
  }

  .ver-mas-btn:hover {
    background-color: #111111 !important;
    color: #ffffff !important;
    border-color: #111111 !important;
    transform: translateY(-2px);
  }

  /* En celulares, pasan a ser 1 sola columna ocupando el ancho del texto */
  @media (max-width: 600px) {
    .recomendados-grid {
      grid-template-columns: 1fr;
    }
    .img-wrapper {
      aspect-ratio: 16 / 9;
    }
  }
</style>