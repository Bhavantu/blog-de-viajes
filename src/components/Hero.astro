---
const { 
  title = "", 
  subtitle = "", 
  description = "", 
  bgImage = "",
  loading = "eager",
  fetchpriority = "high"
} = Astro.props;
---

<section class="hero-cinematic">
  <div class="hero-bg">
    <img 
      src={bgImage} 
      alt={title.replace(/<[^>]*>?/gm, '')} 
      loading={loading} 
      fetchpriority={fetchpriority} 
    />
    <!-- Scrim actualizado: Gradiente radial y lineal sutil como en el inicio -->
    <div class="hero-scrim"></div>
  </div>
  
  <div class="hero-content">
    {subtitle && <span class="hero-subtitle">{subtitle}</span>}
    <h1 class="hero-title" set:html={title}></h1>
    {description && <p class="hero-description">{description}</p>}
  </div>
</section>

<style>
  .hero-cinematic {
    position: relative;
    width: 100%;
    /* Altura igualada a la página de inicio */
    height: 100svh; 
    min-height: 500px;
    display: flex;
    align-items: center; 
    justify-content: center; 
    text-align: center;
    padding: 8rem 2rem 4rem;
    overflow: hidden;
    margin-bottom: 4rem;
    margin-top: -120px; 
    z-index: 0;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: #111;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    animation: slowZoom 25s ease-out forwards; /* Ajustado a 25s como en el inicio */
    will-change: transform;
  }

  /* Scrim actualizado para mayor elegancia, sin oscurecer tanto la foto */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.2) 80%);
    backdrop-filter: blur(0.5px);
    -webkit-backdrop-filter: blur(0.5px);
  }

  .hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-subtitle {
    font-family: var(--font-main, sans-serif);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    color: rgba(255,255,255,0.9);
    font-weight: 600;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-title {
    font-family: var(--font-display, 'Georgia', serif);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin-bottom: 1.2rem;
    font-style: italic;
    text-wrap: balance;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }

  .hero-description {
    font-family: var(--font-main, sans-serif);
    font-size: 1.15rem;
    line-height: 1.6;
    max-width: 600px;
    color: #ffffff;
    font-weight: 500;
    font-style: italic;
    letter-spacing: 0.02em;
    background: transparent;
    padding: 0;
    border-radius: 0;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }

  @keyframes slowZoom {
    from { transform: scale(1); }
    to { transform: scale(1.1); }
  }

  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ============================================================
     RESPONSIVE PARA CELULARES
     ============================================================ */
  @media (max-width: 768px) {
    .hero-cinematic {
      align-items: center; 
      padding: 0 1.5rem;
    }
    
    .hero-content {
      margin-top: 3rem; 
    }

    .hero-subtitle {
      font-size: 1rem; 
      margin-bottom: 1rem;
    }

    .hero-title {
      font-size: clamp(2.5rem, 5vw, 4rem);
      margin-bottom: 1.2rem;
    }

    .hero-description {
      font-size: 1.05rem; 
      padding: 0;
    }

    .hero-scrim {
      background: linear-gradient(to bottom, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.7) 100%);
    }
  }
</style>