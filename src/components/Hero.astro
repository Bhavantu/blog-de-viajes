---
const { 
  title = "", 
  subtitle = "", 
  description = "", 
  bgImage = "" 
} = Astro.props;
---

<div 
  class="relative w-full min-h-[70vh] md:min-h-0 md:h-[75vh] flex items-center justify-center bg-cover bg-center pt-28 pb-14 md:py-0"
  style={`background-image: linear-gradient(rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.45)), url('${bgImage}');`}
>
  <div class="text-center text-white px-6 md:px-4 max-w-3xl z-10 flex flex-col items-center">
    
    {subtitle && (
      <span class="text-xs md:text-sm tracking-[0.3em] uppercase font-semibold text-gray-200 block mb-3">
        {subtitle}
      </span>
    )}
    
    <h1 
      class="text-3xl md:text-6xl font-bold tracking-tight mb-4 font-serif text-white leading-tight"
      set:html={title}
    >
    </h1>
    
    {description && (
      <p class="text-base md:text-lg text-gray-100 max-w-xl mx-auto font-light leading-relaxed">
        {description}
      </p>
    )}

    <!-- Espacio para botones del hero si existen -->
    <slot />

  </div>
</div>