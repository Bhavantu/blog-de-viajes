---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro'; // <-- IMPORTANTE: Importamos el Hero

const posts = import.meta.glob('./diario/*.md', { eager: true });
const allPosts = Object.values(posts);

const sortedPosts = allPosts.sort((a: any, b: any) => {
    const dateA = new Date(a.frontmatter?.date || 0).valueOf();
    const dateB = new Date(b.frontmatter?.date || 0).valueOf();
    return dateB - dateA;
});

let featuredPosts = sortedPosts.filter((post: any) => post.frontmatter.destacado === true);

if (featuredPosts.length < 3) {
    const cantidadFaltante = 3 - featuredPosts.length;
    const postsNoDestacados = sortedPosts.filter((post: any) => post.frontmatter.destacado !== true);
    featuredPosts = [...featuredPosts, ...postsNoDestacados.slice(0, cantidadFaltante)];
} else {
    featuredPosts = featuredPosts.slice(0, 3);
}
---

<Layout title="Inicio - BLOGCITO" 
description="Bitácora de viaje, información útil y vida local alrededor del mundo. Acompañanos a descubrir nuevos destinos a través de nuestras crónicas y guías."
isTransparentHeader={true}>

    <!-- COMPONENTE HERO -->
<Hero 
        title="Conociendo otros Mundos" 
        description="Crónicas, guías y fotografías de nuestros viajes."
        bgImage="/img/diario/UBUD8.webp" 
    />

    <!-- CONTENIDO PRINCIPAL (Tu grilla exacta sin tocar) -->
    <main class="container mx-auto px-4 pt-16">
        
        <div style="display: flex; align-items: center; margin-bottom: 3rem; border-bottom: 1px solid #eee; padding-bottom: 1rem;">
            <h2 style="margin: 0; font-size: 1.5rem; font-weight: normal; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-color, #333);"></h2>
        </div>

        <div id="grilla-portada-segura">
            {featuredPosts.map((post: any) => (
                <article class="tarjeta-portada reveal visible">
                    
                    {post.frontmatter.main_image && (
                        <img 
                            src={post.frontmatter.main_image} 
                            alt={`Portada de ${post.frontmatter.title}`} 
                            class="img-portada"
                        />
                    )}

                    <div class="meta-portada">
                        {post.frontmatter.tag && (
                            <span class="journal-tag" data-tag={post.frontmatter.tag.toLowerCase()}>
                                {post.frontmatter.tag}
                            </span>
                        )}
                        <span class="journal-date">
                            {new Date(post.frontmatter.date).toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase()}
                        </span>
                    </div>
                    
                    <h3 class="titulo-portada">
                        <a href={post.url} class="hover-verde">
                            {post.frontmatter.title}
                        </a>
                    </h3>
                    
                    <p class="desc-portada">
                        {post.frontmatter.description || "Nueva entrada en nuestro diario de viaje..."}
                    </p>

                    <div class="btn-leer-mas-portada">
                        <a href={post.url} class="hover-verde">
                            Leer más &rarr;
                        </a>
                    </div>
                    
                </article>
            ))}
        </div>

        <div style="text-align: center; margin-top: 4rem; margin-bottom: 5rem;">
            <a href="/diario" class="btn-ver-mas-global">
                Ver más
            </a>
        </div>
    </main>
</Layout>

<style is:global>
    /* ============================================================
       ESTILOS EXCLUSIVOS DE LA PORTADA (Aislados de Layout.astro)
       ============================================================ */
    
    #grilla-portada-segura {
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 2.5rem !important;
        width: 100% !important;
        align-items: stretch !important;
    }

    .tarjeta-portada {
        display: flex !important;
        flex-direction: column !important;
        height: 100% !important;
        min-width: 0 !important; 
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        max-width: 100% !important;
    }

    .img-portada {
        width: 100% !important;
        height: 220px !important;
        object-fit: cover !important;
        border-radius: 8px !important;
        margin-bottom: 1.5rem !important;
        display: block !important;
    }

    .meta-portada { display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 0.5rem; }
    
    .titulo-portada { margin: 0.5rem 0; line-height: 1.3; font-family: var(--font-display); font-size: 1.5rem; }
    .titulo-portada a { text-decoration: none; color: var(--text-color, #333); transition: color 0.3s ease; }
    
    .desc-portada { flex-grow: 1; margin-bottom: 1.5rem; line-height: 1.6; font-size: 0.95rem; color: #555; }
    
    .btn-leer-mas-portada { margin-top: auto; }
    .btn-leer-mas-portada a { display: inline-block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-color, #333); text-decoration: none; font-weight: 500; transition: color 0.3s ease; }

    .btn-ver-mas-global {
        display: inline-block; 
        padding: 12px 24px; 
        border: 1px solid var(--text-color, #333); 
        border-radius: 8px; 
        text-decoration: none; 
        color: var(--text-color, #333); 
        font-size: 0.95rem; 
        text-transform: uppercase; 
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }
    .btn-ver-mas-global:hover {
        background-color: #006d77 !important; /* Fondo verde esmeralda */
        border-color: #006d77 !important;     /* Borde verde esmeralda */
        color: #ffffff !important;            /* Texto blanco */
    }
    /* MODO CELULAR (Pasa a 1 columna automáticamente) */
    @media (max-width: 800px) {
        #grilla-portada-segura {
            grid-template-columns: 1fr !important;
            gap: 4rem !important;
        }
        .img-portada {
            height: auto !important;
            max-height: 350px !important;
        }
    }
</style>