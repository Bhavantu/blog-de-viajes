---
import Layout from '../layouts/Layout.astro';

// 1. Buscamos todos los artículos
const posts = import.meta.glob('./diario/*.md', { eager: true });
const allPosts = Object.values(posts);

// 2. Los ordenamos por fecha
const sortedPosts = allPosts.sort((a, b) => {
    const dateA = new Date(a.frontmatter?.date || 0).valueOf();
    const dateB = new Date(b.frontmatter?.date || 0).valueOf();
    return dateB - dateA;
});

// 3. Filtramos los destacados y armamos la red de seguridad
let featuredPosts = sortedPosts.filter((post: any) => post.frontmatter.destacado === true);

if (featuredPosts.length < 3) {
    const cantidadFaltante = 3 - featuredPosts.length;
    const postsNoDestacados = sortedPosts.filter((post: any) => post.frontmatter.destacado !== true);
    featuredPosts = [...featuredPosts, ...postsNoDestacados.slice(0, cantidadFaltante)];
} else {
    featuredPosts = featuredPosts.slice(0, 3);
}
---

<Layout title="BLOGCITO - Inicio">
    <header>
        <h1><a href="/">BLOGCITO</a></h1>
        <nav>
            <ul>
                <li><a href="/" class="active-link">Inicio</a></li>
                <li><a href="/diario">Diario</a></li>
                <li><a href="/galeria">Galería</a></li>
                <li><a href="/nosotros">Nosotros</a></li>
            </ul>
        </nav>
    </header>

    <main class="container">
        
        <div style="display: flex; align-items: center; margin-bottom: 3rem; border-bottom: 1px solid #eee; padding-bottom: 1rem;">
            <h2 style="margin: 0; font-size: 1.5rem; font-weight: normal; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-color, #333);">Artículos Destacados</h2>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem 2.5rem; align-items: stretch;">
            
            {featuredPosts.map((post: any) => (
                <article class="journal-entry reveal visible" style="display: flex; flex-direction: column; margin-bottom: 0; height: 100%;">
                    
                    {/* Imagen con recorte perfecto forzado a 240px de alto */}
                    {post.frontmatter.main_image && (
                        <img 
                            src={post.frontmatter.main_image} 
                            alt={`Portada de ${post.frontmatter.title}`} 
                            style="width: 100%; height: 240px; object-fit: cover; border-radius: 8px; margin-bottom: 1.5rem;"
                        />
                    )}

                    <div style="display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 0.5rem;">
                        {post.frontmatter.tag && (
                            <span class="journal-tag" data-tag={post.frontmatter.tag.toLowerCase()}>
                                {post.frontmatter.tag}
                            </span>
                        )}
                        <span class="journal-date">
                            {new Date(post.frontmatter.date).toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase()}
                        </span>
                    </div>
                    
                    {/* Título con clase para el color azul */}
                    <h3 class="journal-title" style="margin-top: 0.5rem; line-height: 1.3;">
                        <a href={post.url} class="hover-azul" style="text-decoration: none; color: inherit; transition: color 0.3s ease;">
                            {post.frontmatter.title}
                        </a>
                    </h3>
                    
                    <p class="journal-body" style="flex-grow: 1; margin-bottom: 1.5rem; line-height: 1.6;">
                        {post.frontmatter.description || "Nueva entrada en nuestro diario de viaje..."}
                    </p>

                    {/* Botón Leer Más que siempre queda en el fondo */}
                    <div style="margin-top: auto;">
                        <a href={post.url} class="hover-azul" style="display: inline-block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-color, #333); text-decoration: none; font-weight: 500; transition: color 0.3s ease;">
                            Leer más &rarr;
                        </a>
                    </div>
                    
                </article>
            ))}
            
        </div>

        <div style="text-align: center; margin-top: 4rem; margin-bottom: 5rem;">
            <a href="/diario" class="btn-ver-mas">
                Ver más
            </a>
        </div>

    </main>
</Layout>

<style>
    /* Efecto hover azul para título y "Leer más" */
    .hover-azul:hover {
        color: #0056b3 !important;
    }

    /* Animación del botón Ver más principal */
    .btn-ver-mas {
        display: inline-block; 
        padding: 12px 24px; 
        border: 1px solid var(--text-color, #333); 
        border-radius: 8px; 
        text-decoration: none; 
        color: inherit; 
        font-size: 0.95rem; 
        text-transform: uppercase; 
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }

    .btn-ver-mas:hover {
        background-color: var(--text-color, #333);
        color: var(--bg-color, #fff);
    }
</style>