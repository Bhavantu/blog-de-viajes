---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro'; 

const currentLang = Astro.currentLocale || 'es';

const posts = import.meta.glob('./diario/*.md', { eager: true });
const allPosts = Object.values(posts);

const sortedPosts = allPosts.sort((a: any, b: any) => {
    const dateA = new Date(a.frontmatter?.date || 0).valueOf();
    const dateB = new Date(b.frontmatter?.date || 0).valueOf();
    return dateB - dateA;
});

let featuredPosts = sortedPosts.filter((post: any) => post.frontmatter.destacado === true);

if (featuredPosts.length < 3) {
    const cantidadFaltante = 3 - featuredPosts.length;
    const postsNoDestacados = sortedPosts.filter((post: any) => post.frontmatter.destacado !== true);
    featuredPosts = [...featuredPosts, ...postsNoDestacados.slice(0, cantidadFaltante)];
} else {
    featuredPosts = featuredPosts.slice(0, 3);
}
---

<Layout title="Inicio - BLOGCITO" 
description="Bitácora de viaje, información útil y vida local alrededor del mundo. Acompañanos a descubrir nuevos destinos a través de nuestras crónicas y guías."
isTransparentHeader={true}>

    <!-- HERO PERSONALIZADO PARA EL INICIO -->
    <section class="hero-inicio" style="background-image: url('/img/diario/');">
        <div class="hero-overlay"></div>
        
        <div class="hero-contenido-interno relative z-10">
            <h1 class="hero-title">Conociendo otros mundos a ritmo lento</h1>
            <p class="hero-subtitle">
                Diario de viajes, slow travel & nomadismo digital.
            </p>
            <div class="hero-actions">
                <a href="/diario" class="btn-primary">Explorar Destinos</a>
                <a href="#quienes-somos" class="btn-secondary">Conocer la historia</a>
            </div>
        </div>
    </section>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="container mx-auto px-4 pt-16">
        
        <!-- NUEVA SECCIÓN: DESTINOS 
        <section id="destinos" class="section-container">
            <div class="section-header">
                <h2 class="section-title">¿Qué estás planificando?</h2>
                <p class="section-subtitle">Acceso directo a las carpetas y rutas principales del blog</p>
            </div>

            <div class="categories-grid">
                <a href="/diario" class="category-card hover-verde">
                    <div>
                        <div class="card-icon">🌴</div>
                        <h3>Guías de Bali</h3>
                        <p>Slow travel, esnórquel en Amed, la verdad sobre la cultura en Ubud y presupuestos reales para nomadas digitales.</p>
                    </div>
                    <span class="card-link">Ver guías de Bali &rarr;</span>
                </a>

                <a href="/diario" class="category-card hover-verde">
                    <div>
                        <div class="card-icon">💻</div>
                        <h3>Nomadismo Digital & Guías</h3>
                        <p>Costo de vida, alquileres, trabajo remoto, presupuesto honesto y consejos de adaptación en distintos destinos.</p>
                    </div>
                    <span class="card-link">Ver guías nómadas &rarr;</span>
                </a>

                <a href="/diario" class="category-card hover-verde">
                    <div>
                        <div class="card-icon">📜</div>
                        <h3>Cultura y Reflexiones</h3>
                        <p>Ensayos sobre vida en comunidad, tradiciones locales, resiliencia y el valor del encuentro en el camino.</p>
                    </div>
                    <span class="card-link">Leer crónicas &rarr;</span>
                </a>
            </div>
        </section>-->

        <!-- SECCIÓN: GRILLA DINÁMICA DE POSTS -->
        <section id="guias" class="section-container">
            <div class="section-header">
                <h2 class="section-title">Por dónde empezar</h2>
                <p class="section-subtitle">Nuestras guías más leídas y detalladas para organizar tu ruta</p>
            </div>

            <div id="grilla-portada-segura">
                {featuredPosts.map((post: any) => (
                    <article class="tarjeta-portada reveal visible">
                        
                        {post.frontmatter.main_image && (
                            <img 
                                src={post.frontmatter.main_image} 
                                alt={`Portada de ${post.frontmatter.title}`} 
                                class="img-portada"
                            />
                        )}

                        <div class="meta-portada">
                            {post.frontmatter.tag && (
                                <span class="journal-tag" data-tag={post.frontmatter.tag.toLowerCase()}>
                                    {post.frontmatter.tag}
                                </span>
                            )}
                            <span class="journal-date">
                                {new Date(post.frontmatter.date).toLocaleDateString(currentLang === 'es' ? 'es-ES' : 'en-US', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase()}
                            </span>
                        </div>
                        
                        <h3 class="titulo-portada">
                            <a href={post.url} class="hover-verde">
                                {post.frontmatter.title}
                            </a>
                        </h3>
                        
                        <p class="desc-portada">
                            {post.frontmatter.description || "Nueva entrada en nuestro diario de viaje..."}
                        </p>

                        <div class="btn-leer-mas-portada">
                            <a href={post.url} class="hover-verde">
                                Leer más &rarr;
                            </a>
                        </div>
                        
                    </article>
                ))}
            </div>

            <div style="text-align: center; margin-top: 4rem;">
                <a href="/diario" class="btn-ver-mas-global">
                    Ver más
                </a>
            </div>
        </section>

        <!-- SECCIÓN: QUIÉNES SOMOS -->
        <section id="quienes-somos" class="about-section">
            <div class="about-container">
                <div class="about-image-box">
                    <img src="/img/nosotros.webp" alt="Creadores de Blogcito viajando" class="about-avatar" onerror="this.src='https://placehold.co/400x400/006d77/ffffff?text=Blogcito'">
                    <span class="about-badge">Viajeros & Creadores Nómadas</span>
                </div>
                <div class="about-content">
                    <h2 class="section-title">Detrás de Blogcito</h2>
                    <p style="margin-bottom: 1.5rem; line-height: 1.8; color: #555;">
                        Viajamos lento, habitamos los lugares y escribimos guías reales para que planifiques tu viaje con presupuesto honesto y respeto cultural. Más que coleccionar atracciones, nos interesa conectar con la gente, los territorios y sus costumbres, aprendiendo a partir de esa convivencia.
                    </p>
                    <p style="line-height: 1.8; color: #555;">
                        Creamos este espacio para responder las preguntas que todos nos hacemos antes de salir: cuánto cuesta realmente vivir en un lugar, cómo adaptarnos a la cultura local y cómo equilibrar el trabajo remoto con un viaje consciente. Sin contenido patrocinado engañoso: solo datos prácticos sobre alquileres, costos reales, estilo de vida nómada y crónicas desde el camino para darte herramientas claras que te ayuden a armar tu propio viaje, a tu ritmo.
                    </p>
                </div>
            </div>
        </section>

        <!-- SECCIÓN: COMUNIDAD Y RECURSOS (GRID UNIFICADO) -->
        <section class="support-section">
            <div class="section-header">
                <h2 class="section-title">Sé parte del proyecto</h2>
                <p class="section-subtitle">Distintas formas de apoyar nuestro trabajo y hacer crecer Blogcito</p>
            </div>

            <div class="support-grid">
                
                <!-- Tarjeta 1: Ko-fi -->
                <div class="support-card">
                    <div class="support-icon">☕</div>
                    <h3>Invitamos un café</h3>
                    <p>Mantenemos el blog libre de anuncios molestos. Si nuestras guías te ayudaron, podés apoyarnos con un café virtual.</p>
                    <a href="https://ko-fi.com/blogcito" target="_blank" class="support-btn btn-kofi">
                        Apoyar en Ko-fi
                    </a>
                </div>
                
                <!-- Tarjeta 2: Referidos / Afiliados -->
                <div class="support-card">
                    <div class="support-icon">🏠</div>
                    <h3>Reserva tus alojamientos</h3>
                    <p style="margin-bottom: 1.5rem; font-size: 0.95rem; color: #555;">Hacé tus reservas acá para apoyar al blog y ayudarnos a seguir viajando.</p>
                    <a href="https://www.booking.com/" target="_blank" rel="noopener noreferrer" class="support-btn btn-recursos">
                        Reservar en Booking.com
                    </a>
                </div>

                <!-- Tarjeta 3: Media Kit -->
                <div class="support-card">
                    <div class="support-icon">💻</div>
                    <h3>Trabajemos juntos</h3>
                    <p>Conocé nuestro Media Kit, las métricas del blog y cómo podemos colaborar para darle visibilidad a tu marca o proyecto.</p>
                    <a href="/colab" class="support-btn btn-colab">
                        Ver opciones
                    </a>
                </div>

            </div>
        </section>
        
    </main>
</Layout>

<style is:global>

