---
import Layout from '../layouts/Layout.astro';
---
<Layout title="MORSEROS | En una aventura sin igual">
    <header>
        <h1 onclick="window.location.href='/'">MORSEROS</h1>
        <nav>
            <ul>
                <li><a href="#" onclick="showSection('galeria')" id="nav-galeria" class="active-link">Galería</a></li>
                <li><a href="/diario" id="nav-diario">Diario</a></li>
                <li><a href="#" onclick="showSection('sobre-mi')" id="nav-sobre-mi">Sobre mí</a></li>
            </ul>
        </nav>
    </header>

    <main class="container">
        <section id="galeria" class="section-content active-section">
            <div class="photo-grid">
                <article class="photo-card reveal visible">
                    <div class="image-wrapper"><img src="/img/Fire and Drums/DSC_0092.JPG" alt="Fire"></div>
                </article>
                <article class="photo-card reveal visible">
                    <div class="image-wrapper"><img src="/img/lorenita/DSC_0422.JPG" alt="Lore"></div>
                </article>
            </div>
        </section>

        <section id="sobre-mi" class="section-content">
            <div class="about-layout">
                <div class="reveal visible"><img src="/img/lorenita/DSC_0794.JPG" class="about-img"></div>
                <div class="about-text reveal visible">
                    <h2>Hola soy...</h2>
                    <p>Abriendo el corazón soltamos el prejuicio... Lore y Santi, enraizados en LATAM.</p>
                </div>
            </div>
        </section>
    </main>

    <footer><p>&copy; 2026 MORSEROS.</p></footer>

    <script is:inline>
        function showSection(sectionId) {
            document.querySelectorAll('.section-content').forEach(sec => sec.classList.remove('active-section'));
            document.querySelectorAll('nav a').forEach(link => link.classList.remove('active-link'));
            document.getElementById(sectionId).classList.add('active-section');
            document.getElementById('nav-' + sectionId).classList.add('active-link');
        }
    </script>
</Layout>