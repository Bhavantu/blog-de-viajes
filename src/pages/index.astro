---
import Layout from '../layouts/Layout.astro';
---
<Layout title="BLOGCITO | en un viaje">
    <header>
        <h1 onclick="window.location.href='/'" style="cursor:pointer">BLOGCITO</h1>
        <nav>
            <ul>
                <li><a href="#" onclick="showSection('galeria'); return false;" id="nav-galeria" class="active-link">Galería</a></li>
                <li><a href="/diario" id="nav-diario">Diario</a></li>
                <li><a href="#" onclick="showSection('nosotros'); return false;" id="nav-nosotros">Nosotros</a></li>
            </ul>
        </nav>
    </header>

    <main class="container">
        <section id="sec-galeria" class="section-content active-section">
            <div class="photo-grid">
                <article class="photo-card reveal visible">
                    <div class="image-wrapper"><img src="/img/Fire and Drums/DSC_0092.JPG" alt="Fire and Drums"></div>
                    <div class="photo-info"><span class="photo-title">Fire and Drums</span><span>2024</span></div>
                </article>
                <article class="photo-card reveal visible delay-100">
                    <div class="image-wrapper"><img src="/img/lorenita/DSC_0422.JPG" alt="Buenos Aires"></div>
                    <div class="photo-info"><span class="photo-title">Buenos Aires</span><span>2024</span></div>
                </article>
                <article class="photo-card reveal visible">
                    <div class="image-wrapper"><img src="/img/Reserva/DSC_0375.JPG" alt="Reserva"></div>
                    <div class="photo-info"><span class="photo-title">Reserva</span><span>2023</span></div>
                </article>
                <article class="photo-card reveal visible delay-100">
                    <div class="image-wrapper"><img src="/img/Paisajes/changsha1.JPG" alt="Changsha"></div>
                    <div class="photo-info"><span class="photo-title">Changsha</span><span>2023</span></div>
                </article>
                <article class="photo-card reveal visible">
                    <div class="image-wrapper"><img src="/img/Paisajes/dananghands.JPG" alt="Da Nang"></div>
                    <div class="photo-info"><span class="photo-title">Da Nang</span><span>2022</span></div>
                </article>
                <article class="photo-card reveal visible delay-100">
                    <div class="image-wrapper"><img src="/img/Paisajes/templochina2.JPG" alt="Pekin"></div>
                    <div class="photo-info"><span class="photo-title">Pekin</span><span>2023</span></div>
                </article>
            </div>
        </section>

        <section id="sec-nosotros" class="section-content">
            <div class="about-layout">
                <div class="reveal visible">
                    <img src="/img/lorenita/DSC_0794.JPG" alt="Nosotros" class="about-img">
                </div>
                <div class="about-text reveal visible delay-100">
                    <h2>Hola, somos nosotros...</h2>
                    <p>Abriendo el corazon soltamos el prejucio con una convicción seguimos el delirio. Viajar desde el amor conectando con la vida, los pueblos las estrellas y los soles que nos guian. Muchas gracias humanitos que hoy leen el mensaje, entre risas y aventuras compartimos este viaje.</p>
                    <p>Abrazo grande, Lore y Santi, enraizados en LATAM descubriendo el mundo. <br> Vamo arriba!</p>
                </div>
            </div>
        </section>
    </main>

    <footer><p>&copy; 2026 BLOGCITO.</p></footer>

    <script is:inline>
        function showSection(sectionId) {
            document.querySelectorAll('.section-content').forEach(sec => sec.classList.remove('active-section'));
            document.querySelectorAll('nav a').forEach(link => link.classList.remove('active-link'));
            
            const target = document.getElementById('sec-' + sectionId);
            if (target) {
                target.classList.add('active-section');
                document.getElementById('nav-' + sectionId).classList.add('active-link');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            if (window.location.hash === '#nosotros') {
                showSection('nosotros');
                history.replaceState(null, null, window.location.pathname);
            }
        });
    </script>
</Layout>