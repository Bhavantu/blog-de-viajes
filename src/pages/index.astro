---
import Layout from '../layouts/Layout.astro';
import { ui } from '../i18n/ui.js';

const currentLang = Astro.currentLocale || 'es';
const t = ui[currentLang as keyof typeof ui] || ui['es'];

// Leemos las entradas de la carpeta en español
const posts = import.meta.glob('./diario/*.md', { eager: true });
const allPosts = Object.values(posts);

const sortedPosts = allPosts.sort((a: any, b: any) => {
    const dateA = new Date(a.frontmatter?.date || 0).valueOf();
    const dateB = new Date(b.frontmatter?.date || 0).valueOf();
    return dateB - dateA;
});

let featuredPosts = sortedPosts.filter((post: any) => post.frontmatter.destacado === true);

if (featuredPosts.length < 3) {
    const cantidadFaltante = 3 - featuredPosts.length;
    const postsNoDestacados = sortedPosts.filter((post: any) => post.frontmatter.destacado !== true);
    featuredPosts = [...featuredPosts, ...postsNoDestacados.slice(0, cantidadFaltante)];
} else {
    featuredPosts = featuredPosts.slice(0, 3);
}
---

<Layout 
  title="Inicio - BLOGCITO" 
  description="Diario de viaje, guías prácticas y vida local alrededor del mundo. Acompañanos a descubrir nuevos destinos a través de nuestras crónicas y viajes lentos."
  isTransparentHeader={true}
>

    <!-- HERO SECTION -->
    <section class="hero-inicio" style="background-image: url('/img/diario/UBUD3.webp');">
        <div class="hero-overlay"></div>
        
        <div class="hero-contenido-interno relative z-10">
            <h1 class="hero-title">Descubriendo nuevos mundos a paso lento</h1>
            <p class="hero-subtitle">
                Guías honestas y presupuestos transparentes para viajar con respeto cultural, trabajar en ruta y habitar nuevos territorios a tu propio ritmo.
            </p>
            <div class="hero-actions">
                <a href="#guias" class="btn-primary">Explorar Guías</a>
                <a href="#quienes-somos" class="btn-secondary">Nuestra Historia</a>
            </div>
        </div>
    </section>

    <!-- MAIN CONTENT -->
    <main class="container mx-auto px-4 pt-16">
        
        <!-- SECTION: FEATURED POSTS -->
        <section id="guias" class="section-container">
            <div class="section-header">
                <h2 class="section-title">Por dónde empezar</h2>
                <p class="section-subtitle">Nuestras guías más leídas y detalladas para ayudarte a planificar tu viaje</p>
            </div>

            <div id="grilla-portada-segura">
                {featuredPosts.map((post: any) => {
                    const tagKey = `tag.${post.frontmatter.tag?.toLowerCase()}`;
                    const translatedTag = t[tagKey as keyof typeof t] || post.frontmatter.tag;

                    return (
                        <article class="tarjeta-portada reveal visible">
                            
                            {post.frontmatter.main_image && (
                                <img 
                                    src={post.frontmatter.main_image} 
                                    alt={`Portada de ${post.frontmatter.title}`} 
                                    class="img-portada"
                                />
                            )}

                            <div class="meta-portada">
                                {post.frontmatter.tag && (
                                    <span class="journal-tag" data-tag={post.frontmatter.tag.toLowerCase()}>
                                        {translatedTag}
                                    </span>
                                )}
                                <span class="journal-date">
                                    {new Date(post.frontmatter.date).toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase()}
                                </span>
                            </div>
                            
                            <h3 class="titulo-portada">
                                <a href={post.url} class="hover-verde">
                                    {post.frontmatter.title}
                                </a>
                            </h3>
                            
                            <p class="desc-portada">
                                {post.frontmatter.description || "Nueva entrada en nuestro diario de viaje..."}
                            </p>

                            <div class="btn-leer-mas-portada">
                                <a href={post.url} class="hover-verde">
                                    Leer más &rarr;
                                </a>
                            </div>
                            
                        </article>
                    );
                })}
            </div>

            <div style="text-align: center; margin-top: 4rem;">
                <a href="/diario" class="btn-ver-mas-global">
                    Ver todas las entradas
                </a>
            </div>
        </section>

        <!-- SECTION: ABOUT US -->
        <section id="quienes-somos" class="about-section">
            <div class="about-container">
                <div class="about-image-box">
                    <img src="/img/nosotros.webp" alt="Creadores de Blogcito viajando" class="about-avatar" onerror="this.src='https://placehold.co/400x400/006d77/ffffff?text=Blogcito'">
                    <span class="about-badge">Viajeros y Creadores</span>
                </div>
                <div class="about-content">
                    <h2 class="section-title">Detrás de Blogcito</h2>
                    <p style="margin-bottom: 1.5rem; line-height: 1.8; color: #555;">
                        Viajamos lento, nos sumergimos en las comunidades locales y escribimos guías honestas para que puedas planear tu viaje con un presupuesto realista y respeto cultural. Más que coleccionar atracciones, nos importa conectar con las personas, los territorios y las tradiciones.
                    </p>
                    <p style="line-height: 1.8; color: #555;">
                        Creamos este espacio para responder las preguntas reales que todos nos hacemos antes de partir: cuánto cuesta realmente vivir en un lugar, cómo adaptarse a las culturas locales y cómo equilibrar el trabajo remoto con el viaje consciente. Sin publicidades engañosas, solo datos prácticos sobre alquileres, costo de vida y nomadismo digital.
                    </p>
                </div>
            </div>
        </section>

        <!-- SECTION: SUPPORT & RESOURCES -->
        <section class="support-section">
            <div class="section-header">
                <h2 class="section-title">Apoyá nuestro proyecto</h2>
                <p class="section-subtitle">Diferentes formas de apoyar nuestro trabajo y hacer que Blogcito siga creciendo</p>
            </div>

            <!-- BLOQUE 1: RECURSOS DE VIAJE (AFILIADOS) -->
            <h3 class="subsection-title">Recursos de viaje</h3>
            <div class="affiliates-grid">
                
                <!-- Booking.com -->
                <div class="support-card">
                    <div class="support-icon-container">
                        <img 
                            src="https://upload.wikimedia.org/wikipedia/commons/6/6b/Booking.com_Icon_2022.svg" 
                            alt="Logo Booking.com" 
                            style="height: 42px; width: auto; max-width: 100%; object-fit: contain;"
                        />
                    </div>
                    <h3>Reservá alojamiento</h3>
                    <p>Reservá tus alojamientos por acá para apoyar al blog y que nuestras guías sigan siendo de acceso gratuito.</p>
                    <a href="https://www.booking.com/" target="_blank" rel="noopener noreferrer" class="support-btn btn-recursos">
                        Reservar en Booking.com
                    </a>
                </div>

                <!-- Airalo eSIM -->
                <div class="support-card">
                    <div class="support-icon-container">
                        <img 
                            src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/dc/Airalo_logo.svg/1280px-Airalo_logo.svg.webp" 
                            alt="Logo Airalo" 
                            style="height: 32px; width: auto; max-width: 100%; object-fit: contain;"
                        />
                    </div>
                    <h3>Internet en tu viaje</h3>
                    <p>Mantenete conectado en cualquier país con una eSIM de Airalo y olvidate de los costosos cargos de roaming.</p>
                    <a href="https://airalo.tpx.lu/8J5sLaD4" target="_blank" rel="noopener noreferrer" class="support-btn btn-airalo">
                        Conseguir eSIM Airalo
                    </a>
                </div>

                <!-- GetYourGuide -->
                <div class="support-card">
                    <div class="support-icon-container">
                        <img 
                            src="https://upload.wikimedia.org/wikipedia/commons/thumb/e/e2/GetYourGuide_logo.svg/1280px-GetYourGuide_logo.svg.webp?utm_source=commons.wikimedia.org&utm_campaign=index&utm_content=thumbnail&_=20250423234221" 
                            alt="Logo GetYourGuide" 
                            style="height: 32px; width: auto; max-width: 100%; object-fit: contain;"
                        />
                    </div>
                    <h3>Tours y Actividades</h3>
                    <p>Reservá tours locales, excursiones y entradas sin filas a través de GetYourGuide para apoyar nuestros viajes.</p>
                    <a href="https://www.getyourguide.com/" target="_blank" rel="noopener noreferrer" class="support-btn btn-gyg">
                        Explorar Tours
                    </a>
                </div>

            </div>

            <!-- BLOQUE 2: APOYO DIRECTO (KO-FI & MEDIA KIT) -->
            <h3 class="subsection-title">Apoyo Directo y Colaboraciones</h3>
            <div class="direct-grid">
                
                <!-- Ko-fi -->
                <div class="support-card">
                    <div class="support-icon-container">
                        <span class="support-emoji">☕</span>
                    </div>
                    <h3>Invitanos un café</h3>
                    <p>Mantenemos nuestro blog sin publicidad y limpio. Si nuestras guías te ayudaron a planear tu viaje, podés apoyarnos con un café virtual.</p>
                    <a href="https://ko-fi.com/blogcito" target="_blank" rel="noopener noreferrer" class="support-btn btn-kofi">
                        Apoyar en Ko-fi
                    </a>
                </div>

                <!-- Media Kit -->
                <div class="support-card">
                    <div class="support-icon-container">
                        <span class="support-emoji">💻</span>
                    </div>
                    <h3>Trabajá con nosotros</h3>
                    <p>Revisá nuestro Media Kit, métricas del blog, y cómo podemos colaborar para darle visibilidad a tu marca o proyecto.</p>
                    <a href="/colab" class="support-btn btn-colab">
                        Opciones de colaboración
                    </a>
                </div>

            </div>
        </section>
        
    </main>
</Layout>

<style is:global>
    /* ============================================================
        ESTILOS GENERALES Y CONTENEDOR
       ============================================================ */
    main.container {
        max-width: 1200px !important;
    }

    .section-container {
        margin-bottom: 7rem;
    }

    .section-header {
        text-align: center;
        margin-bottom: 2rem;
        border-bottom: 1px solid #eee;
        padding-bottom: 1.5rem;
    }

    .section-title {
        font-family: var(--font-display);
        font-size: 2.2rem;
        font-weight: normal;
        color: var(--text-color, #333);
        margin-bottom: 0.5rem;
    }

    .section-subtitle {
        color: #777;
        font-size: 1.05rem;
        letter-spacing: 0.02em;
    }

    /* ============================================================
       ESTILOS DEL HERO PRINCIPAL
       ============================================================ */
    .hero-inicio {
        position: relative;
        width: 100%;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        text-align: center;
        padding: 2rem;
        margin-top: -120px; 
        padding-top: 120px; 
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.45); 
        z-index: 1;
    }

    .hero-contenido-interno {
        position: relative;
        z-index: 2;
        max-width: 800px;
        color: #ffffff;
    }

    .hero-inicio .hero-title {
        font-family: var(--font-display);
        font-size: 3.5rem;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        font-weight: normal;
        text-shadow: 0 2px 10px rgba(0,0,0,0.4);
    }

    .hero-inicio .hero-subtitle {
        font-size: 1.15rem;
        line-height: 1.6;
        margin-bottom: 3rem;
        text-shadow: 0 1px 5px rgba(0,0,0,0.6);
        color: #f4f1ea;
    }

    .hero-actions {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
    }

    .btn-primary {
        background-color: #006d77;
        color: #ffffff;
        padding: 14px 32px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        border: 1px solid #006d77;
    }

    .btn-primary:hover {
        background-color: #005a62;
        transform: translateY(-2px);
    }

    .btn-secondary {
        background-color: transparent;
        color: #ffffff;
        padding: 14px 32px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.9rem;
        border: 1px solid #ffffff;
        transition: all 0.3s ease;
    }

    .btn-secondary:hover {
        background-color: #ffffff;
        color: #333333;
    }

    @media (max-width: 768px) {
        .hero-inicio {
            min-height: 100vh !important;
            margin-top: 0 !important; 
            padding: 130px 1.5rem 3rem 1.5rem !important; 
            align-items: flex-start !important; 
            margin-bottom: 2rem !important;
        }

        .hero-contenido-interno {
            width: 100% !important;
            margin-top: 2rem !important; 
        }
        
        .hero-badge {
            font-size: 0.7rem !important;
            margin-bottom: 1.5rem !important;
        }

        .hero-inicio .hero-title {
            font-size: 2.2rem !important;
            margin-bottom: 1rem !important;
        }

        .hero-inicio .hero-subtitle {
            font-size: 1.05rem !important;
            margin-bottom: 2rem !important;
        }

        .hero-actions {
            flex-direction: column;
            gap: 1rem;
        }
        
        .btn-primary, .btn-secondary {
            width: 100%;
        }
    }

    /* ============================================================
       ESTILOS EXCLUSIVOS DE LA PORTADA
       ============================================================ */
    #grilla-portada-segura {
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 2.5rem !important;
        width: 100% !important;
        align-items: stretch !important;
    }

    .tarjeta-portada {
        display: flex !important;
        flex-direction: column !important;
        height: 100% !important;
        min-width: 0 !important; 
        margin: 0 !important;
        padding: 0 !important; 
        border: none !important;
        max-width: 100% !important;
        background-color: #ffffff !important;
        border-radius: 0 !important; 
        box-shadow: 0 4px 10px rgba(0,0,0,0.03) !important; 
    }

    .img-portada {
        width: 100% !important;
        height: 220px !important;
        object-fit: cover !important;
        display: block !important;
        border-radius: 0 !important; 
        margin-bottom: 1.5rem !important;
    }

    .meta-portada,
    .titulo-portada,
    .desc-portada,
    .btn-leer-mas-portada {
        padding-left: 1.5rem !important;
        padding-right: 1.5rem !important;
    }

    .meta-portada { display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 0.5rem; }
    
    .titulo-portada { margin: 0.5rem 0; line-height: 1.3; font-family: var(--font-display); font-size: 1.5rem; }
    .titulo-portada a { text-decoration: none; color: var(--text-color, #333); transition: color 0.3s ease; }
    
    .desc-portada { flex-grow: 1; margin-bottom: 1.5rem; line-height: 1.6; font-size: 0.95rem; color: #555; }
    
    .btn-leer-mas-portada { margin-top: auto; padding-bottom: 2rem !important; }
    .btn-leer-mas-portada a { display: inline-block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-color, #333); text-decoration: none; font-weight: 500; transition: color 0.3s ease; }

    .btn-ver-mas-global {
        display: inline-block; 
        padding: 12px 24px; 
        border: 1px solid var(--text-color, #333); 
        border-radius: 8px; 
        text-decoration: none; 
        color: var(--text-color, #333); 
        font-size: 0.95rem; 
        text-transform: uppercase; 
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }
    .btn-ver-mas-global:hover {
        background-color: #006d77 !important; 
        border-color: #006d77 !important;     
        color: #ffffff !important;            
    }

    /* ============================================================
       ESTILOS DE QUIÉNES SOMOS Y COMUNIDAD
       ============================================================ */
    .about-section {
        background-color: #ffffff;
        padding: 4rem;
        box-shadow: 0 4px 10px rgba(0,0,0,0.03);
        margin-bottom: 7rem;
    }

    .about-container {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 4rem;
        align-items: center;
    }

    .about-image-box {
        position: relative;
        text-align: center;
    }

    .about-avatar {
        width: 100%;
        max-width: 300px;
        height: auto;
        border-radius: 8px;
        object-fit: cover;
    }

    .about-badge {
        position: absolute;
        bottom: -15px;
        left: 50%;
        transform: translateX(-50%);
        background-color: #006d77;
        color: white;
        padding: 6px 16px;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        white-space: nowrap;
        border-radius: 20px;
    }

    /* ============================================================
       ESTILOS DE LA GRILLA DE APOYO Y RECURSOS
       ============================================================ */
    .support-section {
        padding: 4rem 0 6rem 0;
        border-top: 1px solid #eee;
    }

    /* SUBTÍTULOS DE LAS SECCIONES */
    .subsection-title {
        text-align: center;
        font-family: var(--font-display);
        font-size: 1.6rem;
        margin-top: 3.5rem;
        margin-bottom: 2rem;
        color: var(--text-color, #333);
        font-weight: normal;
    }

    /* GRILLA 1: AFILIADOS (3 COLUMNAS) */
    .affiliates-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2.5rem;
        margin-bottom: 2rem;
    }

    /* GRILLA 2: APOYO DIRECTO (2 COLUMNAS MÁS ANCHAS) */
    .direct-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2.5rem;
        max-width: 900px;
        margin: 0 auto;
    }

    .support-card {
        background-color: #ffffff;
        padding: 2.5rem 2rem;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #f0f0f0;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .support-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.06);
    }

    .support-icon-container {
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.2rem;
        width: 100%;
    }

    .support-emoji {
        font-size: 2.5rem;
        line-height: 1;
    }

    .support-card h3 {
        font-family: var(--font-display);
        font-size: 1.35rem;
        margin-bottom: 1rem;
        color: var(--text-color, #333);
        font-weight: normal;
    }

    .support-card p {
        font-size: 0.92rem;
        color: #666;
        line-height: 1.6;
        margin-bottom: 2rem;
        flex-grow: 1; 
    }

    /* BOTONES */
    .support-btn {
        display: inline-block;
        padding: 12px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: all 0.3s ease;
        width: 100%;
        box-sizing: border-box;
    }

    .btn-kofi {
        background-color: #323842;
        color: #ffffff;
        border: 1px solid #323842;
    }
    .btn-kofi:hover { background-color: #1a1e24; color: #ffffff; }

    .btn-recursos {
        background-color: transparent;
        color: #003580;
        border: 1px solid #003580;
    }
    .btn-recursos:hover { 
        background-color: #003580; 
        color: #ffffff; 
    }

    .btn-airalo {
        background-color: transparent;
        color: #ff5e00;
        border: 1px solid #ff5e00;
    }
    .btn-airalo:hover { 
        background-color: #ff5e00; 
        color: #ffffff; 
    }

    .btn-gyg {
        background-color: transparent;
        color: #ff5533;
        border: 1px solid #ff5533;
    }
    .btn-gyg:hover {
        background-color: #ff5533;
        color: #ffffff;
    }

    .btn-colab {
        background-color: #006d77;
        color: #ffffff;
        border: 1px solid #006d77;
    }
    .btn-colab:hover { background-color: #005a62; border-color: #005a62; color: #ffffff;}

    /* ============================================================
       RESPONSIVE DESIGN (MÓVILES)
       ============================================================ */
    @media (max-width: 950px) {
        .affiliates-grid {
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        }
    }

    @media (max-width: 800px) {
        #grilla-portada-segura {
            grid-template-columns: 1fr !important;
            gap: 3rem !important;
        }
        
        .img-portada {
            height: auto !important;
            max-height: 350px !important;
        }

        .about-container {
            grid-template-columns: 1fr;
            gap: 3rem;
            text-align: center;
        }

        .about-section {
            padding: 2.5rem 1.5rem;
        }
    }

    @media (max-width: 700px) {
        .affiliates-grid,
        .direct-grid {
            grid-template-columns: 1fr;
            padding: 0 1rem;
        }
    }
</style>