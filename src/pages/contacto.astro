---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto | BLOGCITO">
        <header class="site-header">
        <h1><a href="/">BLOGCITO</a></h1>
        <button id="mobile-menu-btn" class="menu-toggle">☰</button>
        <nav id="main-nav">
        <ul class="nav-links">
            <li><a href="/">Inicio</a></li>
            <li><a href="/diario">Diario</a></li>
            <li><a href="/nosotros">Nosotros</a></li>
            
            <!-- LUPA MINIMALISTA SVG -->
            <li class="btn-buscar">
                <a href="#" title="Buscar" style="display: flex; align-items: center; padding-top: 2px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </a>
            </li>
        </ul>
        </nav>
    </header>

    <main class="container" style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem; text-align: center;">
        <h2>Hablemos</h2>
        <p style="margin-bottom: 2rem;">¿Tenés alguna duda sobre nuestras rutas, sugerencias para el blog o consultas comerciales? br Nos encantaría leerte.</p>
        
        <div style="background-color: #f4f4f4; padding: 2rem; border-radius: 8px;">
            <h3>Escribinos directamente</h3>
            <p>Puedes enviarnos un correo electrónico y te responderemos lo antes posible:</p>
            <a href="mailto:lorenagonzalez.contenidodigital@gmail.com" style="display: inline-block; background-color: #333; color: #fff; padding: 10px 20px; text-decoration: none; border-radius: 5px; margin-top: 1rem;">
                Enviar un correo
            </a>
        </div>
    </main>
</Layout>