---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto | BLOGCITO">
    <header>
        <h1><a href="/">BLOGCITO</a></h1>
        <nav>
            <ul>
                <li><a href="/">Galería</a></li>
                <li><a href="/diario">Diario</a></li>
                <li><a href="/#nosotros">Nosotros</a></li>
            </ul>
        </nav>
    </header>

    <main class="container" style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem; text-align: center;">
        <h2>Hablemos</h2>
        <p style="margin-bottom: 2rem;">¿Tenés alguna duda sobre nuestras rutas, sugerencias para el blog o consultas comerciales? Nos encantaría leerte.</p>
        
        <div style="background-color: #f4f4f4; padding: 2rem; border-radius: 8px;">
            <h3>Escribinos directamente</h3>
            <p>Puedes enviarnos un correo electrónico y Lorena o yo te responderemos lo antes posible:</p>
            <a href="mailto:hola@tudominio.com" style="display: inline-block; background-color: #333; color: #fff; padding: 10px 20px; text-decoration: none; border-radius: 5px; margin-top: 1rem;">
                Enviar un correo
            </a>
        </div>
    </main>

    <footer><p>&copy; 2026 BLOGCITO.</p></footer>
</Layout>