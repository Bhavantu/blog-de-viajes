---
import Layout from '../../layouts/Layout.astro';

const currentLang = Astro.currentLocale || 'en';

// Leemos las entradas que estarán en la carpeta de inglés
const posts = import.meta.glob('./journal/*.md', { eager: true });
const allPosts = Object.values(posts);

const sortedPosts = allPosts.sort((a: any, b: any) => {
    const dateA = new Date(a.frontmatter?.date || 0).valueOf();
    const dateB = new Date(b.frontmatter?.date || 0).valueOf();
    return dateB - dateA;
});

let featuredPosts = sortedPosts.filter((post: any) => post.frontmatter.destacado === true);

if (featuredPosts.length < 3) {
    const cantidadFaltante = 3 - featuredPosts.length;
    const postsNoDestacados = sortedPosts.filter((post: any) => post.frontmatter.destacado !== true);
    featuredPosts = [...featuredPosts, ...postsNoDestacados.slice(0, cantidadFaltante)];
} else {
    featuredPosts = featuredPosts.slice(0, 3);
}
---

<Layout 
  title="Home - BLOGCITO" 
  description="Travel journal, practical guides, and local life around the world. Join us as we discover new destinations through our stories and slow travel guides."
  isTransparentHeader={true}
>

    <!-- HERO SECTION IN ENGLISH -->
    <section class="hero-inicio" style="background-image: url('/img/diario/UBUD3.webp');">
        <div class="hero-overlay"></div>
        
        <div class="hero-contenido-interno relative z-10">
            <span class="hero-badge">Travel journal, slow travel & digital nomadism</span>
            <h1 class="hero-title">Discovering new worlds at a slow pace</h1>
            <p class="hero-subtitle">
                Honest guides and transparent budgets to travel with cultural respect, work on the road, and inhabit new territories at your own rhythm.
            </p>
            <div class="hero-actions">
                <a href="#guias" class="btn-primary">Explore Guides</a>
                <a href="#quienes-somos" class="btn-secondary">Our Story</a>
            </div>
        </div>
    </section>

    <!-- MAIN CONTENT -->
    <main class="container mx-auto px-4 pt-16">
        
        <!-- SECTION: FEATURED POSTS -->
        <section id="guias" class="section-container">
            <div class="section-header">
                <h2 class="section-title">Where to start</h2>
                <p class="section-subtitle">Our most read and detailed guides to help you plan your journey</p>
            </div>

            <div id="grilla-portada-segura">
                {featuredPosts.map((post: any) => (
                    <article class="tarjeta-portada reveal visible">
                        
                        {post.frontmatter.main_image && (
                            <img 
                                src={post.frontmatter.main_image} 
                                alt={`Cover for ${post.frontmatter.title}`} 
                                class="img-portada"
                            />
                        )}

                        <div class="meta-portada">
                            {post.frontmatter.tag && (
                                <span class="journal-tag" data-tag={post.frontmatter.tag.toLowerCase()}>
                                    {post.frontmatter.tag}
                                </span>
                            )}
                            <span class="journal-date">
                                {new Date(post.frontmatter.date).toLocaleDateString('en-US', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase()}
                            </span>
                        </div>
                        
                        <h3 class="titulo-portada">
                            <a href={post.url} class="hover-verde">
                                {post.frontmatter.title}
                            </a>
                        </h3>
                        
                        <p class="desc-portada">
                            {post.frontmatter.description || "New entry in our travel journal..."}
                        </p>

                        <div class="btn-leer-mas-portada">
                            <a href={post.url} class="hover-verde">
                                Read more &rarr;
                            </a>
                        </div>
                        
                    </article>
                ))}
            </div>

            <div style="text-align: center; margin-top: 4rem;">
                <a href="/en/journal" class="btn-ver-mas-global">
                    View all posts
                </a>
            </div>
        </section>

        <!-- SECTION: ABOUT US -->
        <section id="quienes-somos" class="about-section">
            <div class="about-container">
                <div class="about-image-box">
                    <img src="/img/nosotros.webp" alt="Blogcito creators traveling" class="about-avatar" onerror="this.src='https://placehold.co/400x400/006d77/ffffff?text=Blogcito'">
                    <span class="about-badge">Travelers & Nomad Creators</span>
                </div>
                <div class="about-content">
                    <h2 class="section-title">Behind Blogcito</h2>
                    <p style="margin-bottom: 1.5rem; line-height: 1.8; color: #555;">
                        We travel slowly, immerse ourselves in local communities, and write honest guides so you can plan your trip with a realistic budget and cultural respect. More than collecting attractions, we care about connecting with people, territories, and traditions.
                    </p>
                    <p style="line-height: 1.8; color: #555;">
                        We created this space to answer the real questions we all ask before setting off: how much it actually costs to live in a place, how to adapt to local cultures, and how to balance remote work with conscious travel. No deceptive sponsored content—just practical insights on rent, living costs, and digital nomad life.
                    </p>
                </div>
            </div>
        </section>

        <!-- SECTION: SUPPORT & RESOURCES -->
        <section class="support-section">
            <div class="section-header">
                <h2 class="section-title">Support our project</h2>
                <p class="section-subtitle">Different ways to support our work and keep Blogcito growing</p>
            </div>

            <div class="support-grid">
                
                <!-- Card 1: Ko-fi -->
                <div class="support-card">
                    <div class="support-icon">☕</div>
                    <h3>Buy us a coffee</h3>
                    <p>We keep our blog ad-free and clean. If our guides helped you plan your trip, you can support us with a virtual coffee.</p>
                    <a href="https://ko-fi.com/blogcito" target="_blank" class="support-btn btn-kofi">
                        Support on Ko-fi
                    </a>
                </div>

                <!-- Card 2: Resources -->
                <div class="support-card">
                    <div class="support-icon">🏠</div>
                    <h3>Book your stays</h3>
                    <p style="margin-bottom: 1.5rem; font-size: 0.95rem; color: #555;">Book your accommodation here to support the blog and keep us going.</p>
                    <a href="https://www.booking.com/" target="_blank" rel="noopener noreferrer" class="support-btn btn-recursos">
                        Book on Booking.com
                    </a>
                </div>

                <!-- Card 3: Media Kit -->
                <div class="support-card">
                    <div class="support-icon">💻</div>
                    <h3>Work with us</h3>
                    <p>Check out our Media Kit, blog analytics, and how we can collaborate to give visibility to your brand or project.</p>
                    <a href="/en/colab" class="support-btn btn-colab">
                        Collaboration options
                    </a>
                </div>

            </div>
        </section>
        
    </main>
</Layout>
<style is:global>
    /* ============================================================
        ESTILOS GENERALES Y CONTENEDOR
       ============================================================ */
    main.container {
        max-width: 1200px !important;
    }

    .section-container {
        margin-bottom: 7rem;
    }

    .section-header {
        text-align: center;
        margin-bottom: 3.5rem;
        border-bottom: 1px solid #eee;
        padding-bottom: 1.5rem;
    }

    .section-title {
        font-family: var(--font-display);
        font-size: 2.2rem;
        font-weight: normal;
        color: var(--text-color, #333);
        margin-bottom: 0.5rem;
    }

    .section-subtitle {
        color: #777;
        font-size: 1.05rem;
        letter-spacing: 0.02em;
    }

    /* ============================================================
       ESTILOS DEL HERO PRINCIPAL
       ============================================================ */
    .hero-inicio {
        position: relative;
        width: 100%;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        text-align: center;
        padding: 2rem;
        margin-top: -120px; 
        padding-top: 120px; 
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.45); 
        z-index: 1;
    }

    .hero-contenido-interno {
        position: relative;
        z-index: 2;
        max-width: 800px;
        color: #ffffff;
    }

    .hero-badge {
        display: inline-block;
        background-color: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(4px);
        padding: 6px 18px;
        border-radius: 20px;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.3);
        font-weight: 500;
    }

    .hero-inicio .hero-title {
        font-family: var(--font-display);
        font-size: 3.5rem;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        font-weight: normal;
        text-shadow: 0 2px 10px rgba(0,0,0,0.4);
    }

    .hero-inicio .hero-subtitle {
        font-size: 1.15rem;
        line-height: 1.6;
        margin-bottom: 3rem;
        text-shadow: 0 1px 5px rgba(0,0,0,0.6);
        color: #f4f1ea;
    }

    .hero-actions {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
    }

    .btn-primary {
        background-color: #006d77;
        color: #ffffff;
        padding: 14px 32px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        border: 1px solid #006d77;
    }

    .btn-primary:hover {
        background-color: #005a62;
        transform: translateY(-2px);
    }

    .btn-secondary {
        background-color: transparent;
        color: #ffffff;
        padding: 14px 32px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.9rem;
        border: 1px solid #ffffff;
        transition: all 0.3s ease;
    }

    .btn-secondary:hover {
        background-color: #ffffff;
        color: #333333;
    }

    @media (max-width: 768px) {
        .hero-inicio {
            min-height: 100vh !important;
            margin-top: 0 !important; 
            padding: 130px 1.5rem 3rem 1.5rem !important; 
            align-items: flex-start !important; 
            margin-bottom: 2rem !important;
        }

        .hero-contenido-interno {
            width: 100% !important;
            margin-top: 2rem !important; 
        }
        
        .hero-badge {
            font-size: 0.7rem !important;
            margin-bottom: 1.5rem !important;
        }

        .hero-inicio .hero-title {
            font-size: 2.2rem !important;
            margin-bottom: 1rem !important;
        }

        .hero-inicio .hero-subtitle {
            font-size: 1.05rem !important;
            margin-bottom: 2rem !important;
        }

        .hero-actions {
            flex-direction: column;
            gap: 1rem;
        }
        
        .btn-primary, .btn-secondary {
            width: 100%;
        }
    }

    /* ============================================================
       ESTILOS EXCLUSIVOS DE LA PORTADA
       ============================================================ */
    #grilla-portada-segura {
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 2.5rem !important;
        width: 100% !important;
        align-items: stretch !important;
    }

    .tarjeta-portada {
        display: flex !important;
        flex-direction: column !important;
        height: 100% !important;
        min-width: 0 !important; 
        margin: 0 !important;
        padding: 0 !important; 
        border: none !important;
        max-width: 100% !important;
        background-color: #ffffff !important;
        border-radius: 0 !important; 
        box-shadow: 0 4px 10px rgba(0,0,0,0.03) !important; 
    }

    .img-portada {
        width: 100% !important;
        height: 220px !important;
        object-fit: cover !important;
        display: block !important;
        border-radius: 0 !important; 
        margin-bottom: 1.5rem !important;
    }

    .meta-portada,
    .titulo-portada,
    .desc-portada,
    .btn-leer-mas-portada {
        padding-left: 1.5rem !important;
        padding-right: 1.5rem !important;
    }

    .meta-portada { display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 0.5rem; }
    
    .titulo-portada { margin: 0.5rem 0; line-height: 1.3; font-family: var(--font-display); font-size: 1.5rem; }
    .titulo-portada a { text-decoration: none; color: var(--text-color, #333); transition: color 0.3s ease; }
    
    .desc-portada { flex-grow: 1; margin-bottom: 1.5rem; line-height: 1.6; font-size: 0.95rem; color: #555; }
    
    .btn-leer-mas-portada { margin-top: auto; padding-bottom: 2rem !important; }
    .btn-leer-mas-portada a { display: inline-block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-color, #333); text-decoration: none; font-weight: 500; transition: color 0.3s ease; }

    .btn-ver-mas-global {
        display: inline-block; 
        padding: 12px 24px; 
        border: 1px solid var(--text-color, #333); 
        border-radius: 8px; 
        text-decoration: none; 
        color: var(--text-color, #333); 
        font-size: 0.95rem; 
        text-transform: uppercase; 
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }
    .btn-ver-mas-global:hover {
        background-color: #006d77 !important; 
        border-color: #006d77 !important;     
        color: #ffffff !important;            
    }

    /* ============================================================
       ESTILOS DE QUIÉNES SOMOS Y COMUNIDAD
       ============================================================ */
    .about-section {
        background-color: #ffffff;
        padding: 4rem;
        box-shadow: 0 4px 10px rgba(0,0,0,0.03);
        margin-bottom: 7rem;
    }

    .about-container {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 4rem;
        align-items: center;
    }

    .about-image-box {
        position: relative;
        text-align: center;
    }

    .about-avatar {
        width: 100%;
        max-width: 300px;
        height: auto;
        border-radius: 8px;
        object-fit: cover;
    }

    .about-badge {
        position: absolute;
        bottom: -15px;
        left: 50%;
        transform: translateX(-50%);
        background-color: #006d77;
        color: white;
        padding: 6px 16px;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        white-space: nowrap;
        border-radius: 20px;
    }

    /* ============================================================
       ESTILOS DE LA GRILLA DE APOYO Y RECURSOS
       ============================================================ */
    .support-section {
        padding: 4rem 0 6rem 0;
        border-top: 1px solid #eee;
    }

    .support-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        margin-top: 3rem;
    }

    .support-card {
        background-color: #ffffff;
        padding: 2.5rem 2rem;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #f0f0f0;
        display: flex;
        flex-direction: column;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .support-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.06);
    }

    .support-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .support-card h3 {
        font-family: var(--font-display);
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: var(--text-color, #333);
        font-weight: normal;
    }

    .support-card p {
        font-size: 0.95rem;
        color: #666;
        line-height: 1.6;
        margin-bottom: 2rem;
        flex-grow: 1; 
    }

    .support-btn {
        display: inline-block;
        padding: 12px 24px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: all 0.3s ease;
        width: 100%;
    }

    .btn-kofi {
        background-color: #323842;
        color: #ffffff;
        border: 1px solid #323842;
    }
    .btn-kofi:hover { background-color: #1a1e24; color: #ffffff; }

    .btn-recursos {
        background-color: transparent;
        color: #006d77;
        border: 1px solid #006d77;
    }
    .btn-recursos:hover { background-color: #006d77; color: #ffffff; }

    .btn-colab {
        background-color: #006d77;
        color: #ffffff;
        border: 1px solid #006d77;
    }
    .btn-colab:hover { background-color: #005a62; border-color: #005a62; color: #ffffff;}

    /* ============================================================
       RESPONSIVE DESIGN (MÓVILES)
       ============================================================ */
    @media (max-width: 850px) {
        .support-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
            padding: 0 1rem;
        }
    }

    @media (max-width: 800px) {
        #grilla-portada-segura {
            grid-template-columns: 1fr !important;
            gap: 3rem !important;
        }
        
        .img-portada {
            height: auto !important;
            max-height: 350px !important;
        }

        .about-container {
            grid-template-columns: 1fr;
            gap: 3rem;
            text-align: center;
        }

        .about-section {
            padding: 2.5rem 1.5rem;
        }
    }
</style>