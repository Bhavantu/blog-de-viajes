---
import type { Page, GetStaticPathsOptions } from 'astro'; 
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const posts = Object.values(import.meta.glob('./*.md', { eager: true }));  
    const allPosts = Object.values(posts);
  
    const sortedPosts = allPosts.sort((a: any, b: any) => {
      const dateA = new Date(a.frontmatter?.date || 0).valueOf();
      const dateB = new Date(b.frontmatter?.date || 0).valueOf();
      return dateB - dateA;
  });

  return paginate(sortedPosts, { pageSize: 9 });
}

interface Props {
  page: Page<any>; 
}

const { page } = Astro.props;
---

<Layout title={`Diario de Viaje - Página ${page.currentPage}`} description="Explorá nuestro diario de viaje. Una colección de crónicas honestas, relatos de ruta, guías prácticas y fotografías inspiradoras de nuestras aventuras por el mundo." isTransparentHeader={true}>  
  <Hero 
    title="Diario de Viaje" 
    description="Todas nuestras crónicas, guías y relatos en un solo lugar."
    bgImage="/img/Paisajes/pekin_park_flowers_temple.webp" 
    loading="eager" 
    fetchpriority="high"
  />

  <main class="bc-main-wrapper">
    <div class="bc-section-inner" style="padding: 0 2rem;">
        
        <!-- GRILLA EDITORIAL -->
        <div class="bc-featured-grid" style="margin-top: 3rem;">
            {page.data.map((post: any) => {
                const imgSrc = post.frontmatter.main_image || 'https://images.unsplash.com/photo-1528181304800-259b08848526?q=80&w=1000&auto=format&fit=crop';
                const dateObj = new Date(post.frontmatter.date);
                const formattedDate = !isNaN(dateObj.getTime()) ? dateObj.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }) : '';

                return (
                    <a href={post.url} class="bc-featured-card">
                        <div class="bc-featured-img-wrap">
                            <img src={imgSrc} alt={post.frontmatter.title} class="bc-featured-img" />
                        </div>
                        <div class="bc-featured-content">
                            <div class="bc-featured-meta">
                                <div class="bc-featured-tags">
                                    {post.frontmatter.tag && (
                                        <span class="bc-tag">{post.frontmatter.tag}</span>
                                    )}
                                    {post.frontmatter.pais && (
                                        <span class="bc-tag">{post.frontmatter.pais}</span>
                                    )}
                                </div>
                                <span class="bc-date">{formattedDate}</span>
                            </div>
                            
                            <h3 class="bc-featured-title">{post.frontmatter.title}</h3>
                            <p class="bc-featured-excerpt">{post.frontmatter.description || "Nueva entrada en nuestro diario de viaje..."}</p>
                            <span class="bc-read-more">LEER MÁS &rarr;</span>
                        </div>
                    </a>
                );
            })}
        </div>

        <!-- PAGINACIÓN -->
        <div class="paginacion-container">
          {page.url.prev ? (
            <a href={page.url.prev} class="bc-btn-outline">&larr; Más recientes</a>
          ) : (
            <span class="bc-btn-outline disabled">&larr; Más recientes</span>
          )}

          <span class="paginacion-info">
            Página {page.currentPage} de {page.lastPage}
          </span>

          {page.url.next ? (
            <a href={page.url.next} class="bc-btn-outline">Más antiguos &rarr;</a>
          ) : (
            <span class="bc-btn-outline disabled">Más antiguos &rarr;</span>
          )}
        </div>

    </div>
  </main>
</Layout>

<style is:global>
    /* ============================================================
       ESTRUCTURA GENERAL
       ============================================================ */
    .bc-main-wrapper { display: block !important; width: 100% !important; margin: 0 !important; padding: 0 0 6rem 0 !important; box-sizing: border-box !important; }
    .bc-section-inner { max-width: 1200px !important; margin: 0 auto !important; width: 100% !important; }

    /* ============================================================
       GRID: ARTÍCULOS DESTACADOS (Estilo Editorial)
       ============================================================ */
    .bc-featured-grid { display: grid !important; grid-template-columns: repeat(3, 1fr) !important; gap: 2.5rem !important; width: 100% !important; }
    
    .bc-featured-card { 
        background: #ffffff !important; border-radius: 16px !important; overflow: hidden !important; 
        display: flex !important; flex-direction: column !important; text-decoration: none !important; 
        color: inherit !important; transition: transform 0.3s ease, box-shadow 0.3s ease !important; 
        border: 1px solid var(--c-border) !important;
    }
    .bc-featured-card:hover { transform: translateY(-5px) !important; box-shadow: 0 12px 24px rgba(0,0,0,0.05) !important; }
    
    .bc-featured-img-wrap { width: 100% !important; aspect-ratio: 16/10 !important; overflow: hidden !important; margin-bottom: 0 !important; border-radius: 0 !important; }
    .bc-featured-img { width: 100% !important; height: 100% !important; object-fit: cover !important; transition: transform 0.5s ease !important; }
    .bc-featured-card:hover .bc-featured-img { transform: scale(1.05) !important; }
    
    .bc-featured-content { padding: 2rem !important; display: flex !important; flex-direction: column !important; flex-grow: 1 !important; }
    
    .bc-featured-meta { 
        display: flex !important; 
        flex-direction: column !important; 
        align-items: flex-start !important; /* Asegura que todo se alinee a la izquierda */
        gap: 0.8rem !important; 
        margin-bottom: 1rem !important; 
    }
    
    .bc-featured-tags { 
        display: flex !important; 
        flex-wrap: wrap !important; 
        gap: 0.5rem !important; 
        justify-content: flex-start !important; /* Alinea las cápsulas a la izquierda */
    }
    
    .bc-tag { 
        font-family: var(--font-main, sans-serif) !important;
        border: 1px solid #006d77 !important; /* Color de borde fijo para asegurar visibilidad */
        color: #006d77 !important; 
        padding: 0.2rem 0.8rem !important; /* Padding horizontal más amplio para forma de cápsula */
        border-radius: 50px !important; /* Bordes totalmente redondeados */
        font-size: 0.7rem !important; 
        text-transform: uppercase !important; 
        letter-spacing: 0.05em !important; 
        font-weight: 700 !important; 
        margin: 0 !important;
        display: inline-block !important; /* Asegura que respete el padding y los bordes */
    }
    
    .bc-date { font-family: var(--font-main, sans-serif) !important; font-size: 0.75rem !important; color: var(--c-text-muted) !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; margin: 0 !important; }
    
    .bc-featured-title { font-family: var(--font-display, 'Georgia', serif) !important; font-size: 1.5rem !important; line-height: 1.3 !important; color: var(--c-text-main) !important; margin: 0 0 1rem 0 !important; font-weight: normal !important; }
    
    .bc-featured-excerpt { 
        font-family: var(--font-main, sans-serif) !important; 
        font-size: 1rem !important; 
        line-height: 1.6 !important; 
        color: var(--c-text-muted) !important; 
        margin: 0 0 1.5rem 0 !important; 
        display: -webkit-box !important; 
        -webkit-line-clamp: 3 !important; 
        -webkit-box-orient: vertical !important; 
        overflow: hidden !important; 
        flex-grow: 1 !important;
    }
    
    .bc-read-more { font-family: var(--font-main, sans-serif) !important; font-size: 0.85rem !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; color: var(--c-text-main) !important; margin-top: auto !important; }

    @media (max-width: 950px) { .bc-featured-grid { grid-template-columns: repeat(2, 1fr) !important; } }
    @media (max-width: 768px) { 
        .bc-featured-grid { grid-template-columns: 1fr !important; } 
        .bc-section-inner { padding: 0 1.25rem !important; }
    }

    /* ============================================================
       PAGINACIÓN
       ============================================================ */
    .paginacion-container { display: flex; justify-content: center; align-items: center; gap: 2rem; margin-top: 5rem !important; width: 100%; clear: both; }
    .paginacion-info { font-family: var(--font-main, sans-serif); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--c-text-muted); font-weight: 700; }
    
    .bc-btn-outline.disabled {
        border-color: #e2e8f0 !important;
        color: #94a3b8 !important;
        pointer-events: none;
        background-color: transparent !important;
    }

    @media (max-width: 600px) {
        .paginacion-container { flex-direction: column; gap: 1.5rem; margin-top: 4rem !important; }
    }
</style>