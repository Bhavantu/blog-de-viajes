---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths({ paginate }) {
    const postsRaw = import.meta.glob('./*.md', { eager: true });
    const posts = Object.values(postsRaw);
    
    posts.sort((a, b) => {
        const dateA = new Date(a.frontmatter?.date || 0).valueOf();
        const dateB = new Date(b.frontmatter?.date || 0).valueOf();
        return dateB - dateA;
    });

    return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<Layout title="Diario de Viaje | BLOGCITO">
    <header class="site-header">
        <h1><a href="/">BLOGCITO</a></h1>
        <button id="mobile-menu-btn" class="menu-toggle">☰</button>
        <nav id="main-nav">
            <ul class="nav-links">
                <li><a href="/">Inicio</a></li>
                <li><a href="/diario" class="active-link">Diario</a></li>
                <li><a href="/galeria">Galería</a></li>
                <li><a href="/nosotros">Nosotros</a></li>
            </ul>
        </nav>
    </header>

    <main class="container">
        
        <div id="journal-list">
            {page.data.map((post: any) => (
                <article class="journal-entry reveal visible" style="display: flex; flex-direction: column; height: 100%;">
                    
                    {/* Imagen NO clickeable */}
                    {post.frontmatter.main_image && (
                        <img 
                            src={post.frontmatter.main_image} 
                            alt={`Portada de ${post.frontmatter.title}`} 
                            style="width: 100%; max-height: 350px; object-fit: cover; border-radius: 8px; margin-bottom: 1rem;"
                        />
                    )}

                    <div style="display: flex; flex-direction: column; align-items: flex-start;">
                        {post.frontmatter.tag && (
                            <span class="journal-tag" data-tag={post.frontmatter.tag.toLowerCase()}>
                                {post.frontmatter.tag}
                            </span>
                        )}
                        <span class="journal-date">
                            {new Date(post.frontmatter.date).toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase()}
                        </span>
                    </div>
                    
                    {/* TÍTULO CLICKEABLE CON HOVER AZUL */}
                    <h3 class="journal-title" style="margin-top: 0.5rem; line-height: 1.3;">
                        <a href={post.url} class="hover-azul" style="text-decoration: none; color: inherit; transition: color 0.3s ease;">
                            {post.frontmatter.title}
                        </a>
                    </h3>
                    
                    <p class="journal-body" style="flex-grow: 1; margin-bottom: 1.5rem;">
                        {post.frontmatter.description || "Nueva entrada en nuestro diario de viaje..."}
                    </p>

                    {/* LEER MÁS AL FONDO */}
                    <div style="margin-top: auto;">
                        <a href={post.url} class="hover-azul" style="display: inline-block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-color, #333); text-decoration: none; font-weight: 500; transition: color 0.3s ease;">
                            Leer más &rarr;
                        </a>
                    </div>
                    
                </article>
            ))}
        </div>

        <div style="display: flex; justify-content: center; align-items: center; gap: 2rem; margin-top: 5rem; margin-bottom: 3rem;">
            {page.url.prev ? (
                <a href={page.url.prev} style="padding: 10px 20px; border: 1px solid var(--text-color, #333); border-radius: 8px; text-decoration: none; color: inherit; font-size: 0.9rem; text-transform: uppercase;">
                    ← Más recientes
                </a>
            ) : (
                <span style="padding: 10px 20px; border: 1px solid transparent; color: transparent; pointer-events: none;">← Más recientes</span>
            )}
            
            <span style="font-size: 0.95rem; color: #666;">
                Página {page.currentPage} de {page.lastPage}
            </span>

            {page.url.next ? (
                <a href={page.url.next} style="padding: 10px 20px; border: 1px solid var(--text-color, #333); border-radius: 8px; text-decoration: none; color: inherit; font-size: 0.9rem; text-transform: uppercase;">
                    Más antiguas →
                </a>
            ) : (
                <span style="padding: 10px 20px; border: 1px solid transparent; color: transparent; pointer-events: none;">Más antiguas →</span>
            )}
        </div>
        
    </main>
</Layout>