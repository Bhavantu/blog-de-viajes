---
import type { Page, GetStaticPathsOptions } from 'astro'; 
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const posts = Object.values(import.meta.glob('./*.md', { eager: true }));  
    const allPosts = Object.values(posts);
  
    const sortedPosts = allPosts.sort((a: any, b: any) => {
      const dateA = new Date(a.frontmatter?.date || 0).valueOf();
      const dateB = new Date(b.frontmatter?.date || 0).valueOf();
      return dateB - dateA;
  });

  return paginate(sortedPosts, { pageSize: 9 });
}

interface Props {
  page: Page<any>; 
}

const { page } = Astro.props;
---

<Layout title={`Diario de Viaje - Página ${page.currentPage}`} description="Explorá nuestro diario de viaje. Una colección de crónicas honestas, relatos de ruta, guías prácticas y fotografías inspiradoras de nuestras aventuras por el mundo." isTransparentHeader={true}>  
  <Hero 
    title="Diario de Viaje" 
    description="Todas nuestras crónicas, guías y relatos en un solo lugar."
    bgImage="/img/Paisajes/pekin_park_flowers_temple.webp" 
    loading="eager" 
    fetchpriority="high"
  />

  <main class="container">
    
    <!-- GRILLA -->
    <div id="grilla-portada-segura">
        {page.data.map((post: any) => (
            <article class="tarjeta-portada reveal visible">
                
                {post.frontmatter.main_image && (
                    <a href={post.url}>
                        <img 
                            src={post.frontmatter.main_image} 
                            alt={`Portada de ${post.frontmatter.title}`} 
                            class="img-portada"
                        />
                    </a>
                )}

                <div class="meta-portada">
                    {post.frontmatter.tag && (
                        <span class="journal-tag" data-tag={post.frontmatter.tag.toLowerCase()}>
                            {post.frontmatter.tag}
                        </span>
                    )}
                    <span class="journal-date">
                        {new Date(post.frontmatter.date).toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase()}
                    </span>
                </div>
                
                <h3 class="titulo-portada">
                    <a href={post.url} class="hover-verde">
                        {post.frontmatter.title}
                    </a>
                </h3>
                
                <p class="desc-portada">
                    {post.frontmatter.description || "Nueva entrada en nuestro diario de viaje..."}
                </p>

                <div class="btn-leer-mas-portada">
                    <a href={post.url} class="hover-verde">
                        Leer más &rarr;
                    </a>
                </div>
                
            </article>
        ))}
    </div>

    <!-- PAGINACIÓN -->
    <div class="paginacion-container">
      {page.url.prev ? (
        <a href={page.url.prev} class="btn-paginacion">&larr; Más recientes</a>
      ) : (
        <span class="btn-paginacion disabled">&larr; Más recientes</span>
      )}

      <span class="paginacion-info">
        Página {page.currentPage} de {page.lastPage}
      </span>

      {page.url.next ? (
        <a href={page.url.next} class="btn-paginacion">Más antiguos &rarr;</a>
      ) : (
        <span class="btn-paginacion disabled">Más antiguos &rarr;</span>
      )}
    </div>

  </main>
</Layout>

<style is:global>

        main.container {
        max-width: 1200px !important;
    }
    /* 1. ESTILOS DE GRILLA (DISEÑO EDITORIAL BLANCO Y RECTO) */
    #grilla-portada-segura { display: grid !important; grid-template-columns: repeat(3, 1fr) !important; gap: 2.5rem !important; width: 100% !important; align-items: stretch !important; margin-top: 3rem; }
    
    .tarjeta-portada { 
        display: flex !important; flex-direction: column !important; height: 100% !important; min-width: 0 !important; margin: 0 !important; padding: 0 !important; border: none !important; max-width: 100% !important; 
        /* Fondo blanco, bordes rectos y sombra sutil */
        background-color: #ffffff !important; 
        border-radius: 0 !important; 
        box-shadow: 0 4px 10px rgba(0,0,0,0.03) !important; 
    }
    
    .img-portada { 
        width: 100% !important; height: 220px !important; object-fit: cover !important; margin-bottom: 1.5rem !important; display: block !important; transition: transform 0.4s ease !important; 
        /* Bordes rectos para la imagen */
        border-radius: 0 !important; 
    }
    .img-portada:hover { transform: scale(1.02) !important; }

    /* Padding interno para que los textos respiren dentro de la caja blanca */
    .meta-portada, .titulo-portada, .desc-portada, .btn-leer-mas-portada {
        padding-left: 1.5rem !important;
        padding-right: 1.5rem !important;
    }

    .meta-portada { display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 0.5rem; }
    .titulo-portada { margin: 0.5rem 0; line-height: 1.3; font-family: var(--font-display); font-size: 1.5rem; }
    .titulo-portada a { text-decoration: none; color: var(--text-color, #333); transition: color 0.3s ease; }
    .desc-portada { flex-grow: 1; margin-bottom: 1.5rem; line-height: 1.6; font-size: 0.95rem; color: #555; }
    
    /* Padding inferior al botón para cerrar la caja blanca prolijo */
    .btn-leer-mas-portada { margin-top: auto; padding-bottom: 2rem !important; }
    .btn-leer-mas-portada a { display: inline-block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-color, #333); text-decoration: none; font-weight: 500; transition: color 0.3s ease; }

    /* 2. HOVER VERDE ESMERALDA */
    .hover-verde { transition: color 0.3s ease !important; }
    .hover-verde:hover { color: #006d77 !important; }

    /* 3. ESTILOS DE PAGINACIÓN */
    .paginacion-container { display: flex; justify-content: center; align-items: center; gap: 2rem; margin-top: 7rem !important; margin-bottom: 4rem; width: 100%; clear: both; }
    .btn-paginacion { display: inline-block; padding: 10px 20px; border: 1px solid var(--text-color, #333); border-radius: 6px; text-decoration: none; color: var(--text-color, #333); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; transition: all 0.3s ease; background-color: transparent; }
    .btn-paginacion:hover { background-color: #006d77 !important; border-color: #006d77 !important; color: #ffffff !important; }
    .btn-paginacion.disabled { border-color: #ccc !important; color: #aaa !important; cursor: not-allowed; }
    .btn-paginacion.disabled:hover { background-color: transparent !important; color: #aaa !important; border-color: #ccc !important; }
    .paginacion-info { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: #555; font-weight: 500; }

    /* 4. RESPONSIVE */
    @media (max-width: 800px) {
        #grilla-portada-segura { grid-template-columns: 1fr !important; gap: 4rem !important; }
        .img-portada { height: auto !important; max-height: 350px !important; }
    }
    @media (max-width: 600px) {
        .paginacion-container { flex-direction: column; gap: 1.5rem; margin-top: 5rem !important; }
    }
</style>