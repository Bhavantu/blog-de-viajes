---
import Layout from '../../layouts/Layout.astro';

const posteosRaw = import.meta.glob('./*.md', { eager: true });
const posteos = Object.values(posteosRaw);
posteos.sort((a, b) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date));
---

<Layout title="Diario de Viaje | BLOGCITO">
    <header>
        <h1><a href="/">BLOGCITO</a></h1>
        <nav>
            <ul>
                <li><a href="/">Galería</a></li>
                <li><a href="/diario" class="active-link">Diario</a></li>
                <li><a href="/#sobre-mi">Sobre mí</a></li>
            </ul>
        </nav>
    </header>

    <main class="container">
        <div id="journal-list">
            {posteos.map((post: any) => (
                <article class="journal-entry reveal visible">
                    <span class="journal-date">
                        {new Date(post.frontmatter.date).toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase()}
                    </span>
                    <h3 class="journal-title">{post.frontmatter.title}</h3>
                    <p class="journal-body">
                        {post.frontmatter.description || "Nueva entrada en nuestro diario de viaje..."}
                    </p>
                    <a href={post.url} class="read-more">Leer reflexión</a>
                </article>
            ))}
        </div>
    </main>

    <footer><p>&copy; 2026 BLOGCITO.</p></footer>
</Layout>