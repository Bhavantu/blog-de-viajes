---
import '../styles/global.css';
import Header from '../components/Header.astro';
import PostsRecomendados from '../components/PostsRecomendados.astro';
import { ui } from '../i18n/ui.js';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
    title: string;
    description?: string;
    isTransparentHeader?: boolean;
    frontmatter?: any;
}

const currentLang = Astro.currentLocale || 'es';

// ==========================================
// LÓGICA DE BÚSQUEDA (Bilingüe + Imágenes)
// ==========================================
const postsEs = import.meta.glob('../pages/diario/*.md', { eager: true });
const postsEn = import.meta.glob('../pages/en/journal/*.md', { eager: true });
const activePosts = currentLang === 'en' ? postsEn : postsEs;

const searchData = Object.values(activePosts).map((post: any) => ({
    title: post.frontmatter.title || '',
    description: post.frontmatter.description || '',
    content: typeof post.rawContent === 'function' ? post.rawContent().toLowerCase() : '',
    url: post.url,
    image: post.frontmatter.main_image || ''
}));
// ==========================================

const { title, description, isTransparentHeader = false, frontmatter } = Astro.props;

const paisToUse = frontmatter?.pais;
const metaDescription = description || "BLOGCITO - Bitácora de viaje, información útil y vida local alrededor del mundo.";
const isGaleria = Astro.url.pathname.includes('/galeria');

// ==========================================
// LÓGICA SEO INTERNACIONAL (CANONICAL Y HREFLANG)
// ==========================================
const sitioBase = 'https://blogcito.com';
let safePath = Astro.url.pathname;
if (safePath.endsWith('/') && safePath.length > 1) {
    safePath = safePath.slice(0, -1);
}
const urlCanonical = `${sitioBase}${safePath === '/' ? '' : safePath}`;
const cleanPath = safePath.startsWith('/en') ? safePath.replace(/^\/en/, '') : safePath;
const urlAlternativaEs = `${sitioBase}${cleanPath === '' ? '/' : cleanPath}`;
const urlAlternativaEn = `${sitioBase}/en${cleanPath === '' ? '' : cleanPath}`;
// ==========================================

const t = ui[currentLang as keyof typeof ui];
---
<!doctype html>
<html lang={currentLang}>
    <head>
        <meta charset="UTF-8" />

        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-37WGK8P699"></script>
        <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-37WGK8P699');
        </script>
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        
        <meta name="description" content={metaDescription} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:type" content="website" />

        <!-- Etiquetas SEO Internacional -->
        <link rel="canonical" href={urlCanonical} />
        <link rel="alternate" hreflang="es" href={urlAlternativaEs} />
        <link rel="alternate" hreflang="en" href={urlAlternativaEn} />
        <link rel="alternate" hreflang="x-default" href={urlAlternativaEs} />

        <meta name="google-adsense-account" content="ca-pub-3901046224634106">
       
        {isGaleria && <meta name="robots" content="noindex, nofollow" />}
        {!isGaleria && <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3901046224634106" crossorigin="anonymous"></script>}

        <script is:inline data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">        (function () {
            var script = document.createElement("script");
            script.async = 1;
            script.setAttribute("data-cmp-ab","2");
            script.src = 'https://emrldco.com/NTQzMjQ0.js?t=543244';
            document.head.appendChild(script);
        })();
        </script>

        <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

        <script type="application/ld+json" is:inline>
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "BLOGCITO",
            "url": "https://blogcito.com",
            "potentialAction": {
            "@type": "SearchAction",
            "target": "https://blogcito.com/?search={search_term_string}",
            "query-input": "required name=search_term_string"
            }
        }
        </script>
    </head>
    <body>
        <Header isTransparent={isTransparentHeader} frontmatter={frontmatter} />

        <slot />

        {paisToUse && (
            <div style="max-width: 1000px; margin: 0 auto; padding: 0 2rem 4rem 2rem; width: 100%;">
                <PostsRecomendados currentUrl={Astro.url.pathname} currentPais={paisToUse} lang={currentLang} />
            </div>
        )}

        <style is:global>
            /* ESTILOS ORIGINALES INTACTOS */
            :root {
                --bg-color: #f4f1ea;
                --text-color: #333;
                --accent-color: #888;
                --font-main: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                --font-display: 'Georgia', serif;
            }

            * { margin: 0; padding: 0; box-sizing: border-box; }
            
            body { font-family: var(--font-main); background-color: var(--bg-color); color: var(--text-color); line-height: 1.6; overflow-x: hidden; display: flex; flex-direction: column; min-height: 100vh; }
            
            a { text-decoration: none; color: inherit; transition: opacity 0.3s; }
            a:hover { opacity: 0.7; }

            .site-header { padding: 3rem 2rem 2rem; display: flex; justify-content: space-between; align-items: center; position: relative; max-width: 1000px; margin: 0 auto; width: 100%; }
            .site-header h1 { margin: 0; font-family: var(--font-display); font-size: 2.5rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: normal; }
            .site-header h1 a { text-decoration: none; color: inherit; }
            
            .menu-toggle { display: none; background: none; border: none; font-size: 2rem; cursor: pointer; color: var(--text-color); }
            
            nav ul.nav-links { list-style: none; display: flex; gap: 2rem; font-size: 0.9rem; margin: 0; padding: 0; }
            nav a { color: var(--accent-color); position: relative; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500; }
            nav a:hover, nav a.active-link { color: var(--text-color); }
            nav a.active-link::after { content: ''; position: absolute; width: 100%; height: 1px; bottom: -5px; left: 0; background-color: var(--text-color); }

            .hover-verde { transition: color 0.3s ease; }
            .hover-verde:hover { color: #006d77 !important; }

            @media (max-width: 768px) {
                .site-header { padding: 2rem; }
                .menu-toggle { display: block; position: relative; z-index: 1001; }
                .menu-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.6); z-index: 990; opacity: 0; pointer-events: none; transition: opacity 0.3s ease; }
                .menu-overlay.menu-open { opacity: 1; pointer-events: auto; }
                #main-nav { display: flex; flex-direction: column; position: fixed; top: 0; right: 0; width: 260px; height: 100vh; background-color: var(--bg-color); box-shadow: -5px 0 15px rgba(0,0,0,0.1); z-index: 1000; padding: 6rem 1.5rem 2rem; transform: translateX(100%); transition: transform 0.3s ease-in-out; text-align: center; }
                #main-nav.menu-open { transform: translateX(0); }
                nav ul.nav-links { flex-direction: column; gap: 2rem; align-items: center; }
                .header-wrapper.transparente #main-nav a, .header-wrapper.transparente #main-nav .btn-buscar svg, #main-nav a, #main-nav .btn-buscar svg { color: var(--text-color) !important; text-shadow: none !important; }
                .menu-toggle.menu-abierto { color: var(--text-color) !important; text-shadow: none !important; }
            }

            .container { max-width: 1000px; margin: 0 auto; padding: 2rem 2rem 6rem 2rem; width: 100%; flex-grow: 1; }
            @media (max-width: 768px) { .container { padding: 1rem 1rem 4rem 1rem; } }
            
            .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 4rem 2rem; }
            .image-wrapper { width: 100%; height: 400px; overflow: hidden; background-color: #eee; }
            .image-wrapper img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.8s ease; }
            .photo-info { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--accent-color); margin-top: 0.7rem; }
            .photo-title { color: var(--text-color); font-weight: 500; }

            .journal-entry { max-width: 700px; margin: 0 auto 5rem auto; border-bottom: 1px solid #eee; padding-bottom: 3rem; }
            .journal-date { font-size: 0.75rem; color: var(--accent-color); letter-spacing: 0.1em; display: block; margin-bottom: 0.5rem; }
            .journal-title { font-family: var(--font-display); font-size: 1.8rem; margin-bottom: 1rem; font-weight: normal; }
            .journal-body { font-size: 1.05rem; color: #555; margin-bottom: 1.5rem; }
            
            .journal-tag { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.15em; padding: 4px 12px; border-radius: 15px; display: inline-block; margin-bottom: 0.8rem; font-weight: 500; }
            .journal-tag[data-tag="bitacora"] { background-color: #fdf2e9; color: #af601a; border: 1px solid #fad7a0; }
            .journal-tag[data-tag="fotografia"] { background-color: #ebf5fb; color: #2874a6; border: 1px solid #aed6f1; }
            .journal-tag[data-tag="punto de fuga"] { background-color: #f5eef8; color: #6c3483; border: 1px solid #d7bde2; }
            .journal-tag[data-tag="vida local"] { background-color: #f4f1ea; color: #31824b; border: 1px solid #6fdf96; }
            .journal-tag[data-tag="data"] { background-color: #eaecee; color: #cbd661; border: 1px solid #ebf699; }
            .journal-tag[data-tag="guia de viaje"], .journal-tag[data-tag="guía de viaje"] { background-color: #e6fffa; color: #006d77; border: 1px solid #83c5be; }
            .journal-tag[data-tag="contexto y cultura"] { background-color: #fff5f5; color: #9b2c2c; border: 1px solid #feb2b2; }

            .about-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
            @media (max-width: 768px) { .about-layout { grid-template-columns: 1fr; gap: 2rem; } }
            .about-img { width: 100%; height: auto; max-height: 650px; object-fit: cover; display: block; border-radius: 8px; }
            .about-text h2 { font-family: var(--font-display); font-size: 2rem; margin-bottom: 1.5rem; font-weight: normal; }

            .article-header { text-align: center; margin-bottom: 3rem; }
            .article-title-main { font-family: var(--font-display); font-size: 2.5rem; line-height: 1.2; font-weight: normal; margin-top: 1rem; }
            .back-btn { display: inline-block; margin-bottom: 2rem; font-size: 0.8rem; text-transform: uppercase; color: var(--accent-color); border-bottom: 1px solid transparent; cursor: pointer; }
            .back-btn:hover { border-bottom-color: var(--accent-color); }
            
            .text-column { max-width: 680px; margin: 0 auto; font-size: 1.1rem; color: #444; line-height: 1.8; }
            .text-column p { margin-bottom: 1.5rem; }
            .post-banner { max-width: 1000px; margin: 0 auto 3rem auto; width: 100%; }
            .post-banner { width: 100%; max-width: 100%; margin: 0 auto 2rem auto; padding: 0; }
            .post-banner img { width: 100% !important; height: auto !important; display: block; border-radius: 8px; margin: 0 auto; }
            .text-column blockquote { border-left: 4px solid #ddd; padding: 1.5rem 0 1.5rem 2rem; margin: 3.5rem 0; font-family: var(--font-display); font-size: 1.45rem; color: #222; font-style: italic; background-color: #f9f9f9; line-height: 1.5; }
            .text-column img { display: block; max-width: 100% !important; height: auto !important; margin: 2.5rem auto 0.5rem auto; object-fit: contain; }
            .text-column p:has(img:nth-of-type(2)) { display: block; column-count: 2; column-gap: 1rem; margin: 3rem 0; width: 100%; }
            @media (min-width: 950px) { .text-column p:has(img:nth-of-type(2)) { width: 900px; margin-left: -110px; } }
            @media (max-width: 600px) { .text-column p:has(img:nth-of-type(2)) { column-count: 1; width: 100%; margin-left: 0; } }
            .text-column p:has(img:nth-of-type(2)) img { margin: 0 0 1rem 0; width: 100%; height: auto !important; display: inline-block; object-fit: contain; }
            .img-caption { display: block; font-size: 0.78rem; color: var(--accent-color); text-align: center; margin-top: 0; margin-bottom: 2.5rem; line-height: 1.4; font-style: italic; }
            
            .reveal { opacity: 0; transform: translateY(20px); transition: all 0.8s ease-out; }
            .reveal.visible { opacity: 1; transform: translateY(0); }

            footer { width: 100%; text-align: center; padding: 4rem 2rem; font-size: 0.8rem; color: var(--accent-color); margin-top: auto; clear: both; }
            
            /* ESTILOS DEL BUSCADOR (SIN VARIABLES EXTERNAS) */
            .search-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 9999; justify-content: center; align-items: flex-start; padding-top: 15vh; backdrop-filter: blur(3px); }
            .search-modal.active { display: flex; }
            .search-container { background: #fff; width: 90%; max-width: 600px; border-radius: 12px; padding: 1.5rem; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
            .search-header { display: flex; gap: 1rem; margin-bottom: 1rem; border-bottom: 2px solid #eee; padding-bottom: 1rem; align-items: center; }
            #search-input { flex-grow: 1; padding: 10px; font-size: 1.2rem; border: none; outline: none; font-family: inherit; min-width: 0; width: 100%; }
            #close-search { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #999; transition: color 0.3s; flex-shrink: 0; }
            #close-search:hover { color: #333; }
            #search-results { max-height: 50vh; overflow-y: auto; }
            
            .search-result-item { display: flex; align-items: center; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid #f5f5f5; text-decoration: none; transition: background 0.3s; }
            .search-result-img { width: 64px; height: 64px; border-radius: 8px; object-fit: cover; flex-shrink: 0; }
            .search-result-text { flex-grow: 1; display: flex; flex-direction: column; gap: 4px; }
            .search-result-item h4 { margin: 0; color: #006d77; font-size: 1.1rem; }
            .search-result-item p { margin: 0; font-size: 0.9rem; color: #666; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
            .search-result-item:hover h4 { text-decoration: underline; }

            @media (max-width: 768px) {
                .search-container { width: 95%; padding: 1rem; }
                #search-input { font-size: 1rem; padding: 8px 5px; }
                .search-header { gap: 0.5rem; }
            }
        </style>

        <script is:inline>
            function initPlugins() {
                const oldMenuBtn = document.getElementById('mobile-menu-btn');
                const mainNav = document.getElementById('main-nav');
                if (oldMenuBtn && mainNav) {
                    const newMenuBtn = oldMenuBtn.cloneNode(true);
                    oldMenuBtn.replaceWith(newMenuBtn);
                    let overlay = document.getElementById('mobile-menu-overlay');
                    if (!overlay) {
                        overlay = document.createElement('div');
                        overlay.id = 'mobile-menu-overlay';
                        overlay.className = 'menu-overlay';
                        mainNav.parentNode.insertBefore(overlay, mainNav);
                    }
                    const closeMenu = () => { mainNav.classList.remove('menu-open'); overlay.classList.remove('menu-open'); newMenuBtn.classList.remove('menu-abierto'); newMenuBtn.innerHTML = '☰'; document.body.style.overflow = ''; };
                    const openMenu = () => { mainNav.classList.add('menu-open'); overlay.classList.add('menu-open'); newMenuBtn.classList.add('menu-abierto'); newMenuBtn.innerHTML = '✕'; document.body.style.overflow = 'hidden'; };
                    newMenuBtn.addEventListener('click', (e) => { e.stopPropagation(); if (mainNav.classList.contains('menu-open')) closeMenu(); else openMenu(); });
                    overlay.addEventListener('click', closeMenu);
                    mainNav.querySelectorAll('a').forEach(link => { link.addEventListener('click', closeMenu); });
                }
                const observer = new IntersectionObserver((entries) => { entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); }); }, { threshold: 0.1 });
                document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
            }
            document.addEventListener('DOMContentLoaded', initPlugins);
            document.addEventListener('astro:after-swap', initPlugins);
        </script>
        
        <footer>
            <p>&copy; 2026 BLOGCITO. {t['footer.derechos']}</p>
            <p style="max-width: 650px; margin: 1.2rem auto; font-size: 0.8rem; line-height: 1.5; color: #555555; text-align: center;">
            {t['footer.afiliados']}
            </p>
            <div style="margin-top: 10px; font-size: 0.9em;">
                <a href={t['route.privacidad']} style="margin-right: 15px;">{t['footer.privacidad']}</a>
                <a href={t['route.contacto']}>{t['footer.contacto']}</a>            
            </div>
        </footer>

        <div id="search-modal" class="search-modal">
            <div class="search-container">
                <div class="search-header">
                    <input type="text" id="search-input" placeholder={t['search.placeholder']} autocomplete="off" />
                    <button id="close-search">✕</button>
                </div>
                <div id="search-results">
                    <p style="color:#777; font-size:0.9rem;">{t['search.short']}</p>
                </div>
            </div>
        </div>

        <script define:vars={{ searchData, msgShort: t['search.short'], msgEmpty: t['search.empty'], currentLang }}>        
        document.addEventListener('DOMContentLoaded', () => {
            const btnsBuscar = document.querySelectorAll('.btn-buscar');
            const modal = document.getElementById('search-modal');
            const closeBtn = document.getElementById('close-search');
            const input = document.getElementById('search-input');
            const results = document.getElementById('search-results');

            btnsBuscar.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    modal.classList.add('active');
                    input.focus();
                });
            });

            closeBtn.addEventListener('click', () => modal.classList.remove('active'));
            modal.addEventListener('click', (e) => {
                if (e.target === modal) modal.classList.remove('active');
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const query = e.target.value.trim();
                    if (query.length >= 2) {
                        const searchUrl = currentLang === 'en' 
                            ? `/en/search?q=${encodeURIComponent(query)}` 
                            : `/search?q=${encodeURIComponent(query)}`;
                        window.location.href = searchUrl;
                    }
                }
            });

            input.addEventListener('input', (e) => {
                const query = e.target.value.toLowerCase();
                if (query.length < 2) {
                    results.innerHTML = `<p style="color:#777; font-size:0.9rem;">${msgShort}</p>`;
                    return;
                }
                const filtered = searchData.filter(post => 
                    post.title.toLowerCase().includes(query) || 
                    post.description.toLowerCase().includes(query) ||
                    (post.content && post.content.includes(query))
                );
                if (filtered.length === 0) {
                    results.innerHTML = `<p style="color:#777;">${msgEmpty}</p>`;
                    return;
                }
                results.innerHTML = filtered.map(post => `
                    <a href="${post.url}" class="search-result-item">
                        ${post.image ? `<img src="${post.image}" alt="" class="search-result-img" />` : ''}
                        <div class="search-result-text">
                            <h4>${post.title}</h4>
                            <p>${post.description}</p>
                        </div>
                    </a>
                `).join('');
            });
        });
        </script>
    </body>
</html>