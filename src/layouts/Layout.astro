---
interface Props {
    title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="BLOGCITO - Bitácora de viaje" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    </head>
    <body>
        <slot />

        <div id="lightbox">
            <span class="close-lightbox">&times;</span>
            <span class="lightbox-btn prev-btn">&#10094;</span>
            <span class="lightbox-btn next-btn">&#10095;</span>
            <img id="lightbox-img" src="" alt="Imagen ampliada">
        </div>

        <style is:global>
            :root {
                --bg-color: #fcfcfc;
                --text-color: #333;
                --accent-color: #888;
                --font-main: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                --font-display: 'Georgia', serif;
            }

            * { margin: 0; padding: 0; box-sizing: border-box; }
            
            body { 
                font-family: var(--font-main); 
                background-color: var(--bg-color); 
                color: var(--text-color); 
                line-height: 1.6;
                overflow-x: hidden; 
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }
            body.no-scroll { overflow: hidden; }
            a { text-decoration: none; color: inherit; transition: opacity 0.3s; }
            a:hover { opacity: 0.7; }

            header { padding: 4rem 2rem 2rem; text-align: center; width: 100%; }
            h1 { font-family: var(--font-display); font-size: 2.5rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: normal; }
            
            nav ul { list-style: none; display: flex; justify-content: center; gap: 2rem; font-size: 0.9rem; }
            nav a { color: var(--accent-color); position: relative; }
            nav a:hover, nav a.active-link { color: var(--text-color); }
            nav a.active-link::after { content: ''; position: absolute; width: 100%; height: 1px; bottom: -5px; left: 0; background-color: var(--text-color); }

            .container { max-width: 1000px; margin: 0 auto; padding: 2rem 2rem 6rem 2rem; width: 100%; flex-grow: 1; }
            .section-content { display: none; }
            .section-content.active-section { display: block; }

            /* GALERÍA */
            .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 4rem 2rem; }
            .image-wrapper { width: 100%; height: 400px; overflow: hidden; background-color: #eee; }
            .image-wrapper img { width: 100%; height: 100%; object-fit: cover; display: block; cursor: pointer; transition: transform 0.8s ease; }
            .image-wrapper:hover img { transform: scale(1.03); }
            .photo-info { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--accent-color); margin-top: 0.7rem; }
            .photo-title { color: var(--text-color); font-weight: 500; }

            /* DIARIO */
            .journal-entry { max-width: 700px; margin: 0 auto 5rem auto; border-bottom: 1px solid #eee; padding-bottom: 3rem; }
            .journal-date { font-size: 0.75rem; color: var(--accent-color); letter-spacing: 0.1em; display: block; margin-bottom: 0.5rem; }
            .journal-title { font-family: var(--font-display); font-size: 1.8rem; margin-bottom: 1rem; font-weight: normal; }
            .journal-body { font-size: 1.05rem; color: #555; margin-bottom: 1.5rem; }
            .read-more { font-size: 0.8rem; text-transform: uppercase; border-bottom: 1px solid var(--text-color); padding-bottom: 2px; cursor: pointer; }

            /* ETIQUETAS (COLORES PASTELES) */
            .journal-tag { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.15em; padding: 4px 12px; border-radius: 15px; display: inline-block; margin-bottom: 0.8rem; font-weight: 500; }
            .journal-tag[data-tag="bitacora"] { background-color: #fdf2e9; color: #af601a; border: 1px solid #fad7a0; }
            .journal-tag[data-tag="fotografia"] { background-color: #ebf5fb; color: #2874a6; border: 1px solid #aed6f1; }
            .journal-tag[data-tag="punto de fuga"] { background-color: #f5eef8; color: #6c3483; border: 1px solid #d7bde2; }

            /* NOSOTROS */
            .about-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
            @media (max-width: 768px) { .about-layout { grid-template-columns: 1fr; gap: 2rem; } }
            .about-img { width: 100%; height: auto; max-height: 650px; object-fit: cover; filter: grayscale(100%); transition: filter 0.5s; display: block; }
            @media (max-width: 768px) { .about-img { max-height: 400px; } }
            .about-img:hover { filter: grayscale(0%); }
            .about-text h2 { font-family: var(--font-display); font-size: 2rem; margin-bottom: 1.5rem; font-weight: normal; }

            /* ARTÍCULOS */
            .article-header { text-align: center; margin-bottom: 3rem; }
            .article-title-main { font-family: var(--font-display); font-size: 2.5rem; line-height: 1.2; font-weight: normal; margin-top: 1rem; }
            .back-btn { display: inline-block; margin-bottom: 2rem; font-size: 0.8rem; text-transform: uppercase; color: var(--accent-color); border-bottom: 1px solid transparent; cursor: pointer; }
            .back-btn:hover { border-bottom-color: var(--accent-color); }
            
            .text-column { max-width: 680px; margin: 0 auto; font-size: 1.1rem; color: #444; line-height: 1.8; }
            .text-column p { margin-bottom: 1.5rem; }

            .post-banner { max-width: 1000px; margin: 0 auto 3rem auto; width: 100%; }
            .post-banner img { width: 100%; height: 450px; object-fit: cover; display: block; }

            /* Grid Pinterest para imágenes base Markdown */
            .text-column p:has(img:nth-of-type(2)) { display: block; column-count: 2; column-gap: 1rem; margin: 3rem 0; width: 100%; }
            @media (min-width: 950px) { .text-column p:has(img:nth-of-type(2)) { width: 900px; margin-left: -110px; } }
            @media (max-width: 600px) { .text-column p:has(img:nth-of-type(2)) { column-count: 1; width: 100%; margin-left: 0; } }
            .text-column p:has(img:nth-of-type(2)) img { margin: 0 0 1rem 0; width: 100%; height: auto; display: inline-block; object-fit: contain; }

            .text-column blockquote { border-left: 4px solid #ddd; padding: 1.5rem 0 1.5rem 2rem; margin: 3.5rem 0; font-family: var(--font-display); font-size: 1.45rem; color: #222; font-style: italic; background-color: #f9f9f9; line-height: 1.5; }
            .text-column blockquote p { margin-bottom: 0; }

            /* --- NUEVOS ESTILOS PARA LOS COMPONENTES DEL CMS --- */
            
            /* Soporte para Imágenes Ajustables */
            .text-column .post-img-box { display: block; margin: 2rem 0; clear: both; }
            .text-column .post-img-box img { width: 100%; height: auto; margin: 0; cursor: pointer; }
            .img-pequeño { max-width: 250px; }
            .img-mediano { max-width: 450px; }
            .img-completo { max-width: 100%; }
            .img-izquierda { float: left; margin: 0.5rem 1.5rem 1rem 0 !important; }
            .img-derecha { float: right; margin: 0.5rem 0 1rem 1.5rem !important; }
            .img-centro { margin: 2.5rem auto !important; }
            .text-column::after { content: ""; display: table; clear: both; } /* Limpia los floats */

            /* Colores de Texto */
            .txt-color-marron { color: #af601a; font-weight: 500; }
            .txt-color-azul { color: #2874a6; font-weight: 500; }
            .txt-color-violeta { color: #6c3483; font-weight: 500; }

            /* --------------------------------------------------- */

            footer { width: 100%; text-align: center; padding: 4rem 2rem; font-size: 0.8rem; color: var(--accent-color); margin-top: auto; clear: both; }

            #lightbox { position: fixed; z-index: 1000; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.96); display: flex; justify-content: center; align-items: center; opacity: 0; pointer-events: none; transition: opacity 0.4s; }
            #lightbox.active { opacity: 1; pointer-events: auto; }
            #lightbox-img { max-width: 85%; max-height: 85vh; object-fit: contain; box-shadow: 0 0 30px rgba(0,0,0,0.5); }
            .close-lightbox { position: absolute; top: 20px; right: 30px; font-size: 40px; color: #fff; cursor: pointer; z-index: 1001; font-weight: 100; }
            .lightbox-btn { position: absolute; top: 50%; transform: translateY(-50%); font-size: 2.5rem; color: #fff; cursor: pointer; user-select: none; padding: 2rem; z-index: 1001; opacity: 0.4; transition: opacity 0.3s; }
            .lightbox-btn:hover { opacity: 1; }
            .prev-btn { left: 0; }
            .next-btn { right: 0; }
            .reveal { opacity: 0; transform: translateY(20px); transition: all 0.8s ease-out; }
            .reveal.visible { opacity: 1; transform: translateY(0); }
        </style>

        <script is:inline>
            let currentImgIndex = 0;
            let imagesArray = [];

            function initPlugins() {
                const lightbox = document.getElementById('lightbox');
                const lightboxImg = document.getElementById('lightbox-img');
                const domImages = document.querySelectorAll('img:not(#lightbox-img)');
                
                imagesArray = [];
                domImages.forEach((img, index) => {
                    imagesArray.push(img.src);
                    img.onclick = (e) => {
                        currentImgIndex = index;
                        updateLightbox();
                        lightbox.classList.add('active');
                        document.body.classList.add('no-scroll');
                    };
                });

                function updateLightbox() {
                    if(imagesArray.length > 0) {
                        lightboxImg.src = imagesArray[currentImgIndex];
                    }
                }

                document.querySelector('.next-btn').onclick = (e) => {
                    e.stopPropagation();
                    currentImgIndex = (currentImgIndex + 1) % imagesArray.length;
                    updateLightbox();
                };

                document.querySelector('.prev-btn').onclick = (e) => {
                    e.stopPropagation();
                    currentImgIndex = (currentImgIndex - 1 + imagesArray.length) % imagesArray.length;
                    updateLightbox();
                };

                lightbox.onclick = (e) => {
                    if (e.target.id === 'lightbox' || e.target.classList.contains('close-lightbox')) {
                        lightbox.classList.remove('active');
                        document.body.classList.remove('no-scroll');
                    }
                };

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) entry.target.classList.add('visible');
                    });
                }, { threshold: 0.1 });

                document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
            }

            document.addEventListener('DOMContentLoaded', initPlugins);
            document.addEventListener('astro:after-swap', initPlugins);
        </script>
    </body>
</html>