---
interface Props {
    title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Morseros - Bitácora de viaje" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    </head>
    <body>
        <slot />

        <div id="lightbox">
            <span class="close-lightbox">&times;</span>
            <img id="lightbox-img" src="" alt="Imagen ampliada">
        </div>

        <style is:global>
            :root {
                --bg-color: #fcfcfc;
                --text-color: #333;
                --accent-color: #888;
                --font-main: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                --font-display: 'Georgia', serif;
            }

            * { margin: 0; padding: 0; box-sizing: border-box; }
            
            body { 
                font-family: var(--font-main); 
                background-color: var(--bg-color); 
                color: var(--text-color); 
                line-height: 1.6;
                overflow-x: hidden;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }
            body.no-scroll { overflow: hidden; }
            a { text-decoration: none; color: inherit; }

            header { padding: 4rem 2rem 2rem; text-align: center; width: 100%; }
            h1 { font-family: var(--font-display); font-size: 2.5rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: normal; }
            
            nav ul { list-style: none; display: flex; justify-content: center; gap: 2rem; font-size: 0.9rem; }
            nav a { color: var(--accent-color); position: relative; }
            nav a:hover, nav a.active-link { color: var(--text-color); }
            nav a.active-link::after { content: ''; position: absolute; width: 100%; height: 1px; bottom: -5px; left: 0; background-color: var(--text-color); }

            .container { 
                max-width: 1000px; 
                margin: 0 auto; 
                padding: 2rem 2rem 6rem 2rem; 
                width: 100%;
                flex-grow: 1; /* Esto empuja el footer al fondo si hay poco contenido */
            }
            .section-content { display: none; }
            .section-content.active-section { display: block; }

            /* --- GALERÍA (Se mantiene el fix de tamaño) --- */
            .photo-grid { 
                display: grid; 
                grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); 
                gap: 4rem 2rem; 
            }
            .image-wrapper { 
                width: 100%; 
                height: 400px; 
                overflow: hidden; 
                background-color: #eee; 
            }
            .image-wrapper img { 
                width: 100%; 
                height: 100%; 
                object-fit: cover; 
                display: block;
                cursor: pointer;
            }
            .photo-info { 
                display: flex; 
                justify-content: space-between; 
                font-size: 0.8rem; 
                color: var(--accent-color); 
                margin-top: 0.7rem;
            }

            /* --- ARTÍCULOS --- */
            .text-column { max-width: 680px; margin: 0 auto; font-size: 1.1rem; color: #444; }
            .text-column img { 
                display: block;
                max-width: 100%; 
                height: auto; 
                margin: 2.5rem auto; 
                cursor: pointer;
            }
            .article-header { text-align: center; margin-bottom: 3rem; }
            .article-title-main { font-family: var(--font-display); font-size: 2.5rem; line-height: 1.2; font-weight: normal; }
            .back-btn { display: inline-block; margin-bottom: 2rem; font-size: 0.8rem; text-transform: uppercase; color: var(--accent-color); }

            /* --- FOOTER (Arreglo de posición) --- */
            footer { 
                width: 100%;
                text-align: center; 
                padding: 4rem 2rem; 
                font-size: 0.8rem; 
                color: var(--accent-color); 
                margin-top: auto; /* Se asegura de estar siempre al final */
                clear: both;
            }

            /* Lightbox */
            #lightbox { position: fixed; z-index: 1000; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); display: flex; justify-content: center; align-items: center; opacity: 0; pointer-events: none; transition: opacity 0.4s; }
            #lightbox.active { opacity: 1; pointer-events: auto; }
            #lightbox-img { max-width: 90%; max-height: 90vh; object-fit: contain; }
            .close-lightbox { position: absolute; top: 20px; right: 30px; font-size: 40px; color: #fff; cursor: pointer; }

            /* Animaciones */
            .reveal { opacity: 0; transform: translateY(20px); transition: all 0.8s ease-out; }
            .reveal.visible { opacity: 1; transform: translateY(0); }
        </style>

        <script is:inline>
            function initPlugins() {
                const lightbox = document.getElementById('lightbox');
                const lightboxImg = document.getElementById('lightbox-img');
                const images = document.querySelectorAll('img');

                images.forEach(img => {
                    img.onclick = (e) => {
                        if (e.target.id === 'lightbox-img') return;
                        lightboxImg.src = e.target.src;
                        lightbox.classList.add('active');
                        document.body.classList.add('no-scroll');
                    };
                });

                lightbox.onclick = () => {
                    lightbox.classList.remove('active');
                    document.body.classList.remove('no-scroll');
                };
            }
            document.addEventListener('DOMContentLoaded', initPlugins);
            document.addEventListener('astro:after-swap', initPlugins);
        </script>
    </body>
</html>