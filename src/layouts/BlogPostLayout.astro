---
import Layout from './Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ui } from '../i18n/ui.js';

const { frontmatter, headings } = Astro.props;
const indices = headings ? headings.filter((h: any) => h.depth === 2 || h.depth === 3) : [];

// Atrapamos el idioma y cargamos las traducciones
const currentLang = Astro.currentLocale || 'es';
const t = ui[currentLang as keyof typeof ui];

// Definimos la carpeta de destino según el idioma
const carpetaDiario = currentLang === 'en' ? 'journal' : 'diario';
---

<Layout title={frontmatter.title} description={frontmatter.description}>
    <main class="container">
        <article class="article-view" style="display: block;">
            <a href={getRelativeLocaleUrl(currentLang, carpetaDiario)} class="back-btn hover-verde">← {t['post.volver']}</a>            
            <header class="article-header reveal visible">
                {frontmatter.tag && (
                    <span class="journal-tag" data-tag={frontmatter.tag.toLowerCase()}>
                        {frontmatter.tag}
                    </span>
                )}
                <span class="journal-date">
                {new Date(frontmatter.date).toLocaleDateString(currentLang === 'es' ? 'es-ES' : 'en-US', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase()}
                </span>
                <h1 class="article-title-main">{frontmatter.title}</h1>
            </header>

            {frontmatter.main_image && (
                <div class="post-banner reveal visible">
                    <img src={frontmatter.main_image} alt={frontmatter.title} />
                </div>
            )}

            <div class="text-column reveal visible">
                
                <!-- ÍNDICE DE CONTENIDOS -->
                {indices.length > 0 && (
                    <div class="indice-contenidos">
                        <p class="indice-titulo">En este artículo</p>
                        <ul class="indice-lista">
                            {indices.map((heading: any) => (
                                <li class={`indice-item nivel-${heading.depth}`}>
                                    <a href={`#${heading.slug}`}>
                                        {heading.text}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                )}
                
                <!-- TEXTO DEL ARTÍCULO -->
                <slot />
                
                <!-- Inyector automático del Widget de Stay22 -->
                {frontmatter.stay22_widget && (
                    <div class="stay22-widget-container" style="margin-top: 3rem; margin-bottom: 2rem;">
                        <iframe 
                            id="stay22-widget" 
                            width="100%" 
                            height="428" 
                            src={`https://stay22.com/embed/${frontmatter.stay22_widget}`} 
                            frameborder="0"
                            style="border-radius: 12px; overflow: hidden;"
                        ></iframe>
                    </div>
                )}
            </div>
        </article>
    </main>

    <!-- Script de Stay22 para links de afiliados -->
    <script is:inline>
      (function (s, t, a, y, twenty, two) {
        s.Stay22 = s.Stay22 || {};
        s.Stay22.params = { lmaID: '6a4493ddc151746f75b251a1' };
        twenty = t.createElement(a);
        two = t.getElementsByTagName(a)[0];
        twenty.async = 1;
        twenty.src = y;
        two.parentNode.insertBefore(twenty, two);
      })(window, document, 'script', 'https://scripts.stay22.com/letmeallez.js');
    </script>
</Layout>

<!-- ========================================== -->
<!-- ESTILOS EXCLUSIVOS PARA EL POST Y EL ÍNDICE-->
<!-- ========================================== -->
<style>

/* ============================================================
     GALERÍA EDITORIAL AUTOMÁTICA (Transforma listas de imágenes)
     ============================================================ */
  
  /* Detectamos si una lista común (ul) contiene imágenes adentro */
  .article-view ul:has(img) {
      display: flex !important;
      gap: 1.5rem !important;
      list-style: none !important; /* Borramos los puntitos de la lista */
      padding: 0 !important;       /* Quitamos el margen izquierdo nativo */
      margin: 2.5rem 0 !important;
      width: 100% !important;
  }

  /* Hacemos que cada elemento de la lista se reparta el espacio por igual */
  .article-view ul:has(img) li {
      flex: 1 !important;
      margin: 0 !important;
      padding: 0 !important;
  }

  /* Estilo estricto para las imágenes de la galería */
  .article-view ul:has(img) img {
      width: 100% !important;
      height: 380px !important; /* Altura fija simétrica */
      object-fit: cover !important; /* Evita deformaciones */
      border-radius: 0 !important;  /* Estilo recto revista */
      display: block !important;
      margin: 0 !important;
  }

  /* MODO CELULAR: Se rompe la fila y vuelven a ponerse en vertical */
  @media (max-width: 650px) {
      .article-view ul:has(img) {
          flex-direction: column !important;
          gap: 1rem !important;
      }
      .article-view ul:has(img) img {
          height: auto !important; /* En celu recuperan su proporción natural */
      }
  }
    /* ============================================================
     EFECTO "HOJA DE PAPEL" PARA EL ARTÍCULO
     ============================================================ */
  .article-view {
      background-color: #ffffff; /* Fondo blanco puro */
      padding: 4rem 5rem; /* Espaciado interno generoso para que respire */
      max-width: 950px; /* Ancho máximo de la hoja blanca */
      margin: 0 auto; /* Centramos la hoja en la pantalla */
      box-shadow: 0 10px 30px rgba(0,0,0,0.03); /* Sombra elegante para que "flote" sobre el arena */
      border-radius: 0; /* Bordes rectos para mantener el estilo editorial */
  }

  /* Ajuste de espaciado en la cabecera del artículo */
  .article-header {
      margin-bottom: 4rem;
  }

  /* Adaptación de la hoja blanca para celulares */
  @media (max-width: 768px) {
      .article-view {
          padding: 2.5rem 1.5rem;
      }
  }

  /* ============================================================
     ESTILOS PARA LOS TÍTULOS DEL MARKDOWN (H2, H3, H4)
     ============================================================ */
  .text-column :global(h2) {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: normal;
    color: var(--text-color, #333);
    margin-top: 3.5rem;
    margin-bottom: 1.2rem;
    line-height: 1.3;
  }

  .text-column :global(h3) {
    font-family: var(--font-main);
    font-size: 1.4rem;
    font-weight: 700;
    color: #444;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  .text-column :global(h4) {
    font-size: 1.15rem;
    font-weight: 700;
    color: #555;
    margin-top: 2rem;
    margin-bottom: 0.8rem;
  }
  
  .text-column :global(p) {
    margin-bottom: 1.5rem;
  }  

  .text-column :global(a:not(.hover-verde):not(.indice-item a)) {
    color: #333 !important;
    text-decoration: underline !important; 
    text-decoration-color: #ccc !important;
    text-underline-offset: 4px; 
    font-weight: 700 !important; 
    transition: all 0.3s ease;
  }

  .text-column :global(a:not(.hover-verde):not(.indice-item a):hover) {
    color: #006d77 !important; 
    text-decoration-color: #006d77 !important; 
  }

  /* 2. ESTILOS DEL ÍNDICE DE CONTENIDOS */
  .indice-contenidos {
      background-color: var(--bg-color, #f4f1ea);
      border: 1px solid #e5e5e5;
      border-radius: 8px;
      padding: 1.5rem 2rem;
      margin: 2rem auto 3rem auto;
      max-width: 100%;
      box-shadow: 0 4px 6px rgba(0,0,0,0.02);
  }
  
  .indice-titulo {
      font-family: var(--font-display);
      font-size: 1.2rem;
      margin: 0 0 1rem 0 !important;
      color: var(--text-color, #333);
      border-bottom: 2px solid #006d77; /* Línea esmeralda abajo del título */
      display: inline-block;
      padding-bottom: 0.3rem;
      font-weight: normal;
  }

  .indice-lista {
      list-style: none !important;
      padding: 0 !important;
      margin: 0 !important;
  }

  .indice-item { margin-bottom: 0.7rem; line-height: 1.4; }
  .indice-item.nivel-3 { padding-left: 1.5rem; font-size: 0.95rem; position: relative; }
  .indice-item.nivel-3::before { content: "•"; position: absolute; left: 0.5rem; color: #006d77; }
  
  /* Enlaces específicos del índice */
  .indice-item a { 
      text-decoration: none !important; 
      color: #555 !important; 
      font-weight: normal !important;
      transition: color 0.3s ease;
  }
  .indice-item a:hover { color: #006d77 !important; }

/* ============================================================
     REGLAS PARA CONTENEDORES DE IMÁGENES DEL CMS
     ============================================================ */
  
  /* ESCRITORIO (Pantallas mayores a 768px): Aplica el ceñido de texto */
  @media (min-width: 769px) {
      .text-column :global(.img-derecha) {
          float: right !important;
          margin: 0.5rem 0 1.5rem 2rem !important;
          clear: none !important;
      }

      .text-column :global(.img-izquierda) {
          float: left !important;
          margin: 0.5rem 2rem 1.5rem 0 !important;
          clear: none !important;
      }

      .text-column :global(.img-pequeño) {
          width: 350px !important;
          max-width: 50% !important;
      }

      .text-column :global(.img-derecha img),
      .text-column :global(.img-izquierda img) {
          width: 100% !important;
          margin: 0 !important;
      }
  }

  /* CELULARES (Pantallas de 768px o menos): Sin ceñir y desplegado de borde a borde */
  @media (max-width: 768px) {
      .text-column :global(.post-img-box),
      .text-column :global(.img-derecha),
      .text-column :global(.img-izquierda),
      .text-column :global(.img-pequeño) {
          float: none !important;
          width: calc(100% + 3rem) !important; /* Expande la imagen anulando los márgenes internos */
          max-width: calc(100% + 3rem) !important;
          margin-left: -1.5rem !important; /* Empuja la imagen hacia la izquierda hasta el borde */
          margin-right: -1.5rem !important; /* Empuja la imagen hacia la derecha hasta el borde */
          margin-top: 2rem !important;
          margin-bottom: 2rem !important;
          display: block !important;
      }

      .text-column :global(.post-img-box img),
      .text-column :global(.img-derecha img),
      .text-column :global(.img-izquierda img) {
          width: 100% !important;
          height: auto !important;
          margin: 0 auto !important;
          border-radius: 0 !important;
      }
  }

  /* Limpiar los flotantes al final para no romper el layout */
  .text-column::after {
      content: "";
      display: table;
      clear: both;
  }

  /* ============================================================
     IMAGEN DE PORTADA DE BORDE A BORDE EN CELULARES
     ============================================================ */
  @media (max-width: 768px) {
      .article-view .post-banner {
          width: calc(100% + 3rem) !important;
          max-width: calc(100% + 3rem) !important;
          margin-left: -1.5rem !important;
          margin-right: -1.5rem !important;
      }
      
      .article-view .post-banner img {
          border-radius: 0 !important; /* Le sacamos las puntas redondeadas para que encaje perfecto en los bordes de la pantalla */
      }
  }

</style>