---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
---
<Layout title={frontmatter.title} description={frontmatter.description} >
    <main class="container">
        <article class="article-view" style="display: block;">
            <a href="/diario" class="back-btn">← Volver al diario</a>
            
            <header class="article-header reveal visible">
                {frontmatter.tag && (
                    <span class="journal-tag" data-tag={frontmatter.tag.toLowerCase()}>
                        {frontmatter.tag}
                    </span>
                )}
                <span class="journal-date">
                    {new Date(frontmatter.date).toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase()} 
                </span>
                <h1 class="article-title-main">{frontmatter.title}</h1>
            </header>

            {frontmatter.main_image && (
                <div class="post-banner reveal visible">
                    <img src={frontmatter.main_image} alt={frontmatter.title} />
                </div>
            )}

            <div class="text-column reveal visible">
                <slot />
                <!-- Inyector automático del Widget de Stay22 -->
                {frontmatter.stay22_widget && (
                    <div class="stay22-widget-container" style="margin-top: 3rem; margin-bottom: 2rem;">
                        <iframe 
                            id="stay22-widget" 
                            width="100%" 
                            height="428" 
                            src={`https://stay22.com/embed/${frontmatter.stay22_widget}`} 
                            frameborder="0"
                            style="border-radius: 12px; overflow: hidden;"
                        ></iframe>
                    </div>
                )}
            </div>
        </article>
    </main>

    <!-- Script de Stay22 para links de afiliados -->
    <script is:inline>
      (function (s, t, a, y, twenty, two) {
        s.Stay22 = s.Stay22 || {};
        s.Stay22.params = { lmaID: '6a4493ddc151746f75b251a1' };
        twenty = t.createElement(a);
        two = t.getElementsByTagName(a)[0];
        twenty.async = 1;
        twenty.src = y;
        two.parentNode.insertBefore(twenty, two);
      })(window, document, 'script', 'https://scripts.stay22.com/letmeallez.js');
    </script>
</Layout>

<!-- ========================================== -->
<!-- ESTILOS EXCLUSIVOS PARA LOS LINKS DEL POST -->
<!-- ========================================== -->
<style>
  /* Apuntamos globalmente a las etiquetas <a> que nazcan dentro de tu .text-column */
  .text-column :global(a) {
    color: #1e4d3a !important; /* Verde Pino elegante */
    text-decoration: underline !important; /* Fuerza el subrayado */
    text-decoration-color: #2a6f52 !important; /* Color del subrayado un toque más suave */
    text-underline-offset: 4px; /* Separa la línea del texto para mejorar la lectura */
    font-weight: 500; /* Le da cuerpo a la tipografía del enlace */
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  /* Efecto al pasar el cursor (hover) */
  .text-column :global(a:hover) {
    color: #2a6f52 !important; /* Cambia a un verde ligeramente más vivo */
    text-decoration-color: #1e4d3a !important; /* El subrayado se oscurece */
  }
</style>