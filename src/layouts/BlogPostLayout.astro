---
import Layout from './Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ui } from '../i18n/ui.js';

const { frontmatter, headings } = Astro.props;
const indices = headings ? headings.filter((h: any) => h.depth === 2 || h.depth === 3) : [];

// Idioma y rutas
const currentLang = Astro.currentLocale || 'es';
const t = ui[currentLang as keyof typeof ui] || ui['es'];
const carpetaDiario = currentLang === 'en' ? 'journal' : 'diario';

// Tag traducido
const tagKey = `tag.${frontmatter?.tag?.toLowerCase()}`;
const translatedTag = t[tagKey as keyof typeof t] || frontmatter?.tag;

// Traemos todos los posts para armar la lista de los últimos 3 en el sidebar
// IMPORTANTE: ambas rutas deben subir desde este archivo hasta llegar a src/pages/
const postsGlob = currentLang === 'en' 
    ? import.meta.glob('../pages/en/journal/*.md', { eager: true }) 
    : import.meta.glob('../pages/diario/*.md', { eager: true });

const allPosts = Object.values(postsGlob).sort((a: any, b: any) => {
    return new Date(b.frontmatter?.date || 0).valueOf() - new Date(a.frontmatter?.date || 0).valueOf();
});

const latestPosts = allPosts.slice(0, 3);
---

<Layout title={frontmatter.title} description={frontmatter.description} frontmatter={frontmatter} isTransparentHeader={true}>
    
    <!-- HERO DEL POST -->
    <section class="post-hero-section">
        <div class="post-hero-bg" style={`background-image: linear-gradient(0deg, rgba(10,10,10,0.41), rgba(10,10,10,0.41)), url('${frontmatter.main_image || 'https://images.unsplash.com/photo-1528181304800-259b08848526?q=80&w=2000&auto=format&fit=crop'}');`}>
        </div>
        
        <div class="post-hero-content reveal visible">
            <div class="post-hero-tags-container">
                {frontmatter.tag && (
                    <span class="post-hero-tag" data-tag={frontmatter.tag.toLowerCase()}>
                        {translatedTag}
                    </span>
                )}
                {frontmatter.pais && (
                    <span class="post-hero-tag">
                        {frontmatter.pais}
                    </span>
                )}
            </div>
            
            <h1 class="post-hero-title">{frontmatter.title}</h1>
            
            <span class="post-hero-date">
                {new Date(frontmatter.date).toLocaleDateString(currentLang === 'es' ? 'es-ES' : 'en-US', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase()}
            </span>
        </div>
    </section>

    <!-- CONTENEDOR PRINCIPAL -->
    <main class="post-main-container">
        
        <article class="article-view reveal visible">
            
            <!-- COLUMNA IZQUIERDA: TEXTO DEL ARTÍCULO -->
            <div class="text-column">
                <a href={getRelativeLocaleUrl(currentLang, carpetaDiario)} class="back-btn hover-verde">← {t['post.volver'] || 'VOLVER'}</a>            
                
                {indices.length > 0 && (
                    <div class="indice-contenidos">
                        <p class="indice-titulo">{t['post.indice'] || 'Índice de contenidos'}</p>
                        <ul class="indice-lista">
                            {indices.map((heading: any) => (
                                <li class={`indice-item nivel-${heading.depth}`}>
                                    <a href={`#${heading.slug}`}>
                                        {heading.text}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                )}
                
                <slot />
                
                {frontmatter.stay22_widget && (
                    <div class="stay22-widget-container">
                        <iframe 
                            id="stay22-widget" 
                            width="100%" 
                            height="428" 
                            src={`https://stay22.com/embed/${frontmatter.stay22_widget}`} 
                            frameborder="0"
                            style="border-radius: 12px; overflow: hidden;"
                        ></iframe>
                    </div>
                )}

                <div class="banners-afiliados">
                    <h3 class="afiliados-titulo">
                        {currentLang === 'en' ? 'Support our project & travel smarter' : 'Apoyá nuestro proyecto y viajá mejor'}
                    </h3>
                    <div class="afiliados-list">
                        <div class="afiliado-row">
                            <div class="afiliado-icon-wrap">
                                <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/Booking.com_Icon_2022.svg" alt="Booking.com Logo" class="afiliado-logo" />
                            </div>
                            <div class="afiliado-info">
                                <h4>{currentLang === 'en' ? 'Book your stays' : 'Reservá tu alojamiento'}</h4>
                                <p>{currentLang === 'en' ? 'Book through our link to support the blog at no extra cost.' : 'Reservá a través de nuestro link y ayudanos a mantener el blog sin costo extra para vos.'}</p>
                            </div>
                            <div class="afiliado-action">
                                <a href="https://www.booking.com/" target="_blank" rel="noopener noreferrer" class="btn-afiliado btn-booking-post">
                                    {currentLang === 'en' ? 'Search' : 'Buscar'}
                                </a>
                            </div>
                        </div>

                        <div class="afiliado-row">
                            <div class="afiliado-icon-wrap">
                                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/dc/Airalo_logo.svg/1280px-Airalo_logo.svg.webp" alt="Airalo Logo" class="afiliado-logo" />
                            </div>
                            <div class="afiliado-info">
                                <h4>{currentLang === 'en' ? 'Internet on your trip' : 'Internet en tu viaje'}</h4>
                                <p>{currentLang === 'en' ? 'Stay connected anywhere with an Airalo eSIM. No roaming charges.' : 'Mantenete conectado en cualquier país con una eSIM de Airalo sin cargos de roaming.'}</p>
                            </div>
                            <div class="afiliado-action">
                                <a href="https://airalo.tpx.lu/8J5sLaD4" target="_blank" rel="noopener noreferrer" class="btn-afiliado btn-airalo-post">
                                    {currentLang === 'en' ? 'Get eSIM' : 'Conseguir eSIM'}
                                </a>
                            </div>
                        </div>

                        <div class="afiliado-row">
                            <div class="afiliado-icon-wrap">
                                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/e/e2/GetYourGuide_logo.svg/1280px-GetYourGuide_logo.svg.webp?utm_source=commons.wikimedia.org&utm_campaign=index&utm_content=thumbnail&_=20250423234221" alt="GetYourGuide Logo" class="afiliado-logo" />
                            </div>
                            <div class="afiliado-info">
                                <h4>{currentLang === 'en' ? 'Tours & Activities' : 'Tours y Actividades'}</h4>
                                <p>{currentLang === 'en' ? 'Book skip-the-line tickets and local tours to support our journeys.' : 'Reservá tours y entradas sin filas con GetYourGuide para apoyar nuestros viajes.'}</p>
                            </div>
                            <div class="afiliado-action">
                                <a href="https://www.getyourguide.com/" target="_blank" rel="noopener noreferrer" class="btn-afiliado btn-gyg-post">
                                    {currentLang === 'en' ? 'Explore' : 'Explorar'}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- COLUMNA DERECHA: SIDEBAR CON LOS ÚLTIMOS 3 ARTÍCULOS -->
            <aside class="sidebar-column">
                <div class="sidebar-widget">
                    <h3 class="sidebar-title">
                        {currentLang === 'en' ? 'Latest Posts' : 'Últimos Artículos'}
                    </h3>
                    <div class="sidebar-posts-list">
                        {latestPosts.map((post: any) => (
                            <a href={post.url} class="sidebar-post-item">
                                <div class="sidebar-post-img-wrap">
                                    <img src={post.frontmatter.main_image || 'https://images.unsplash.com/photo-1528181304800-259b08848526?q=80&w=500&auto=format&fit=crop'} alt={post.frontmatter.title} />
                                </div>
                                <div class="sidebar-post-info">
                                    <span class="sidebar-post-date">
                                        {new Date(post.frontmatter.date).toLocaleDateString(currentLang === 'es' ? 'es-ES' : 'en-US', { day: '2-digit', month: 'short', year: 'numeric' })}
                                    </span>
                                    <h4 class="sidebar-post-heading">{post.frontmatter.title}</h4>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>
            </aside>

        </article>

    </main>

    <script is:inline>
      (function (s, t, a, y, twenty, two) {
        s.Stay22 = s.Stay22 || {};
        s.Stay22.params = { lmaID: '6a4493ddc151746f75b251a1' };
        twenty = t.createElement(a);
        two = t.getElementsByTagName(a)[0];
        twenty.async = 1;
        twenty.src = y;
        two.parentNode.insertBefore(twenty, two);
      })(window, document, 'script', 'https://scripts.stay22.com/letmeallez.js');
    </script>
</Layout>

<style>
  /* ============================================================
     HERO DEL POST
     ============================================================ */
  .post-hero-section {
      position: relative; 
      width: 100%; 
      height: 85vh; 
      min-height: 550px;
      display: flex; 
      align-items: center; 
      justify-content: center; 
      text-align: left;
      padding: 7.5rem 0 4rem 0; 
      margin-top: -120px; 
      overflow: hidden;
  }

  .post-hero-bg { position: absolute; inset: 0; z-index: 0; background-color: #111; background-size: cover; background-position: center; }
  
  .post-hero-content { 
      position: relative; 
      z-index: 10; 
      width: 100%; 
      max-width: 1400px; 
      margin: 0 auto; 
      display: flex; 
      flex-direction: column; 
      align-items: flex-start; 
      padding: 0 2.5rem; 
  }
  
  .post-hero-tags-container { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-bottom: 1.2rem; }
  .post-hero-tag {
      font-family: var(--font-main, sans-serif); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase;
      color: #fff; border: 1px solid rgba(255, 255, 255, 0.3); background-color: rgba(0, 0, 0, 0.2); padding: 6px 16px; border-radius: 50px;
  }
  .post-hero-title {
      font-family: var(--font-display, 'Georgia', serif); font-size: clamp(2.2rem, 3.5vw, 2.8rem); 
      line-height: 1.15; color: #fff; margin-bottom: 0.8rem; font-weight: normal; max-width: 650px; text-wrap: balance;
  }
  .post-hero-date { font-family: var(--font-main, sans-serif); font-size: 0.9rem; color: rgba(255,255,255,0.9); letter-spacing: 0.1em; text-transform: uppercase; }

  /* ============================================================
     CONTENEDOR PRINCIPAL Y GRID DIVIDIDO
     ============================================================ */
  :global(body) {
      background-color: var(--bg-color, #f4f1ea) !important;
  }

  .post-main-container {
      position: relative; 
      z-index: 20; 
      width: 100%;
      max-width: 1400px;
      margin: 0 auto; 
      padding: 0 2.5rem; 
      margin-bottom: 4rem;
  }

  .article-view {
      background-color: transparent;
      width: 100%;
      padding: 0; 
      display: grid;
      grid-template-columns: 1fr 300px; 
      gap: 4rem; 
      align-items: start;
  }

  .text-column { 
      grid-column: 1 / 2; 
      min-width: 0;
      max-width: none; 
      margin: 0;
      background-color: #ffffff; 
      padding: 4rem 3rem 4rem 0; 
      position: relative;
  }

  .text-column::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      right: 100%;
      width: 50vw;
      background-color: #ffffff;
      z-index: -1;
  }

  .text-column > :global(*) {
    max-width: min(720px, 100%);
    margin-left: 0;
    margin-right: 0;
    } 

  .text-column :global(hr) {
      border: none;
      border-top: 1px solid #e2e8f0;
      margin: 2.5rem 0;
  }

  /* EL SIDEBAR */
  .sidebar-column { 
      grid-column: 2 / 3; 
      position: sticky; 
      top: 120px; 
      padding: 4rem 0 4rem 0; 
  }

  .sidebar-widget {
      background-color: transparent;
      border: none;
      padding: 0;
  }
  .sidebar-title {
      font-family: var(--font-display);
      font-size: 1.4rem;
      margin-top: 0;
      margin-bottom: 2rem;
      color: #333;
      border-bottom: 2px solid #006d77;
      display: inline-block;
      padding-bottom: 0.3rem;
  }
  .sidebar-posts-list {
      display: flex;
      flex-direction: column;
      gap: 2.5rem; 
  }
  
  .sidebar-post-item {
      display: flex;
      flex-direction: column; 
      text-decoration: none;
      background-color: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0,0,0,0.04);
      border: 1px solid var(--c-border);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .sidebar-post-item:hover { 
      transform: translateY(-5px);
      box-shadow: 0 10px 25px rgba(0,0,0,0.08);
  }
  .sidebar-post-img-wrap {
      width: 100%;
      height: 180px; 
      overflow: hidden;
      flex-shrink: 0; 
  }
  .sidebar-post-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
  }
  .sidebar-post-item:hover .sidebar-post-img-wrap img {
      transform: scale(1.05);
  }
  .sidebar-post-info {
      padding: 1.2rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
  }
  .sidebar-post-date {
      font-family: var(--font-main, sans-serif);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--c-text-muted);
  }
  .sidebar-post-heading {
      font-family: var(--font-display);
      font-size: 1.15rem;
      line-height: 1.3;
      color: var(--c-text-main);
      margin: 0;
      font-weight: normal;
  }

  /* BOTÓN VOLVER */
  .back-btn { 
      display: inline-block; margin-bottom: 2.5rem; font-size: 0.8rem; text-transform: uppercase; 
      color: var(--accent-color); cursor: pointer; padding: 10px 0; font-weight: bold; letter-spacing: 0.05em; text-decoration: none;
  }
  .back-btn:hover { border-bottom-color: var(--accent-color); }

  /* TIPOGRAFÍA Y CONTENIDO INTERNO */
  .text-column :global(p) { font-family: var(--font-main, sans-serif); font-size: 1.05rem; line-height: 1.78; color: #2d3748; margin-bottom: 1.7rem; }
  .text-column :global(h2) { font-family: var(--font-display, 'Georgia', serif); font-size: 2rem; font-weight: normal; color: #1a202c; margin-top: 3.5rem; margin-bottom: 1.2rem; }
  .text-column :global(h3) { font-family: var(--font-main, sans-serif); font-size: 1.35rem; font-weight: 700; color: #2d3748; margin-top: 2.8rem; margin-bottom: 1rem; }
  .text-column :global(img) { width: 100%; height: auto !important; border-radius: 8px !important; margin-bottom: 1.5rem !important; display: block; }

  /* GALERÍA: excepción intencional, ocupa todo el ancho de la columna (no los 720px) */
  .article-view ul:has(img) { display: flex !important; gap: 1.5rem !important; list-style: none !important; padding: 0 !important; margin: 2.5rem 0 !important; max-width: 100% !important; }
  .article-view ul:has(img) li { flex: 1 !important; margin: 0 !important; }
  .article-view ul:has(img) img { width: 100% !important; height: 350px !important; object-fit: cover !important; max-width: 100% !important; }

  .text-column :global(table) { width: 100%; border-collapse: collapse; margin: 2.5rem 0; font-size: 0.95rem; display: block; overflow-x: auto; border-radius: 8px; border: 1px solid #e2e8f0; }
  .text-column :global(th), .text-column :global(td) { padding: 0.9rem 1.2rem; color: #334155; }
  .text-column :global(thead) { background-color: #f8fafc; border-bottom: 2px solid #cbd5e1; }

  .text-column :global(a:not(.hover-verde):not(.indice-item a):not(.btn-afiliado)) {
      color: #006d77 !important; text-decoration: none !important; font-weight: 700 !important; 
      background: linear-gradient(to top, rgba(0, 109, 119, 0.18) 0%, rgba(0, 109, 119, 0.18) 35%, transparent 35%) !important;
      padding: 0 4px; border-radius: 2px;
  }

  /* ÍNDICE */
  .indice-contenidos { background-color: var(--bg-color, #f8f6f0); border: 1px solid #e7e5e0; border-radius: 8px; padding: 1.5rem 2rem; margin: 0 0 3rem 0; }
  .indice-titulo { font-family: var(--font-display); font-size: 1.2rem; margin: 0 0 1rem 0 !important; color: #333; border-bottom: 2px solid #006d77; display: inline-block; padding-bottom: 0.3rem; }
  .indice-lista { list-style: none !important; padding: 0 !important; margin: 0 !important; }
  .indice-item { margin-bottom: 0.7rem; line-height: 1.4; }
  .indice-item.nivel-3 { padding-left: 1.5rem; font-size: 0.95rem; position: relative; }
  .indice-item a { text-decoration: none !important; color: #555 !important; }
  .indice-item a:hover { color: #006d77 !important; }

  /* ============================================================
     BANNERS DE AFILIADOS
     ============================================================ */
  .banners-afiliados { 
      margin-top: 4rem; 
      padding-top: 4rem; 
      border-top: 1px solid #eee; 
      width: 100%; 
  }
  .afiliados-titulo { 
      text-align: left; 
      font-family: var(--font-display); 
      font-size: 1.6rem; 
      margin-bottom: 2rem; 
      color: #333; 
      font-weight: normal; 
  }
  .afiliados-list { 
      display: flex; 
      flex-direction: column; 
      gap: 1.5rem; 
      width: 100%; 
  }
  .afiliado-row {
      background-color: #ffffff; 
      border: 1px solid #e2e8f0; 
      border-radius: 12px; 
      padding: 1.2rem 1.5rem;
      display: grid; 
      grid-template-columns: 60px 1fr auto; 
      gap: 1.5rem; 
      align-items: center;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }
  .afiliado-icon-wrap { height: 36px; display: flex; align-items: center; justify-content: center; }
  .afiliado-logo { max-height: 100%; max-width: 100%; object-fit: contain; }
  .afiliado-info h4 { font-family: var(--font-display); font-size: 1.1rem; margin: 0 0 0.3rem 0 !important; color: #333; font-weight: normal; }
  .afiliado-info p { font-family: var(--font-main, sans-serif); font-size: 0.9rem !important; color: #666; margin: 0 !important; }
  .btn-afiliado {
      display: inline-flex !important; align-items: center !important; justify-content: center !important;
      background-color: #2d3748 !important; color: #ffffff !important; border-radius: 8px !important;
      font-weight: 700 !important; text-transform: uppercase !important; padding: 10px 20px !important; font-size: 0.75rem !important; min-width: 110px !important; text-decoration: none !important;
  }
  .btn-booking-post:hover { background-color: #003580 !important; }
  .btn-airalo-post:hover { background-color: #ff5e00 !important; }
  .btn-gyg-post:hover { background-color: #ff5533 !important; }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 1024px) {
      .post-main-container { padding: 0; }
      .article-view { grid-template-columns: 1fr; padding: 0; background-color: #ffffff; }
      .text-column { padding: 3rem 2rem; }
      .sidebar-column { display: none; } 
  }

  @media (max-width: 768px) {
      .post-hero-section { 
          height: auto !important; 
          min-height: 85vh !important; 
          align-items: center !important; 
          padding: 4rem 15px 4rem 15px !important; 
      }
      .post-hero-content { margin-top: 4rem !important; padding: 0 !important; }
      .post-hero-title { font-size: clamp(1.8rem, 7vw, 2.5rem) !important; max-width: 100% !important; }
      
      .post-main-container { padding: 0 !important; margin-top: 0 !important; }
      .article-view { padding: 0; background-color: transparent; }
      .text-column { padding: 2rem 15px 4rem 15px; background-color: #ffffff; }
      
      /* Solución al desborde de los afiliados */
      .banners-afiliados {
          width: 100% !important;
          box-sizing: border-box !important;
          overflow: hidden !important; 
      }
      .afiliados-list {
          width: 100% !important;
          box-sizing: border-box !important;
          display: flex !important;
          flex-direction: column !important;
      }
      .afiliado-row { 
          /* CLAVE: Cambiar de Grid a Flex en columna para forzar que se adapte al ancho del móvil */
          display: flex !important;
          flex-direction: column !important;
          align-items: center !important;
          gap: 1rem !important; 
          padding: 1.5rem !important; 
          text-align: center !important; 
          width: 100% !important;
          box-sizing: border-box !important; 
      }
      .afiliado-info {
          width: 100% !important;
          box-sizing: border-box !important;
      }
      .afiliado-info h4, .afiliado-info p {
          /* Evita que palabras muy largas rompan el contenedor */
          word-wrap: break-word !important;
          overflow-wrap: break-word !important;
      }
      .afiliado-action { 
          justify-content: center !important; 
          width: 100% !important; 
          margin-top: 0.5rem !important;
      }
      .btn-afiliado { 
          width: 100% !important; 
          box-sizing: border-box !important;
          padding: 12px 20px !important;
      }

      .text-column :global(img),
      .text-column :global(.post-img-box),
      .text-column :global(.img-derecha),
      .text-column :global(.img-izquierda),
      .text-column :global(.img-pequeño),
      .text-column :global(.img-mediano),
      .text-column :global(.img-completo) {
          float: none !important;
          position: relative !important;
          width: 100vw !important;
          max-width: 100vw !important;
          left: 50% !important;
          transform: translateX(-50%) !important;
          margin-left: 0 !important;
          margin-right: 0 !important;
          margin-top: 2rem !important;
          margin-bottom: 0.5rem !important;
          display: block !important;
          border-radius: 0 !important;
      }

      .text-column :global(.post-img-box img),
      .text-column :global(.img-derecha img),
      .text-column :global(.img-izquierda img) {
          width: 100vw !important;
          max-width: 100vw !important;
          height: auto !important;
          margin: 0 !important;
          border-radius: 0 !important;
          left: 0 !important;
          transform: none !important;
      }

      .text-column :global(.img-caption) {
          display: block !important;
          width: 100% !important;
          padding: 0 15px !important; 
          margin-top: 0.5rem !important;
          margin-bottom: 2.5rem !important;
          text-align: center !important;
      }
  }

  .hover-verde { transition: color 0.3s ease !important; }
  .hover-verde:hover { color: #006d77 !important; }
  .reveal { opacity: 0; transform: translateY(20px); transition: all 0.8s ease-out; }
  .reveal.visible { opacity: 1; transform: translateY(0); }
</style>