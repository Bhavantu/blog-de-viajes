---
import Layout from './Layout.astro';

const { frontmatter, headings } = Astro.props;

const indices = headings ? headings.filter((h: any) => h.depth === 2 || h.depth === 3) : [];
---

<Layout title={frontmatter.title} description={frontmatter.description}>
    <main class="container">
        <article class="article-view" style="display: block;">
            <a href="/diario" class="back-btn hover-verde">← Volver al diario</a>
            
            <header class="article-header reveal visible">
                {frontmatter.tag && (
                    <span class="journal-tag" data-tag={frontmatter.tag.toLowerCase()}>
                        {frontmatter.tag}
                    </span>
                )}
                <span class="journal-date">
                    {new Date(frontmatter.date).toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase()} 
                </span>
                <h1 class="article-title-main">{frontmatter.title}</h1>
            </header>

            {frontmatter.main_image && (
                <div class="post-banner reveal visible">
                    <img src={frontmatter.main_image} alt={frontmatter.title} />
                </div>
            )}

            <div class="text-column reveal visible">
                
                <!-- ÍNDICE DE CONTENIDOS -->
                {indices.length > 0 && (
                    <div class="indice-contenidos">
                        <p class="indice-titulo">En este artículo</p>
                        <ul class="indice-lista">
                            {indices.map((heading: any) => (
                                <li class={`indice-item nivel-${heading.depth}`}>
                                    <a href={`#${heading.slug}`}>
                                        {heading.text}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                )}
                
                <!-- TEXTO DEL ARTÍCULO -->
                <slot />
                
                <!-- Inyector automático del Widget de Stay22 -->
                {frontmatter.stay22_widget && (
                    <div class="stay22-widget-container" style="margin-top: 3rem; margin-bottom: 2rem;">
                        <iframe 
                            id="stay22-widget" 
                            width="100%" 
                            height="428" 
                            src={`https://stay22.com/embed/${frontmatter.stay22_widget}`} 
                            frameborder="0"
                            style="border-radius: 12px; overflow: hidden;"
                        ></iframe>
                    </div>
                )}
            </div>
        </article>
    </main>

    <!-- Script de Stay22 para links de afiliados -->
    <script is:inline>
      (function (s, t, a, y, twenty, two) {
        s.Stay22 = s.Stay22 || {};
        s.Stay22.params = { lmaID: '6a4493ddc151746f75b251a1' };
        twenty = t.createElement(a);
        two = t.getElementsByTagName(a)[0];
        twenty.async = 1;
        twenty.src = y;
        two.parentNode.insertBefore(twenty, two);
      })(window, document, 'script', 'https://scripts.stay22.com/letmeallez.js');
    </script>
</Layout>

<!-- ========================================== -->
<!-- ESTILOS EXCLUSIVOS PARA EL POST Y EL ÍNDICE-->
<!-- ========================================== -->
<style>

  /* ============================================================
     ESTILOS PARA LOS TÍTULOS DEL MARKDOWN (H2, H3, H4)
     ============================================================ */
  .text-column :global(h2) {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: normal;
    color: var(--text-color, #333);
    margin-top: 3.5rem;
    margin-bottom: 1.2rem;
    line-height: 1.3;
  }

  .text-column :global(h3) {
    font-family: var(--font-main);
    font-size: 1.4rem;
    font-weight: 700;
    color: #444;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  .text-column :global(h4) {
    font-size: 1.15rem;
    font-weight: 700;
    color: #555;
    margin-top: 2rem;
    margin-bottom: 0.8rem;
  }
  
  .text-column :global(p) {
    margin-bottom: 1.5rem;
  }  

  .text-column :global(a:not(.hover-verde):not(.indice-item a)) {
    color: #333 !important;
    text-decoration: underline !important; 
    text-decoration-color: #ccc !important;
    text-underline-offset: 4px; 
    font-weight: 700 !important; 
    transition: all 0.3s ease;
  }

  .text-column :global(a:not(.hover-verde):not(.indice-item a):hover) {
    color: #006d77 !important; 
    text-decoration-color: #006d77 !important; 
  }

  /* 2. ESTILOS DEL ÍNDICE DE CONTENIDOS */
  .indice-contenidos {
      background-color: var(--bg-color, #f4f1ea);
      border: 1px solid #e5e5e5;
      border-radius: 8px;
      padding: 1.5rem 2rem;
      margin: 2rem auto 3rem auto;
      max-width: 100%;
      box-shadow: 0 4px 6px rgba(0,0,0,0.02);
  }
  
  .indice-titulo {
      font-family: var(--font-display);
      font-size: 1.2rem;
      margin: 0 0 1rem 0 !important;
      color: var(--text-color, #333);
      border-bottom: 2px solid #006d77; /* Línea esmeralda abajo del título */
      display: inline-block;
      padding-bottom: 0.3rem;
      font-weight: normal;
  }

  .indice-lista {
      list-style: none !important;
      padding: 0 !important;
      margin: 0 !important;
  }

  .indice-item { margin-bottom: 0.7rem; line-height: 1.4; }
  .indice-item.nivel-3 { padding-left: 1.5rem; font-size: 0.95rem; position: relative; }
  .indice-item.nivel-3::before { content: "•"; position: absolute; left: 0.5rem; color: #006d77; }
  
  /* Enlaces específicos del índice */
  .indice-item a { 
      text-decoration: none !important; 
      color: #555 !important; 
      font-weight: normal !important;
      transition: color 0.3s ease;
  }
  .indice-item a:hover { color: #006d77 !important; }
</style>