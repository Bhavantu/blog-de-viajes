---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
---
<Layout title={frontmatter.title}>
    <main class="container">
        <article class="article-view" style="display: block;">
            <a href="/diario" class="back-btn">← Volver al diario</a>
            
            <header class="article-header reveal visible">
                <span class="article-meta">
                    {new Date(frontmatter.date).toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }).toUpperCase()} 
                    {frontmatter.category ? `| ${frontmatter.category.toUpperCase()}` : ''}
                </span>
                <h1 class="article-title-main">{frontmatter.title}</h1>
            </header>

            {frontmatter.main_image && (
                <img src={frontmatter.main_image} class="img-full-width reveal visible" alt={frontmatter.title} />
            )}

            <div class="text-column reveal visible">
                <slot />
            </div>
        </article>
    </main>

    <footer>
        <p>&copy; 2026 MORSEROS.</p>
    </footer>
</Layout>