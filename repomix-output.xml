import ScrollExpandHero from '../components/ui/ScrollExpandHero.astro';
import { ui } from '../i18n/ui.js';
import { destinationsData as destinations, categoriesData as categories } from '../data/taxonomies.js';

const currentLang = Astro.currentLocale || 'es';
const t = ui[currentLang as keyof typeof ui] || ui['es'];

// Leemos las entradas de la carpeta en español
const posts = import.meta.glob('./diario/*.md', { eager: true });
const allPosts = Object.values(posts);

const sortedPosts = allPosts.sort((a: any, b: any) => {
    const dateA = new Date(a.frontmatter?.date || 0).valueOf();
    const dateB = new Date(b.frontmatter?.date || 0).valueOf();
    return dateB - dateA;
});

// Buscamos posts para el Grid de Destacados (LÍMITE DE 6 POSTS)
let featuredPosts = sortedPosts.filter((post: any) => post.frontmatter.destacado === true);
if (featuredPosts.length < 6) {
    const cantidadFaltante = 6 - featuredPosts.length;
    const postsNoDestacados = sortedPosts.filter((post: any) => post.frontmatter.destacado !== true);
    featuredPosts = [...featuredPosts, ...postsNoDestacados.slice(0, cantidadFaltante)];
} else {
    featuredPosts = featuredPosts.slice(0, 6);
}
---

<Layout 
  title="Inicio - BLOGCITO" 
  description="Diario de viaje, guías prácticas y vida local alrededor del mundo. Acompañanos a descubrir nuevos destinos a través de nuestras crónicas y viajes lentos."
  isTransparentHeader={true}
>
    <!-- 1. NUEVO HERO: SCROLL MEDIA EXPANSION -->
    <ScrollExpandHero 
        bgImageSrc="/img/diario/hero2.webp"
        mediaSrc="/img/diario/hero3.webp"
    >
        <!-- Título sin text-shadow -->
        <h1 style="font-family: var(--font-display, 'Georgia', serif); font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; color: #ffffff; margin-bottom: 1.2rem; font-weight: 400; letter-spacing: -0.01em; text-wrap: balance;">
            Conociendo otros mundos<br/>
            <span style="font-style: italic; color: rgba(255,255,255,0.9);">a paso lento.</span>
        </h1>
        
        <!-- Párrafo sin text-shadow, sin background radial y sin padding -->
        <p style="font-family: var(--font-main, sans-serif); font-size: 1.05rem; color: rgba(255,255,255,0.95); max-width: 550px; margin-bottom: 2.5rem; line-height: 1.6; font-weight: 400; letter-spacing: 0.02em;">
            Relatos, cultura y guías de viaje.
        </p>
        
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;">
            <a href="#destinos" class="bc-btn-solid">Explorar Destinos</a>
            <a href="#quienes-somos" class="bc-btn-outline hero-outline-btn">Nuestra Historia</a>
        </div>
    </ScrollExpandHero>

    <!-- MAIN CONTENT -->
    <main class="bc-main-wrapper">
        
        <!-- 2. SECCIÓN: CARRUSEL DE DESTINOS -->
        <section id="destinos" class="bc-section-block bc-bg-light">
            <div class="bc-section-inner">
                <div class="bc-header-centered">
                    <h2 class="bc-title-main">Explorar Destinos</h2>
                </div>

                <editorial-carousel class="car-wrapper">
                    <div class="car-inner">
                        {destinations.map((dest, index) => (
                            <div class="car-slide" data-index={index}>
                                <div class="car-content">
                                    <div class="car-content-inner">
                                        <div class="car-counter">
                                            <span class="car-num-line"></span>
                                            <span class="car-num-text">{String(index + 1).padStart(2, '0')} / {String(destinations.length).padStart(2, '0')}</span>
                                        </div>
                                        <h3 class="car-title">{dest.title}</h3>
                                        <p class="car-subtitle" style={`--c-accent: ${dest.accent};`}>{dest.subtitle}</p>
                                        <p class="car-desc">{dest.description}</p>
                                        
                                        <div class="car-action">
                                            <a href={`/destinos/${dest.id}`} class="bc-link" style={`--c-accent: ${dest.accent};`}>
                                                Ver guías de {dest.title} &rarr;
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="car-image-container">
                                    <div class="car-image-frame">
                                        <img src={dest.imageUrl} alt={dest.title} class="car-image" />
                                        <div class="car-image-overlay" style={`background: linear-gradient(135deg, ${dest.accent} 0%, transparent 50%) !important; opacity: 0.15 !important;`}></div>
                                    </div>
                                    <div class="car-frame-corner car-frame-corner-tl" style={`border-color: ${dest.accent} !important;`}></div>
                                    <div class="car-frame-corner car-frame-corner-br" style={`border-color: ${dest.accent} !important;`}></div>
                                </div>
                            </div>
                        ))}
                    </div>

                    <div class="car-controls">
                        <div class="car-nav-arrows">
                            <button class="car-arrow-btn car-prev" aria-label="Anterior">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                            </button>
                            <button class="car-arrow-btn car-next" aria-label="Siguiente">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </button>
                        </div>

                        <div class="car-progress-bar">
                            {destinations.map((dest, index) => (
                                <button class="car-progress-item" data-index={index} aria-label={`Ir a ${dest.title}`}>
                                    <div class="car-progress-track">
                                        <div class="car-progress-fill" style={`background-color: ${dest.accent} !important;`}></div>
                                    </div>
                                    <span class="car-progress-label">{dest.title}</span>
                                </button>
                            ))}
                        </div>
                    </div>
                </editorial-carousel>
            </div>
        </section>

        <!-- 3. SECCIÓN: ARTÍCULOS DESTACADOS -->
        <section id="destacados" class="bc-section-block bc-bg-muted">
            <div class="bc-section-inner">
                <div class="bc-header-split">
                    <div class="bc-header-left">
                        <h2 class="bc-title-main">Artículos Destacados</h2>
                        <p class="bc-subtitle-main">Selección de nuestras mejores crónicas y guías.</p>
                    </div>
                    <div class="bc-header-right">
                        <a href="/diario" class="bc-link">Ver todas las entradas &rarr;</a>
                    </div>
                </div>

                <div class="bc-featured-grid">
                    {featuredPosts.map((post: any) => {
                        const tagKey = `tag.${post.frontmatter.tag?.toLowerCase()}`;
                        const translatedTag = t[tagKey as keyof typeof t] || post.frontmatter.tag;
                        const imgSrc = post.frontmatter.main_image || 'https://images.unsplash.com/photo-1528181304800-259b08848526?q=80&w=1000&auto=format&fit=crop';
                        
                        const dateObj = new Date(post.frontmatter.date);
                        const formattedDate = !isNaN(dateObj.getTime()) ? dateObj.toLocaleDateString(currentLang, { year: 'numeric', month: 'long', day: 'numeric' }) : '';

                        return (
                            <a href={post.url} class="bc-featured-card">
                                <div class="bc-featured-img-wrap">
                                    <img src={imgSrc} alt={post.frontmatter.title} class="bc-featured-img" />
                                </div>
                                <div class="bc-featured-content">
                                    <div class="bc-featured-meta">
                                        <div class="bc-featured-tags">
                                            <span class="bc-tag">{translatedTag}</span>
                                            {post.frontmatter.pais && (
                                                <span class="bc-tag">{post.frontmatter.pais}</span>
                                            )}
                                        </div>
                                        <span class="bc-date">{formattedDate}</span>
                                    </div>
                                    
                                    <h3 class="bc-featured-title">{post.frontmatter.title}</h3>
                                    <p class="bc-featured-excerpt">{post.frontmatter.description}</p>
                                    <span class="bc-read-more">LEER MÁS &rarr;</span>
                                </div>
                            </a>
                        );
                    })}
                </div>
            </div>
        </section>

        <!-- 4. SECCIÓN: CATEGORÍAS (Hover Menu Editorial) -->
        <section id="categorias" class="bc-section-block bc-bg-light">
            <div class="bc-section-inner">
                <div class="bc-header-centered">
                    <h2 class="bc-title-main">Explora por Categorías</h2>
                    <p class="bc-subtitle-main">Encuentra el contenido que necesitas según tu forma de viajar.</p>
                </div>

                <div class="bc-hover-menu-container">
                    <div class="bc-hover-menu-list">
                        {categories.map((cat, index) => (
                            <a href={`/categorias/${cat.id}`} class="bc-hover-item" data-index={index}>
                                <span class="bc-hm-number">0{index + 1}</span>
                                <h3 class="bc-hm-title">{cat.title}</h3>
                                <p class="bc-hm-desc">{cat.desc}</p>
                                <!-- NUEVO: Flecha minimalista visible solo en móviles -->
                            <span class="bc-hm-mobile-link" aria-label="Explorar categoría">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </span>
                            </a>
                        ))}
                    </div>
                    <div class="bc-hover-visual">
                        {categories.map((cat, index) => (
                            <img src={cat.img} alt={cat.title} class={`bc-hm-img ${index === 0 ? 'active' : ''}`} data-index={index} />
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. SECCIÓN: ABOUT US (Scrapbook 3 Columnas) -->
        <section id="quienes-somos" class="bc-section-block bc-bg-muted bc-border-top">
            <div class="bc-section-inner">
                <div class="bc-scrapbook-grid">
                    
                    <!-- Columna Izquierda: Foto Principal -->
                    <div class="bc-scrapbook-left">
                        <div class="bc-polaroid main">
                            <div class="bc-tape"></div>
                            <img src="/img/nosotros.webp" alt="Creadores de Blogcito viajando" onerror="this.src='https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?q=80&w=1000&auto=format&fit=crop'" />
                        </div>
                    </div>
                    
                    <!-- Columna Central: Texto -->
                    <div class="bc-scrapbook-text" style="display: flex; flex-direction: column; align-items: center;">
                        <!-- Un contenedor interno para alinear el texto a la izquierda, pero mantener el bloque en el centro -->
                        <div style="max-width: 100%; text-align: left;">
                            <h2 class="bc-title-main" style="text-align: left !important;">Detrás de Blogcito</h2>
                            <p class="bc-scrapbook-desc" style="text-align: left !important;">
                                Viajamos lento, nos sumergimos en las comunidades locales y escribimos guías honestas para que puedas planear tu viaje con un presupuesto realista y respeto cultural. Más que coleccionar atracciones, nos importa conectar con las personas, los territorios y las tradiciones.
                            </p>
                            <p class="bc-scrapbook-desc" style="text-align: left !important;">
                                Creamos este espacio para responder las preguntas reales que todos nos hacemos antes de partir: cuánto cuesta realmente vivir en un lugar, cómo adaptarse a las culturas locales y cómo equilibrar el trabajo remoto con el viaje consciente. Sin publicidades engañosas, solo datos prácticos.
                            </p>
                            <div class="bc-signature" style="text-align: left !important;">Lore & Santi</div>
                        </div>
                    </div>

                    <!-- Columna Derecha: Fotos Individuales -->
                    <div class="bc-scrapbook-right">
                        <div class="bc-polaroid detail-top">
                            <div class="bc-tape alt"></div>
                            <img src="/img/polaroid2.webp" alt="Lore" onerror="this.src='https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?q=80&w=400&auto=format&fit=crop'" />
                        </div>
                        <div class="bc-polaroid detail-bottom">
                            <div class="bc-tape alt-2"></div>
                            <img src="/img/polaroid1.webp" alt="Santi" onerror="this.src='https://images.unsplash.com/photo-1528181304800-259b08848526?q=80&w=400&auto=format&fit=crop'" />
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- 6. SECCIÓN: GRAND FINALE (Apoyo Cinematográfico) -->
        <section id="apoyo" class="bc-section-block bc-grand-finale">
            <div class="bc-finale-bg">
                <img src="/img/UBUD8.webp" alt="Paisaje inspirador" onerror="this.src='https://images.unsplash.com/photo-1528181304800-259b08848526?q=80&w=2000&auto=format&fit=crop'" />
                <div class="bc-finale-scrim"></div>
            </div>
            
            <div class="bc-finale-content">
                <h2 class="bc-finale-title">Sigamos el viaje juntos</h2>
                <p class="bc-finale-desc">Mantenemos este espacio libre de publicidad invasiva. Si nuestras guías te ayudaron a planear tu aventura, hay dos formas en las que podés apoyarnos:</p>
                
                <div class="bc-finale-links">
                    <a href="https://ko-fi.com/blogcito" target="_blank" rel="noopener noreferrer" class="bc-finale-link">
                        <span class="bc-fl-title">Para Viajeros</span>
                        <span class="bc-fl-subtitle">Invitanos un café virtual &rarr;</span>
                    </a>
                    <div class="bc-fl-divider"></div>
                    <a href="/colab" class="bc-finale-link">
                        <span class="bc-fl-title">Para Marcas</span>
                        <span class="bc-fl-subtitle">Ver Media Kit &rarr;</span>
                    </a>
                </div>
            </div>
        </section>
        
    </main>
</Layout>

<style is:global>
    /* ============================================================
       SISTEMA WARM EDITORIAL & TEXTURA DE RUIDO
       ============================================================ */
    :root {
        --c-brand: #00565d;      
        --c-brand-hover: oklch(0.30 0.10 200);
        --c-text-main: oklch(0.25 0.02 250);  
        --c-text-muted: oklch(0.55 0.02 250); 
        --c-bg-warm: oklch(0.98 0.01 75);     
        --c-border: oklch(0.90 0.01 75);      
    }

    body::after {
        content: ""; position: fixed; inset: 0; z-index: 9999; pointer-events: none;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        opacity: 0.03; mix-blend-mode: multiply;
    }

    /* --- UI KIT: Botones y Enlaces --- */
    .bc-btn-solid {
