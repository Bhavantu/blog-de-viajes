<!-- SCRIPT GENERAL PARA MENÚ Y BÚSQUEDA -->
<script>
    const removeAccents = (str: string) => {
        return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    };

    document.addEventListener('DOMContentLoaded', () => {
        // --- 1. LÓGICA DEL MENÚ HAMBURGUESA ---
        const btnMenu = document.getElementById('mobile-menu-btn');
        const navMenu = document.getElementById('main-nav');
        const overlay = document.getElementById('mobile-menu-overlay');

        function closeMenu() {
            btnMenu?.classList.remove('menu-abierto');
            navMenu?.classList.remove('menu-open');
            overlay?.classList.remove('menu-open');
            document.body.style.overflow = '';
        }

        function toggleMenu() {
            btnMenu?.classList.toggle('menu-abierto');
            navMenu?.classList.toggle('menu-open');
            overlay?.classList.toggle('menu-open');
            if(navMenu?.classList.contains('menu-open')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }
        }

        btnMenu?.addEventListener('click', toggleMenu);
        overlay?.addEventListener('click', closeMenu);

        // --- 2. LÓGICA DEL BUSCADOR ---
        const searchTrigger = document.getElementById('search-trigger');
        const searchModal = document.getElementById('search-modal');
        const searchModalContent = document.getElementById('search-modal-content');
        const closeSearchBtn = document.getElementById('close-search');
        const searchInput = document.querySelector<HTMLInputElement>('#search-input');
        const searchResultsList = document.getElementById('search-results-list');
        const langCode = document.documentElement.lang || 'es'; 

        searchTrigger?.addEventListener('click', (e) => {
            e.preventDefault();
            if(navMenu?.classList.contains('menu-open')) {
                closeMenu();
            }
            searchModal?.classList.add('active');
            setTimeout(() => {
                if (searchInput) searchInput.focus();
            }, 100);
            document.body.style.overflow = 'hidden'; 
        });

        function closeSearchModal() {
            searchModal?.classList.remove('active');
            if (searchInput) searchInput.value = '';
            if (searchResultsList) searchResultsList.innerHTML = '';
            searchModalContent?.classList.remove('has-results');
            document.body.style.overflow = '';
        }

        closeSearchBtn?.addEventListener('click', closeSearchModal);
        
        searchModal?.addEventListener('click', (e) => {
            if (e.target === searchModal) {
                closeSearchModal();
            }
        });

        document.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'Escape' && searchModal?.classList.contains('active')) {
                closeSearchModal();
            }
        });

        // --- 3. BÚSQUEDA EN VIVO Y CARGA DE POSTS ---
        if (searchInput && searchResultsList) {
            
            let postsData: Record<string, any> = {};
            
            try {
                if(langCode === 'en') {
                    postsData = import.meta.glob('../pages/en/journal/*.md', { eager: true });
                } else {
                    postsData = import.meta.glob('../pages/diario/*.md', { eager: true });
                }
            } catch (error) {
                console.error("Error al cargar posts", error);
            }

            const posts = Object.values(postsData);

            const searchData = posts.map((post: any) => {
                const p = post || {};
                const fm = p.frontmatter || {};
                const title = fm.title || '';
                const content = typeof p.rawContent === 'function' ? p.rawContent().toLowerCase() : '';
                
                return {
                    title: title,
                    url: p.url || '',
                    image: fm.main_image || '',
                    tag: fm.tag || 'Diario',
                    searchString: removeAccents((title + " " + content).toLowerCase())
                };
            });

            searchInput.addEventListener('input', () => {
                const rawQuery = searchInput.value.toLowerCase().trim();
                const query = removeAccents(rawQuery);
                
                searchResultsList.innerHTML = ''; 

                if (query.length >= 2) {
                    const filtered = searchData.filter((post: any) => 
                        post.searchString.includes(query)
                    ).slice(0, 5); 

                    if (filtered.length > 0) {
                        filtered.forEach((post: any) => {
                            const li = document.createElement('li');
                            li.className = 'search-result-item';
                            
                            li.innerHTML = `
                                <a href="${post.url}" class="search-result-link">
                                    ${post.image ? `<img src="${post.image}" class="search-result-img" alt="" />` : ''}
                                    <div class="search-result-text">
                                        <h4 class="search-result-title">${post.title}</h4>
                                        <span class="search-result-meta">${post.tag}</span>
                                    </div>
                                </a>
                            `;
                            li.addEventListener('click', () => closeSearchModal());
                            searchResultsList.appendChild(li);
                        });
                    } else {
                        searchResultsList.innerHTML = `<li class="search-result-item" style="padding: 1.5rem; text-align: center; color: #666;">${langCode === 'en' ? 'No results found' : 'No se encontraron resultados'}</li>`;
                    }
                    
                    searchModalContent?.classList.add('has-results');
                } else {
                    searchModalContent?.classList.remove('has-results');
                }
            });

            searchInput.addEventListener('keydown', (e: KeyboardEvent) => {
                if (e.key === 'Enter') {
                    e.preventDefault(); 
                    const query = searchInput.value.trim();
                    if (query) {
                        const searchUrl = langCode === 'en' ? `/en/search?q=${encodeURIComponent(query)}` : `/search?q=${encodeURIComponent(query)}`;
                        window.location.href = searchUrl;
                    }
                }
            });
        }
    });
</script>
</file>

