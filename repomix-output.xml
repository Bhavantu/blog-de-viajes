<file path="src/pages/en/journal/[...page].astro">
---
import type { Page, GetStaticPathsOptions } from 'astro'; 
import Layout from '../../../layouts/Layout.astro';
import Hero from '../../../components/Hero.astro';
import { ui } from '../../../i18n/ui.js';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  // Lee los archivos .md dentro de src/pages/en/journal/
  const posts = Object.values(import.meta.glob('./*.md', { eager: true }));
  const allPosts = Object.values(posts);
  
  const sortedPosts = allPosts.sort((a: any, b: any) => {
      const dateA = new Date(a.frontmatter?.date || 0).valueOf();
      const dateB = new Date(b.frontmatter?.date || 0).valueOf();
      return dateB - dateA;
  });

  return paginate(sortedPosts, { pageSize: 9 });
}

interface Props {
  page: Page<any>; 
}

const { page } = Astro.props;

// Idioma y diccionario
const currentLang = Astro.currentLocale || 'en';
const t = ui[currentLang as keyof typeof ui] || ui['en'];
---

<Layout 
  title={`Travel Journal - Page ${page.currentPage}`} 
  description="Explore our travel journal. A collection of honest chronicles, road stories, practical guides, and inspiring photography from our adventures around the world." 
  isTransparentHeader={true}
>  
  <Hero 
    title="Travel Journal" 
    description="All our chronicles, guides, and stories in one place."
    bgImage="/img/Paisajes/pekin_park_flowers_temple.webp" 
    loading="eager" 
    fetchpriority="high"
  />

  <main class="bc-main-wrapper">
    <div class="bc-section-inner" style="padding: 0 2rem;">
        
        <!-- GRILLA EDITORIAL ACTUALIZADA -->
        <div class="bc-featured-grid" style="margin-top: 3rem;">
            {page.data.map((post: any) => {
                const tagKey = `tag.${post.frontmatter.tag?.toLowerCase()}`;
                const translatedTag = t[tagKey as keyof typeof t] || post.frontmatter.tag;
                const imgSrc = post.frontmatter.main_image || 'https://images.unsplash.com/photo-1528181304800-259b08848526?q=80&w=1000&auto=format&fit=crop';
                
                const dateObj = new Date(post.frontmatter.date);
                const formattedDate = !isNaN(dateObj.getTime()) ? dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';

                return (
                    <a href={post.url} class="bc-featured-card">
                        <div class="bc-featured-img-wrap">
                            <img src={imgSrc} alt={post.frontmatter.title} class="bc-featured-img" />
                        </div>
                        <div class="bc-featured-content">
                            <div class="bc-featured-meta">
                                <div class="bc-featured-tags">
                                    {post.frontmatter.tag && (
                                        <span class="bc-tag">{translatedTag}</span>
                                    )}
                                    {post.frontmatter.pais && (
                                        <span class="bc-tag">{post.frontmatter.pais}</span>
                                    )}
                                </div>
                                <span class="bc-date">{formattedDate}</span>
                            </div>
                            
                            <h3 class="bc-featured-title">{post.frontmatter.title}</h3>
                            <p class="bc-featured-excerpt">{post.frontmatter.description || "New entry in our travel journal..."}</p>
                            <span class="bc-read-more">READ MORE &rarr;</span>
                        </div>
                    </a>
                );
            })}
        </div>

        <!-- PAGINACIÓN TRADUCIDA -->
        <div class="paginacion-container">
          {page.url.prev ? (
            <a href={page.url.prev} class="bc-btn-outline">&larr; Newer</a>
          ) : (
            <span class="bc-btn-outline disabled">&larr; Newer</span>
          )}

          <span class="paginacion-info">
            Page {page.currentPage} of {page.lastPage}
          </span>

          {page.url.next ? (
            <a href={page.url.next} class="bc-btn-outline">Older &rarr;</a>
          ) : (
            <span class="bc-btn-outline disabled">Older &rarr;</span>
          )}
        </div>

    </div>
  </main>
</Layout>

<style is:global>
    /* ============================================================
       ESTRUCTURA GENERAL
       ============================================================ */
    .bc-main-wrapper { display: block !important; width: 100% !important; margin: 0 !important; padding: 0 0 6rem 0 !important; box-sizing: border-box !important; }
    .bc-section-inner { max-width: 1200px !important; margin: 0 auto !important; width: 100% !important; }

    /* ============================================================
       GRID: ARTÍCULOS DESTACADOS (Estilo Editorial)
       ============================================================ */
    .bc-featured-grid { display: grid !important; grid-template-columns: repeat(3, 1fr) !important; gap: 2.5rem !important; width: 100% !important; }
    
    .bc-featured-card { 
