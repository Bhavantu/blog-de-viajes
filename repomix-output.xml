    /* Estilo forzado para el botón outline dentro del Hero oscuro (Efecto Glassmorphism) */
    .hero-outline-btn {
        color: #ffffff !important;
        border-color: rgba(255, 255, 255, 0.5) !important;
        background-color: rgba(0, 0, 0, 0.2) !important; /* Fondo negro muy sutil */
