    .car-slide.is-active .car-content-inner { transform: translateY(0) !important; opacity: 1 !important; transition-delay: 0.2s !important; }

    .car-counter { display: flex !important; align-items: center !important; gap: 1rem !important; margin-bottom: 2rem !important; }
    .car-num-line { width: 40px !important; height: 1px !important; background-color: var(--c-text-muted) !important; }
