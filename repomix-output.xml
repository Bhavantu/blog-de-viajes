    }

    @media (max-width: 768px) {
        .bc-finale-title { font-size: 2.2rem !important; }
        .bc-finale-links { flex-direction: column !important; gap: 2rem !important; }
        .bc-fl-divider { width: 50px !important; height: 1px !important; }
    }

</style>

<!-- ============================================================
     SCRIPTS (Vainilla JS)
     ============================================================ -->
<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        /* --- 1. LÓGICA DEL CARRUSEL DE DESTINOS --- */
        class EditorialCarousel extends HTMLElement {
            connectedCallback() {
                this.currentIndex = 0;
                this.slides = this.querySelectorAll('.car-slide');
                this.progressFills = this.querySelectorAll('.car-progress-fill');
                this.progressBtns = this.querySelectorAll('.car-progress-item');
                this.totalSlides = this.slides.length;
                this.isTransitioning = false;
                this.slideDuration = 15000; 
                
                this.nextBtn = this.querySelector('.car-next');
                this.prevBtn = this.querySelector('.car-prev');
                
                this.nextBtn?.addEventListener('click', () => this.goToSlide(this.currentIndex + 1));
                this.prevBtn?.addEventListener('click', () => this.goToSlide(this.currentIndex - 1));
                
                this.progressBtns.forEach((btn) => {
                    btn.addEventListener('click', (e) => {
                        const idx = parseInt(e.currentTarget.getAttribute('data-index'));
                        this.goToSlide(idx);
                    });
                });

                this.startAutoplay();
                this.addEventListener('mouseenter', () => this.stopAutoplay());
                this.addEventListener('mouseleave', () => this.startAutoplay());
                
                let touchStartX = 0;
                this.addEventListener('touchstart', e => touchStartX = e.changedTouches[0].screenX, {passive: true});
                this.addEventListener('touchend', e => {
                    let touchEndX = e.changedTouches[0].screenX;
                    if (touchStartX - touchEndX > 50) this.goToSlide(this.currentIndex + 1);
                    if (touchStartX - touchEndX < -50) this.goToSlide(this.currentIndex - 1);
                }, {passive: true});

                this.updateDOM();
            }

            startAutoplay() {
                this.stopAutoplay();
                this.autoplayInterval = setInterval(() => {
                    this.goToSlide(this.currentIndex + 1);
                }, this.slideDuration);
                this.updateDOM();
            }

            stopAutoplay() {
                if(this.autoplayInterval) clearInterval(this.autoplayInterval);
            }

            goToSlide(index) {
                if(this.isTransitioning) return;
                this.isTransitioning = true;
                
                if (index >= this.totalSlides) index = 0;
                if (index < 0) index = this.totalSlides - 1;

                this.currentIndex = index;
                this.updateDOM();
                this.startAutoplay(); 
                
                const progressBar = this.querySelector('.car-progress-bar');
                const activeBtn = this.progressBtns[this.currentIndex];
                if(progressBar && activeBtn) {
                    const scrollPos = activeBtn.offsetLeft - (progressBar.clientWidth / 2) + (activeBtn.clientWidth / 2);
                    progressBar.scrollTo({ left: scrollPos, behavior: 'smooth' });
                }
                
                setTimeout(() => { this.isTransitioning = false; }, 800);
            }

            updateDOM() {
                this.slides.forEach((slide, idx) => {
                    if (idx === this.currentIndex) slide.classList.add('is-active');
                    else slide.classList.remove('is-active');
                });

                this.progressBtns.forEach((btn, idx) => {
                    const fill = this.progressFills[idx];
                    
                    if (idx === this.currentIndex) {
                        btn.classList.add('is-active');
                        fill.style.setProperty('transition', 'none', 'important');
                        fill.style.setProperty('width', '0%', 'important');
                        
                        setTimeout(() => {
                            fill.style.setProperty('transition', `width ${this.slideDuration}ms linear`, 'important');
                            fill.style.setProperty('width', '100%', 'important');
                        }, 50);
                    } else if (idx < this.currentIndex) {
                        btn.classList.remove('is-active');
                        fill.style.setProperty('transition', 'none', 'important');
                        fill.style.setProperty('width', '100%', 'important');
                    } else {
                        btn.classList.remove('is-active');
                        fill.style.setProperty('transition', 'none', 'important');
                        fill.style.setProperty('width', '0%', 'important');
                    }
                });
            }
        }
        customElements.define('editorial-carousel', EditorialCarousel);

        /* --- 2. LÓGICA DEL HOVER MENU DE CATEGORÍAS --- */
        const hoverItems = document.querySelectorAll('.bc-hover-item');
        const hoverImages = document.querySelectorAll('.bc-hm-img');

        if (hoverItems.length > 0 && hoverImages.length > 0) {
            hoverItems.forEach(item => {
                item.addEventListener('mouseenter', function() {
                    const index = this.getAttribute('data-index');
                    
                    hoverImages.forEach(img => {
                        if (img.getAttribute('data-index') === index) {
                            img.classList.add('active');
                        } else {
                            img.classList.remove('active');
                        }
                    });
                });
            });
        }
    });
</script>
