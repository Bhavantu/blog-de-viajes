    .car-title { font-family: var(--font-display, 'Georgia', serif) !important; font-size: clamp(2.5rem, 4vw, 3.5rem) !important; font-weight: normal !important; color: var(--c-text-main) !important; margin: 0 0 0.5rem 0 !important; line-height: 1.1 !important; }
    .car-subtitle { 
    font-family: var(--font-main, sans-serif) !important; 
    font-size: 1rem !important; 
    text-transform: uppercase !important; 
    letter-spacing: 0.15em !important; 
    font-weight: 700 !important; 
    margin: 0 0 1.5rem 0 !important; 
    color: var(--c-accent, var(--c-brand)) !important;  /* NUEVO */
    }
    .car-desc { font-family: var(--font-main, sans-serif) !important; font-size: 1.1rem !important; line-height: 1.6 !important; color: var(--c-text-muted) !important; margin: 0 0 2.5rem 0 !important; max-width: 90% !important; }

    .car-image-container { position: relative !important; width: 100% !important; height: 500px !important; display: flex !important; align-items: center !important; justify-content: center !important; }
    .car-image-frame { position: relative !important; width: 100% !important; height: 100% !important; border-radius: 16px !important; overflow: hidden !important; transform: scale(0.95); transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1) !important; }
    .car-slide.is-active .car-image-frame { transform: scale(1); }
    .car-image { width: 100% !important; height: 100% !important; object-fit: cover !important; display: block !important; }
    .car-image-overlay { position: absolute !important; inset: 0 !important; mix-blend-mode: multiply !important; }
    
    .car-frame-corner { position: absolute !important; width: 40px !important; height: 40px !important; border: 2px solid transparent !important; z-index: 10 !important; transition: all 0.8s ease !important; opacity: 0; }
    .car-slide.is-active .car-frame-corner { opacity: 1; transition-delay: 0.5s !important; }
    .car-frame-corner-tl { top: -1rem !important; left: -1rem !important; border-right: none !important; border-bottom: none !important; border-top-left-radius: 16px !important; }
    .car-frame-corner-br { bottom: -1rem !important; right: -1rem !important; border-left: none !important; border-top: none !important; border-bottom-right-radius: 16px !important; }

    .car-controls { 
        position: absolute !important; bottom: 0 !important; left: 0 !important; 
        width: calc(50% - 2rem) !important; 
        display: flex !important; flex-direction: column !important; gap: 1.5rem !important; 
        z-index: 10 !important; pointer-events: none !important; 
    }
    .car-nav-arrows { display: flex !important; gap: 1rem !important; pointer-events: auto !important; }
    .car-arrow-btn { background: transparent !important; border: 1px solid var(--c-border) !important; border-radius: 50% !important; width: 48px !important; height: 48px !important; display: flex !important; align-items: center !important; justify-content: center !important; color: var(--c-text-main) !important; cursor: pointer !important; transition: all 0.3s ease !important; }
    .car-arrow-btn:hover { background: var(--c-text-main) !important; color: var(--c-bg-warm) !important; transform: scale(1.05) !important; }

    .car-progress-bar { 
        display: flex !important; gap: 1rem !important; width: 100% !important; pointer-events: auto !important; 
        overflow-x: auto !important; padding: 0 0 8px 0 !important; margin: 0 !important; scrollbar-width: none !important; 
    }
    .car-progress-bar::-webkit-scrollbar { display: none !important; }
    
    .car-progress-item { 
        flex: 1 0 120px !important; max-width: 200px !important; 
        background: transparent !important; border: none !important; padding: 0 !important; margin: 0 !important; cursor: pointer !important; 
        display: flex !important; flex-direction: column !important; gap: 0.5rem !important; text-align: left !important; opacity: 0.5 !important; transition: opacity 0.3s ease !important; 
    }
    .car-progress-item:hover { opacity: 0.8 !important; }
    .car-progress-item.is-active { opacity: 1 !important; }
    
    .car-progress-track { width: 100% !important; height: 2px !important; background: var(--c-border) !important; border-radius: 2px !important; overflow: hidden !important; margin: 0 !important; padding: 0 !important; }
    .car-progress-fill { height: 100% !important; width: 0%; } 
    .car-progress-label { font-family: var(--font-main, sans-serif) !important; font-size: 0.75rem !important; text-transform: uppercase !important; letter-spacing: 0.1em !important; font-weight: 700 !important; color: var(--c-text-main) !important; margin: 0 !important; padding: 0 !important;}

    @media (max-width: 950px) {
        .car-wrapper { min-height: auto !important; height: auto !important; }
        .car-inner { min-height: auto !important; height: auto !important; display: flex !important; }

        .car-slide { 
            display: flex !important;
            flex-direction: column !important;
            gap: 1rem !important;
            position: absolute !important;
            inset: 0 !important;
            opacity: 0;
            transition: opacity 0.8s ease !important;
        }
        .car-slide.is-active { 
            opacity: 1 !important; 
            z-index: 5 !important; 
            position: relative !important; 
        }

        /* 1. IMAGEN ARRIBA (Altura fija) */
        .car-image-container { 
            order: 1 !important;
            width: 100% !important;
            height: 350px !important;
            position: relative !important;
        }
        .car-image-frame { border-radius: 16px !important; transform: none !important; }
        .car-slide.is-active .car-image-frame { transform: none !important; }
        .car-frame-corner { display: block !important; }
        .car-image-overlay { 
            background:
                radial-gradient(ellipse 220px 130px at top right, rgba(0,0,0,0.35) 0%, transparent 70%),
                radial-gradient(ellipse 320px 200px at bottom left, rgba(0,0,0,0.45) 0%, transparent 75%) !important;
            opacity: 1 !important; 
            mix-blend-mode: normal !important;
        }

        /* 2. NEUTRALIZAR CONTENEDORES PARA LIBERAR LA POSICIÓN ABSOLUTA */
        .car-content { 
            order: 2 !important;
            width: 100% !important;
            padding: 0 !important; /* Mata el padding-bottom de 5rem del escritorio */
            margin: 0 !important;
            position: static !important;
            display: block !important;
            height: auto !important;
        }
        .car-content-inner {
            position: static !important;
            transform: none !important; /* Mata el translateY(20px) base */
            display: block !important;
            height: auto !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .car-slide.is-active .car-content-inner {
            transform: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .car-counter { 
            position: absolute !important;
            top: 1.5rem !important;
            right: 1.5rem !important;
            left: auto !important;
            width: auto !important; 
            justify-content: flex-end !important;
            z-index: 10 !important;
            margin: 0 !important;
            background: rgba(0, 0, 0, 0.063) !important;
            padding: 0.2rem 0.5rem !important;
            border-radius: 6px !important;
        }
        .car-num-line { background-color: rgba(255,255,255,0.7) !important; }
        .car-num-text { color: #ffffff !important; text-shadow: 0 1px 3px rgba(0,0,0,0.5) !important; }

        .car-title { 
            position: absolute !important;
            top: 250px !important;
            left: 1.5rem !important;
            width: auto !important;
            text-align: left !important;
            font-size: clamp(2.2rem, 8vw, 2.5rem) !important; 
            color: #ffffff !important; 
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7) !important;  /* antes: 0.063 (casi invisible) */
            z-index: 10 !important;
            margin: 0 !important;
            line-height: 1 !important;
        }
        
        .car-subtitle { 
            position: absolute !important;
            top: 300px !important;
            left: 1.5rem !important;
            width: auto !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 0.6rem !important;
            text-align: left !important;
            font-size: 0.85rem !important;
            font-weight: 700 !important;
            letter-spacing: 0.15em !important;
            line-height: 1 !important;  /* NUEVO — elimina el espacio extra que desalinea la barra */
            color: #ffffff !important;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7) !important;
            z-index: 10 !important;
            margin: 0 !important;
        }

        .car-subtitle::before {
            content: "" !important;
            display: inline-block !important;
            width: 3px !important;
            height: 14px !important;
            background-color: var(--c-accent, #ffffff) !important;
            flex-shrink: 0 !important;
            position: relative !important;
            top: -1px !important;
        }

        /* 4. PÁRRAFO Y BOTÓN (Pegados a la foto) */
        .car-desc { 
            margin: 1rem 0 1.5rem 0 !important; /* 1rem es la única separación real con la foto */
            text-align: left !important; 
            font-size: 1.05rem !important; 
            color: var(--c-text-muted) !important; 
            padding: 0 0.5rem !important;
            display: block !important;
        }

        .car-action {
            display: flex !important;
            justify-content: flex-start !important; 
            margin-top: 0 !important; /* Quitamos márgenes superiores innecesarios */
            margin-bottom: 2rem !important;
            padding: 0 0.5rem !important;
        }

        /* 5. CONTROLES DE CARRUSEL */
        .car-controls { 
            position: relative !important;
            width: 100% !important; 
        }
        .car-nav-arrows { display: none !important; }
    }

    /* ============================================================
       GRID: ARTÍCULOS DESTACADOS
       ============================================================ */
    .bc-featured-grid { display: grid !important; grid-template-columns: repeat(3, 1fr) !important; gap: 2.5rem !important; width: 100% !important; }
    
    .bc-featured-card { 
        background: #ffffff !important; border-radius: 16px !important; overflow: hidden !important; 
        display: flex !important; flex-direction: column !important; text-decoration: none !important; 
        color: inherit !important; transition: transform 0.3s ease, box-shadow 0.3s ease !important; 
        border: 1px solid var(--c-border) !important;
    }
    .bc-featured-card:hover { transform: translateY(-5px) !important; box-shadow: 0 12px 24px rgba(0,0,0,0.05) !important; }
    
    .bc-featured-img-wrap { width: 100% !important; aspect-ratio: 16/10 !important; overflow: hidden !important; margin-bottom: 0 !important; border-radius: 0 !important; }
    .bc-featured-img { width: 100% !important; height: 100% !important; object-fit: cover !important; transition: transform 0.5s ease !important; }
    .bc-featured-card:hover .bc-featured-img { transform: scale(1.05) !important; }
    
    .bc-featured-content { padding: 2rem !important; display: flex !important; flex-direction: column !important; flex-grow: 1 !important; }
    
    .bc-featured-meta { display: flex !important; flex-direction: column !important; align-items: flex-start !important; gap: 0.5rem !important; margin-bottom: 1rem !important; }
    .bc-featured-tags { display: flex !important; flex-wrap: wrap !important; gap: 0.5rem !important; }
    
    .bc-tag { 
        font-family: var(--font-main, sans-serif) !important;
        border: 1px solid var(--c-brand) !important; color: var(--c-brand) !important; 
        padding: 0.2rem 0.6rem !important; border-radius: 50px !important; 
        font-size: 0.7rem !important; text-transform: uppercase !important; 
        letter-spacing: 0.05em !important; font-weight: 700 !important; 
        margin: 0 !important;
    }
    
    .bc-date { font-family: var(--font-main, sans-serif) !important; font-size: 0.75rem !important; color: var(--c-text-muted) !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; margin: 0 !important; }
    
    .bc-featured-title { font-family: var(--font-display, 'Georgia', serif) !important; font-size: 1.5rem !important; line-height: 1.3 !important; color: var(--c-text-main) !important; margin: 0 0 1rem 0 !important; font-weight: normal !important; }
    
    .bc-featured-excerpt { 
