// DICCIONARIOS DE TRADUCCIÓN DE SLUGS
// ==========================================
const categoryMapEsToEn: Record<string, string> = {
    'punto-de-fuga': 'vanishing-point',
    'guia-de-viaje': 'travel-guide',
    'guía-de-viaje': 'travel-guide',
    'vida-local': 'local-life',
    'contexto-y-cultura': 'culture-and-context'
};
const categoryMapEnToEs: Record<string, string> = {
    'vanishing-point': 'punto-de-fuga',
    'travel-guide': 'guia-de-viaje',
    'local-life': 'vida-local',
    'culture-and-context': 'contexto-y-cultura'
};

const destMapEsToEn: Record<string, string> = {
    'nueva-zelanda': 'new-zealand',
    'japon': 'japan',
    'tailandia': 'thailand',
    'filipinas': 'philippines',
    // indonesia, vietnam, china son iguales en ambos idiomas
};
const destMapEnToEs: Record<string, string> = {
    'new-zealand': 'nueva-zelanda',
    'japan': 'japon',
    'thailand': 'tailandia',
    'philippines': 'filipinas'
};

// ==========================================
// LÓGICA DE ENRUTAMIENTO
// ==========================================
if (cleanPath === '/nosotros' || cleanPath === '/about') {
    urlEs = ui['es']['route.nosotros'];
    urlEn = ui['en']['route.nosotros'];
} else if (cleanPath === '/diario' || cleanPath === '/journal') {
    urlEs = ui['es']['route.diario'];
    urlEn = ui['en']['route.diario'];
} else if (cleanPath === '/contacto' || cleanPath === '/contact') {
    urlEs = ui['es']['route.contacto'];
    urlEn = ui['en']['route.contacto'];
} else if (cleanPath === '/colab') {
    urlEs = ui['es']['route.colab'];
    urlEn = ui['en']['route.colab'];
} else if (cleanPath === '/politica-de-privacidad' || cleanPath === '/privacy-policy') {
    urlEs = ui['es']['route.privacidad'];
    urlEn = ui['en']['route.privacidad'];
} 
// --- RUTAS DE CATEGORÍAS ---
else if (cleanPath.startsWith('/categorias/')) {
    const slug = cleanPath.replace('/categorias/', '').replace(/\/$/, '');
    urlEs = cleanPath;
    const enSlug = categoryMapEsToEn[slug] || slug;
    urlEn = `/en/categories/${enSlug}`;
} else if (cleanPath.startsWith('/categories/')) {
    const slug = cleanPath.replace('/categories/', '').replace(/\/$/, '');
    const esSlug = categoryMapEnToEs[slug] || slug;
    urlEs = `/categorias/${esSlug}`;
    urlEn = rawPath; 
} 
// --- RUTAS DE DESTINOS ---
else if (cleanPath.startsWith('/destinos/')) {
    const slug = cleanPath.replace('/destinos/', '').replace(/\/$/, '');
    urlEs = cleanPath;
    const enSlug = destMapEsToEn[slug] || slug;
    urlEn = `/en/destinations/${enSlug}`;
} else if (cleanPath.startsWith('/destinations/')) {
    const slug = cleanPath.replace('/destinations/', '').replace(/\/$/, '');
    const esSlug = destMapEnToEs[slug] || slug;
    urlEs = `/destinos/${esSlug}`;
    urlEn = rawPath;
} 
// --- RUTAS DE POSTS DEL DIARIO ---
else if (cleanPath.startsWith('/diario/')) {
    const suffix = cleanPath.replace('/diario/', '').replace(/\/$/, '');
    urlEs = `/diario/${suffix}`;
    const enPost = englishPosts.find((p) => p.frontmatter?.archivo_original === `${suffix}.md`);
    urlEn = enPost?.url || '/en/journal';
} else if (cleanPath.startsWith('/journal/')) {
    if (frontmatter && frontmatter.archivo_original) {
        const esSlug = frontmatter.archivo_original.replace('.md', '');
        urlEs = `/diario/${esSlug}`;
    } else {
        urlEs = '/diario';
    }
    urlEn = rawPath;
}

