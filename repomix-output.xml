  fetchpriority = "high"
} = Astro.props;
---

<section class="hero-cinematic">
  <div class="hero-bg">
    <img 
      src={bgImage} 
      alt={title.replace(/<[^>]*>?/gm, '')} 
      loading={loading} 
      fetchpriority={fetchpriority} 
    />
    <!-- Scrim actualizado: Gradiente radial y lineal sutil como en el inicio -->
    <div class="hero-scrim"></div>
  </div>
  
  <div class="hero-content">
    {subtitle && <span class="hero-subtitle">{subtitle}</span>}
    <h1 class="hero-title" set:html={title}></h1>
    {description && <p class="hero-description">{description}</p>}
  </div>
</section>

<style>
  .hero-cinematic {
    position: relative;
    width: 100%;
    /* Altura igualada a la página de inicio */
    height: 100svh; 
    min-height: 500px;
    display: flex;
    align-items: center; 
    justify-content: center; 
    text-align: center;
    padding: 8rem 2rem 4rem;
    overflow: hidden;
    margin-bottom: 4rem;
    margin-top: -120px; 
    z-index: 0;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: #111;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    animation: slowZoom 25s ease-out forwards; /* Ajustado a 25s como en el inicio */
    will-change: transform;
  }

  /* Scrim actualizado para mayor elegancia, sin oscurecer tanto la foto */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.2) 80%);
    backdrop-filter: blur(0.5px);
    -webkit-backdrop-filter: blur(0.5px);
  }

  .hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-subtitle {
    font-family: var(--font-main, sans-serif);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    color: rgba(255,255,255,0.9);
    font-weight: 600;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-title {
    font-family: var(--font-display, 'Georgia', serif);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin-bottom: 1.2rem;
    font-style: italic;
    text-wrap: balance;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }

  .hero-description {
    font-family: var(--font-main, sans-serif);
    font-size: 1.15rem;
    line-height: 1.6;
    max-width: 600px;
    color: #ffffff;
    font-weight: 500;
    font-style: italic;
    letter-spacing: 0.02em;
    background: transparent;
    padding: 0;
    border-radius: 0;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }

  @keyframes slowZoom {
    from { transform: scale(1); }
    to { transform: scale(1.1); }
  }

  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ============================================================
     RESPONSIVE PARA CELULARES
     ============================================================ */
  @media (max-width: 768px) {
    .hero-cinematic {
      align-items: center; 
      padding: 0 1.5rem;
    }
    
    .hero-content {
      margin-top: 3rem; 
    }

    .hero-subtitle {
      font-size: 1rem; 
      margin-bottom: 1rem;
    }

    .hero-title {
      font-size: clamp(2.5rem, 5vw, 4rem);
      margin-bottom: 1.2rem;
    }

    .hero-description {
      font-size: 1.05rem; 
      padding: 0;
    }

    .hero-scrim {
      background: linear-gradient(to bottom, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.7) 100%);
    }
  }
</style>
</file>

<file path="src/layouts/Layout.astro">
---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { ui } from '../i18n/ui.js';

interface Props {
    title: string;
    description?: string;
    isTransparentHeader?: boolean;
    frontmatter?: any;
}

const posts = import.meta.glob('../pages/diario/*.md', { eager: true });
const searchData = Object.values(posts).map((post: any) => ({
    title: post.frontmatter.title || '',
    description: post.frontmatter.description || '',
    content: typeof post.rawContent === 'function' ? post.rawContent().toLowerCase() : '',
    url: post.url
}));

const { title, description, isTransparentHeader = false, frontmatter } = Astro.props;

const paisToUse = frontmatter?.pais;
const metaDescription = description || "BLOGCITO - Bitácora de viaje, información útil y vida local alrededor del mundo.";
const isGaleria = Astro.url.pathname.includes('/galeria');
const currentLang = Astro.currentLocale || 'es';
const t = ui[currentLang as keyof typeof ui] || ui['es'];

// Lógica de Canonical limpia
const siteUrl = Astro.site || 'https://blogcito.com';
let canonicalPath = Astro.url.pathname.replace(/\/$/, '');
if (canonicalPath === '') canonicalPath = '/';
const canonicalURL = new URL(canonicalPath, siteUrl);

// --- LÓGICA DE TRADUCCIÓN HREFLANG PARA POSTS ---
const englishPosts = Object.values(import.meta.glob('../pages/en/journal/*.md', { eager: true })) as any[];let altUrlEs = '';
let altUrlEn = '';

if (frontmatter) {
    if (currentLang === 'es') {
        const slug = Astro.url.pathname.replace(/^\/diario\//, '').replace(/\/$/, '');
        altUrlEs = `${siteUrl}/diario/${slug}`;
        
        const matchEn = englishPosts.find((p: any) => p.frontmatter?.archivo_original === `${slug}.md`);
        if (matchEn) altUrlEn = `${siteUrl}${matchEn.url}`;
    } else if (currentLang === 'en') {
        const matchOriginal = frontmatter.archivo_original?.replace('.md', '');
        if (matchOriginal) altUrlEs = `${siteUrl}/diario/${matchOriginal}`;
        
        altUrlEn = `${siteUrl}${Astro.url.pathname.replace(/\/$/, '')}`;
    }
}
---
<!doctype html>
<html lang={currentLang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="canonical" href={canonicalURL} />
        
        <!-- ETIQUETAS DE IDIOMA PARA GOOGLE -->
        {altUrlEs && <link rel="alternate" hreflang="es" href={altUrlEs} />}
        {altUrlEn && <link rel="alternate" hreflang="en" href={altUrlEn} />}
        {altUrlEs && <link rel="alternate" hreflang="x-default" href={altUrlEs} />}

        <!-- Google Analytics -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-37WGK8P699"></script>
        <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-37WGK8P699');
        </script>
        
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        
        <meta name="description" content={metaDescription} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:type" content="website" />
        <meta name="google-adsense-account" content="ca-pub-3901046224634106">
       
        {isGaleria && <meta name="robots" content="noindex, nofollow" />}
        
        <!-- Google AdSense -->
        {!isGaleria && (
            <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3901046224634106" crossorigin="anonymous"></script>
        )}

        <!-- Script Stay22 -->
        <script is:inline data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
        (function () {
            var script = document.createElement("script");
            script.async = 1;
            script.setAttribute("data-cmp-ab","2");
            script.src = 'https://emrldco.com/NTQzMjQ0.js?t=543244';
            document.head.appendChild(script);
        })();
        </script>

        <!-- Netlify Identity -->
        <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

        <!-- JSON-LD Buscador -->
        <script type="application/ld+json" is:inline>
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "BLOGCITO",
            "url": "https://blogcito.com",
            "potentialAction": {
            "@type": "SearchAction",
            "target": "https://blogcito.com/?search={search_term_string}",
            "query-input": "required name=search_term_string"
            }
        }
        </script>
    </head>
    <body>
        <!-- Pasamos isTransparent y frontmatter al Header -->
        <Header isTransparent={isTransparentHeader} frontmatter={frontmatter} />

        <slot />

        <footer>
            <p>&copy; 2026 BLOGCITO. {t['footer.derechos']}</p>
            <p style="max-width: 650px; margin: 1.2rem auto; font-size: 0.8rem; line-height: 1.5; color: #555555; text-align: center;">
            {t['footer.afiliados']}
            </p>
            <div style="margin-top: 10px; font-size: 0.9em;">
                <a href={t['route.privacidad']} style="margin-right: 15px;">{t['footer.privacidad']}</a>
                <a href={t['route.contacto']}>{t['footer.contacto']}</a>
            </div>
        </footer>

        <!-- Banner Cookies -->
        <div id="cookie-banner" class="cookie-banner">
            <p>{t['cookies.text']}</p>
            <button id="accept-cookies" class="cookie-btn">{t['cookies.btn']}</button>
        </div>

        <style is:global>
            :root {
                --bg-color: #f4f1ea;
                --text-color: #333;
                --accent-color: #888;
                --font-main: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                --font-display: 'Georgia', serif;
            }

            html {
                scroll-behavior: smooth;
            }

            * { margin: 0; padding: 0; box-sizing: border-box; }
            html, body { overflow-x: hidden; width: 100%; position: relative; }
            body { font-family: var(--font-main); background-color: var(--bg-color); color: var(--text-color); line-height: 1.6; display: flex; flex-direction: column; min-height: 100vh; }
            
            a { text-decoration: none; color: inherit; transition: opacity 0.3s; }
            a:hover { opacity: 0.7; }
            .hover-verde { transition: color 0.3s ease; }
            .hover-verde:hover { color: #006d77 !important; }

            .container { max-width: 1000px; margin: 0 auto; padding: 2rem 2rem 6rem 2rem; width: 100%; flex-grow: 1; }
            
            /* --- CORRECCIONES RESPONSIVE MÓVIL --- */
            @media (max-width: 768px) { 
                .container { padding: 1.5rem 1rem 4rem 1rem; }
                
                /* Soluciona el interlineado desproporcionado de los títulos en móvil */
                h1, h2, h3, .article-title-main, .journal-title, .titulo-portada { 
                    line-height: 1.25 !important; 
                }
                
                /* Da aire a los costados de los textos para que no toquen el borde */
                .text-column, .about-text, .hero-content { 
                    padding-left: 1rem; 
                    padding-right: 1rem; 
                }
            }

            /* --- KO-FI Z-INDEX FIX Y POSICIÓN --- */
            iframe[id^="kofi-"] {
                z-index: 999999 !important; /* Por encima de Stay22 y Cookies */
                bottom: 85px !important; /* Sube el botón para que no tape Airalo */
            }

            /* Estilos generales */
            .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 4rem 2rem; }
            .image-wrapper { width: 100%; height: 400px; overflow: hidden; background-color: #eee; }
            .image-wrapper img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.8s ease; }
            .photo-info { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--accent-color); margin-top: 0.7rem; }
            .photo-title { color: var(--text-color); font-weight: 500; }

            .journal-entry { max-width: 700px; margin: 0 auto 5rem auto; border-bottom: 1px solid #eee; padding-bottom: 3rem; }
            .journal-date { font-size: 0.75rem; color: var(--accent-color); letter-spacing: 0.1em; display: block; margin-bottom: 0.5rem; }
            .journal-title { font-family: var(--font-display); font-size: 1.8rem; margin-bottom: 1rem; font-weight: normal; }
            .journal-body { font-size: 1.05rem; color: #555; margin-bottom: 1.5rem; }
            
            .journal-tag { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.15em; padding: 4px 12px; border-radius: 15px; display: inline-block; margin-bottom: 0.8rem; font-weight: 500; }
            .journal-tag[data-tag="bitacora"] { background-color: #fdf2e9; color: #af601a; border: 1px solid #fad7a0; }
            .journal-tag[data-tag="fotografia"] { background-color: #ebf5fb; color: #2874a6; border: 1px solid #aed6f1; }
            .journal-tag[data-tag="punto de fuga"] { background-color: #f5eef8; color: #6c3483; border: 1px solid #d7bde2; }
            .journal-tag[data-tag="vida local"] { background-color: #f4f1ea; color: #31824b; border: 1px solid #6fdf96; }
            .journal-tag[data-tag="data"] { background-color: #eaecee; color: #cbd661; border: 1px solid #ebf699; }
            .journal-tag[data-tag="guia de viaje"], .journal-tag[data-tag="guía de viaje"] { background-color: #e6fffa; color: #006d77; border: 1px solid #83c5be; }
            .journal-tag[data-tag="contexto y cultura"] { background-color: #fff5f5; color: #9b2c2c; border: 1px solid #feb2b2; }

            .about-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
            @media (max-width: 768px) { .about-layout { grid-template-columns: 1fr; gap: 2rem; } }
            .about-img { width: 100%; height: auto; max-height: 650px; object-fit: cover; display: block; border-radius: 8px; }
            .about-text h2 { font-family: var(--font-display); font-size: 2rem; margin-bottom: 1.5rem; font-weight: normal; }

            .article-header { text-align: center; margin-bottom: 3rem; }
            .article-title-main { font-family: var(--font-display); font-size: 2.5rem; line-height: 1.2; font-weight: normal; margin-top: 1rem; }
            .back-btn { display: inline-block; margin-bottom: 2rem; font-size: 0.8rem; text-transform: uppercase; color: var(--accent-color); border-bottom: 1px solid transparent; cursor: pointer; padding: 10px 0; }
            .back-btn:hover { border-bottom-color: var(--accent-color); }
            
            .text-column { max-width: 680px; margin: 0 auto; font-size: 1.1rem; color: #444; line-height: 1.8; }
            .text-column p { margin-bottom: 1.5rem; }
            
            .post-banner { width: 100%; max-width: 100%; margin: 0 auto 2rem auto; padding: 0; }
            .post-banner img { width: 100% !important; height: auto !important; display: block; border-radius: 8px; margin: 0 auto; }
            
            .text-column blockquote { border-left: 4px solid #ddd; padding: 1.5rem 0 1.5rem 2rem; margin: 3.5rem 0; font-family: var(--font-display); font-size: 1.45rem; color: #222; font-style: italic; background-color: #f9f9f9; line-height: 1.5; }
            .text-column img { display: block; max-width: 100% !important; height: auto !important; margin: 2.5rem auto 0.5rem auto; object-fit: contain; }

            .img-caption { display: block; font-size: 0.78rem; color: var(--accent-color); text-align: center; margin-top: 0; margin-bottom: 2.5rem; line-height: 1.4; font-style: italic; }
            
            .reveal { opacity: 0; transform: translateY(20px); transition: all 0.8s ease-out; }
            .reveal.visible { opacity: 1; transform: translateY(0); }

            /* ============================================================
            FOOTER EDITORIAL SUAVE
            ============================================================ */
            footer { 
                background-color: #e6e2d6 !important; /* Un beige un par de tonos más oscuro que el fondo principal */
                width: 100%; 
                text-align: center; 
                padding: 4rem 2rem; 
                margin-top: auto; 
                clear: both; 
                border-top: 1px solid #d5d0c3 !important; /* Una línea divisoria muy sutil */
            }

            footer p,
            footer div {
                color: #555555 !important; /* Gris medio/oscuro para lectura cómoda */
                font-size: 0.85rem;
            }

            footer a {
                color: #006d77 !important; /* Tu color verde identitario */
                font-weight: 600;
                text-decoration: none !important;
                padding: 0 !important;
                background: none !important; /* Sin el subrayado marcador */
                transition: color 0.3s ease;
            }

            footer a:hover {
                color: #333333 !important;
                text-decoration: underline !important;
            }

        </style>

        <style>
          /* BANNER DE COOKIES OPTIMIZADO */
          .cookie-banner {
            position: fixed; 
            bottom: 20px; 
            left: 50%; 
            transform: translateX(-50%) translateY(150%);
            width: 90%; 
            max-width: 700px; 
            background-color: rgba(26, 26, 26, 0.95);
            backdrop-filter: blur(8px);
            color: #f1f1f1; 
            padding: 15px 25px; 
            display: flex; 
            justify-content: space-between;
            align-items: center; 
            z-index: 99990; 
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
          }
          .cookie-banner.show { transform: translateX(-50%) translateY(0); }
          .cookie-banner p { margin: 0; font-size: 0.9rem; line-height: 1.4; flex: 1; padding-right: 20px; }
          .cookie-btn { background-color: #ffffff; color: #1a1a1a; border: none; padding: 10px 24px; cursor: pointer; font-weight: 600; font-size: 0.9rem; border-radius: 6px; white-space: nowrap; transition: background-color 0.2s ease; }
          .cookie-btn:hover { background-color: #e0e0e0; }

           @media (max-width: 768px) {
            .cookie-banner { flex-direction: column; text-align: center; padding: 20px; bottom: 10px; }
            .cookie-banner p { padding-right: 0; margin-bottom: 15px; }
            .cookie-btn { width: 100%; }
          }
        </style>

        <!-- SCRIPT ANIMACIONES REVEAL -->
        <script is:inline>
            function initReveal() {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) entry.target.classList.add('visible');
                    });
                }, { threshold: 0.1 });
                document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
            }
            document.addEventListener('DOMContentLoaded', initReveal);
            document.addEventListener('astro:after-swap', initReveal);
        </script>

        <!-- SCRIPT BUSCADOR -->
        <script define:vars={{ searchData, msgShort: t['search.short'], msgEmpty: t['search.empty'] }}>       
        document.addEventListener('DOMContentLoaded', () => {
            const btnsBuscar = document.querySelectorAll('.btn-buscar');
            const modal = document.getElementById('search-modal');
            const closeBtn = document.getElementById('close-search');
            const input = document.getElementById('search-input');
            const results = document.getElementById('search-results');

            btnsBuscar.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    modal?.classList.add('active');
                    input?.focus();
                });
            });

            closeBtn?.addEventListener('click', () => modal?.classList.remove('active'));
            modal?.addEventListener('click', (e) => {
                if (e.target === modal) modal.classList.remove('active');
            });

            input?.addEventListener('input', (e) => {
                const query = e.target.value.toLowerCase();
                if (query.length < 2) {
                    results.innerHTML = `<p style="color:#777; font-size:0.9rem;">${msgShort}</p>`;
                    return;
                }
                const filtered = searchData.filter(post => 
                    post.title.toLowerCase().includes(query) || 
                    post.description.toLowerCase().includes(query) ||
                    (post.content && post.content.includes(query))
                );
                if (filtered.length === 0) {
                    results.innerHTML = `<p style="color:#777;">${msgEmpty}</p>`;
                    return;
                }
                results.innerHTML = filtered.map(post => `
                    <a href="${post.url}" class="search-result-item">
                        <h4>${post.title}</h4>
                        <p>${post.description}</p>
                    </a>
                `).join('');
            });
        });
        </script>

        <!-- SCRIPT BANNER COOKIES -->
        <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const banner = document.getElementById("cookie-banner");
            const acceptBtn = document.getElementById("accept-cookies");

            if (!localStorage.getItem("cookies_accepted") && banner) {
                setTimeout(() => banner.classList.add("show"), 500);
            }

            acceptBtn?.addEventListener("click", () => {
                localStorage.setItem("cookies_accepted", "true");
                banner?.classList.remove("show");
            });
        });
        </script>

        <!-- KO-FI FLOTANTE RESTAURADO -->
        <script is:inline src='https://storage.ko-fi.com/cdn/scripts/overlay-widget.js'></script>
        <script is:inline>
          const userLang = navigator.language || navigator.userLanguage;
          let buttonText = 'Support me';
          if (userLang.startsWith('es')) {
            buttonText = 'Apoyar el blog';
          } else if (userLang.startsWith('pt')) {
            buttonText = 'Apoiar o blog';
          }

          kofiWidgetOverlay.draw('blogcito', {
            'type': 'floating-chat',
            'floating-chat.donateButton.text': buttonText,
            'floating-chat.donateButton.background-color': '#323842',
            'floating-chat.donateButton.text-color': '#fff'
          });
        </script>
    </body>
</html>
</file>

