// src/components/PostsRecomendados.astro
import { ui } from '../i18n/ui.js';
import { destinationsData } from '../data/taxonomies.js'; // Importamos los datos de destinos para armar el link

const { currentUrl, currentPais, lang = "es" } = Astro.props;

// Rutas originales
const postsEs = Object.values(import.meta.glob('../pages/diario/*.md', { eager: true }));
const postsEn = Object.values(import.meta.glob('../pages/en/journal/*.md', { eager: true }));

const allPosts = lang === "es" ? postsEs : postsEn;

// Filtro anti-duplicados
const cleanUrl = (url: string) => url?.replace(/\/$/, '') || '';
const currentUrlCleaned = cleanUrl(currentUrl);

// 1. Filtramos todos los posts válidos de este país
const todosLosRecomendados = allPosts.filter((post: any) => {
    const postUrlCleaned = cleanUrl(post.url);
    return post.frontmatter.pais === currentPais && postUrlCleaned !== currentUrlCleaned;
});

// 2. Limitamos a un MÁXIMO de 4 tarjetas (2 filas)
const recomendadosLimitados = todosLosRecomendados.slice(0, 4);

// 3. Verificamos si quedaron posts afuera para mostrar el botón
const hayMasPosts = todosLosRecomendados.length > 4;

const t = ui[lang as keyof typeof ui] || ui['es'];

// 4. Lógica para armar la URL del botón "Ver todos"
let linkDestino = "#";
if (hayMasPosts && currentPais) {
    // Buscamos el ID del destino en taxonomies basándonos en el nombre del país (español o inglés)
    const destinoMatch = destinationsData.find(d => 
        d.title === currentPais || d.title_en === currentPais
    );
    
    if (destinoMatch) {
        if (lang === 'es') {
            linkDestino = `/destinos/${destinoMatch.id}`;
        } else {
            // Usa el id_en si existe, sino el id normal
            const slugEn = destinoMatch.id_en || destinoMatch.id;
            linkDestino = `/en/destinations/${slugEn}`;
        }
    }
}
---

{recomendadosLimitados.length > 0 && (
  <section class="recomendados-section">
    <h3>{lang === "es" ? "También te puede interesar" : "You might also like"}</h3>
    
    <div class="recomendados-grid">
      {recomendadosLimitados.map((post: any) => {
        const tagKey = `tag.${post.frontmatter.tag?.toLowerCase()}`;
        const translatedTag = t[tagKey as keyof typeof t] || post.frontmatter.tag;

        return (
          <a href={post.url} class="recomendado-card">
            <div class="img-wrapper">
              <img src={post.frontmatter.main_image} alt={post.frontmatter.title} loading="lazy" />
            </div>
            <div class="card-content">
              <span class="tag">{translatedTag}</span>
              <h4>{post.frontmatter.title}</h4>
            </div>
          </a>
        );
      })}
    </div>

    <!-- BOTÓN DE "VER MÁS" CONDICIONAL -->
    {hayMasPosts && (
      <div class="ver-mas-container">
        <a href={linkDestino} class="ver-mas-btn">
            {lang === "es" ? `Más posts de ${currentPais}` : `More ${currentPais} Posts`}
        </a>
      </div>
    )}

  </section>
)}

